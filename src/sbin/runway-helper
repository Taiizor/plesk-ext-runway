def app_state_path(domain_id):
    return os.path.join(APPS_DIR, "%d.json" % domain_id)


def app_triggers_path(domain_id):
    return os.path.join(APPS_DIR, "%d.triggers.json" % domain_id)


def env_file_path(domain_id):
    return os.path.join(ENV_DIR, "%d.env" % domain_id)


def job_paths(job):
    return (
        os.path.join(JOBS_DIR, job + ".status.json"),
        os.path.join(JOBS_DIR, job + ".log"),
        os.path.join(JOBS_DIR, job + ".request.json"),
    )


def go_dir(version):
    return os.path.join(GO_ROOT_DIR, version)


def host_arch():
    machine = os.uname().machine
    if machine in ("x86_64", "amd64"):
        return "amd64", "x86_64-unknown-linux-gnu"
    if machine in ("aarch64", "arm64"):
        return "arm64", "aarch64-unknown-linux-gnu"
    raise HelperError("Unsupported CPU architecture: %s" % machine)


def rust_toolchain_dir(toolchain):
    return os.path.join(RUSTUP_HOME, "toolchains", "%s-%s" % (toolchain, host_arch()[1]))


# ---------------------------------------------------------------------------
# Running code as the hosting customer
# ---------------------------------------------------------------------------

def drop_privileges(pw):
    os.setgroups([])
    os.initgroups(pw.pw_name, pw.pw_gid)
    os.setgid(pw.pw_gid)
    os.setuid(pw.pw_uid)
    if os.getuid() != pw.pw_uid or os.geteuid() != pw.pw_uid:
        raise OSError("failed to drop privileges")


def _close_inherited_fds(keep):
    """Closes every descriptor except stdio (re-pointed to /dev/null) and `keep`, so a child
    that the customer stops (SIGSTOP) can never pin a root lock or the panel's stdout pipe."""
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    try:
        fds = [int(name) for name in os.listdir("/proc/self/fd")]
    except OSError:
        fds = list(range(3, 1024))
    for fd in fds:
        if fd > 2 and fd != keep:
            try:
                os.close(fd)
            except OSError:
                pass


def _limit_child(timeout, fsize):
    """Caps memory, file size and CPU time of a child that runs as the customer, so a crafted
    application root (millions of files, huge project files) cannot exhaust the server."""
    for limit, value in ((resource.RLIMIT_AS, CHILD_MEMORY), (resource.RLIMIT_FSIZE, fsize),
                         (resource.RLIMIT_CPU, int(timeout) + 5)):
        resource.setrlimit(limit, (value, value))


def call_as_user(pw, func, *args, **kwargs):
    """Runs func(*args) in a forked child that has become `pw`. Returns its JSON-able result.

    The child can be signalled by the customer once it runs with their uid, so the parent
    never waits for it without a deadline and kills it when the deadline passes. The child runs
    with resource limits (address space, file size, CPU time; keyword "fsize" raises the file
    size limit for downloads)."""
    timeout = kwargs.get("timeout", CHILD_TIMEOUT)
    fsize = kwargs.get("fsize", CHILD_FSIZE)
    rfd, wfd = os.pipe()
    pid = os.fork()
    if pid == 0:  # child
        code = 0
        try:
            os.close(rfd)
            _close_inherited_fds(wfd)
            drop_privileges(pw)
            _limit_child(timeout, fsize)
            os.umask(0o027)
            os.environ.clear()
            os.environ.update({"HOME": pw.pw_dir, "PATH": USER_PATH, "LANG": "C.UTF-8"})
            os.chdir(pw.pw_dir if os.path.isdir(pw.pw_dir) else "/")
            result = {"ok": True, "result": func(*args)}
        except HelperError as exc:
            result = {"ok": False, "error": str(exc), "code": getattr(exc, "code", None)}
        except BaseException as exc:  # noqa: BLE001 - report anything to the parent
            result = {"ok": False, "error": "%s: %s" % (type(exc).__name__, exc)}
            code = 1
        try:
            data = json.dumps(result).encode("utf-8")
            view = memoryview(data)
            while view:
                written = os.write(wfd, view)
                view = view[written:]
        finally:
            os._exit(code)
    os.close(wfd)
    chunks = []
    size = 0
    failed = None
    deadline = time.time() + timeout
    try:
        while True:
            remaining = deadline - time.time()
            if remaining <= 0:
                failed = "Timed out while running as %s" % pw.pw_name
                break
            ready, _, _ = select.select([rfd], [], [], min(remaining, 1.0))
            if not ready:
                continue
            chunk = os.read(rfd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > 8 * 1024 * 1024:
                failed = "Too much output while running as %s" % pw.pw_name
                break
    finally:
        os.close(rfd)
        if failed:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        os.waitpid(pid, 0)
    if failed:
        raise HelperError(failed)
    try:
        result = json.loads(b"".join(chunks).decode("utf-8"))
    except ValueError:
        raise HelperError("Internal error while running as %s" % pw.pw_name)
    if not result.get("ok"):
        code = result.get("code")
        raise HelperError(result.get("error") or "Unknown error", code=code if isinstance(code, str) else None)
    return result.get("result")


def _user_prepare_app_root(app_root):
    os.makedirs(app_root, mode=0o750, exist_ok=True)
    os.makedirs(os.path.join(app_root, "tmp"), mode=0o750, exist_ok=True)
    return True


def _read_small(path, limit=256 * 1024):
    # O_NONBLOCK + S_ISREG: a FIFO or device swapped in for go.mod must not block or be read.
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise HelperError("%s is not a regular file" % os.path.basename(path))
        data = b""
        while len(data) < limit:
            chunk = os.read(fd, limit - len(data))
            if not chunk:
                break
            data += chunk
        return data.decode("utf-8", "replace")
    finally:
        os.close(fd)


def _user_trigger_mtimes(app_dir):
    """Runs as the customer: root never resolves paths inside the customer's directories."""
    result = {}
    tmp = os.path.join(app_dir, "tmp")
    if os.path.islink(tmp):
        return {"deploy": None, "restart": None}
    for key, rel in (("deploy", TRIGGER_DEPLOY), ("restart", TRIGGER_RESTART)):
        try:
            result[key] = os.lstat(os.path.join(app_dir, rel)).st_mtime
        except OSError:
            result[key] = None
    return result


def _parse_cargo_toml(text):
    info = {"package": None, "bins": [], "bin_paths": {}, "workspace": False}
    try:
        import tomllib  # Python 3.11+
        data = tomllib.loads(text)
        pkg = data.get("package") or {}
        info["package"] = pkg.get("name")
        for item in data.get("bin", []):
            if isinstance(item, dict) and isinstance(item.get("name"), str):
                info["bins"].append(item["name"])
                if isinstance(item.get("path"), str):
                    info["bin_paths"][item["name"]] = item["path"]
        info["workspace"] = "workspace" in data
        return info
    except Exception:  # noqa: BLE001 - fall back to a tolerant line parser
        pass
    section = None
    current = None
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("["):
            section = line.strip("[] ").strip()
            current = None
            if section == "workspace":
                info["workspace"] = True
            continue
        match = re.match(r'^(name|path)\s*=\s*"([^"]+)"', line)
        if not match:
            continue
        key, value = match.group(1), match.group(2)
        if section == "package" and key == "name" and not info["package"]:
            info["package"] = value
        elif section == "bin" and key == "name":
            current = value
            info["bins"].append(value)
            if "" in info["bin_paths"]:
                info["bin_paths"][value] = info["bin_paths"].pop("")
        elif section == "bin" and key == "path":
            info["bin_paths"][current if current else ""] = value
    info["bin_paths"].pop("", None)
    return info


def _scan_names(path, keep, count_cap=LIST_COUNT_CAP, skip=()):
    """As the user: at most `keep` entry names of a directory (directory order), the number of
    entries seen (stops counting at count_cap) and whether more exist. Never materialises the
    whole listing, so a directory with millions of entries costs neither memory nor much time.
    A missing or unreadable directory yields ([], 0, False)."""
    names = []
    count = 0
    more = False
    try:
        with os.scandir(path) as entries:
            for entry in entries:
                if entry.name in skip:
                    continue
                if count >= count_cap:
                    more = True
                    break
                count += 1
                if len(names) < keep:
                    names.append(entry.name)
    except OSError:
        return [], 0, False
    return names, count, more


def _user_inspect_app_root(app_root):
    """Runs as the customer: generic facts plus the detection result of every runtime adapter."""
    info = {"exists": os.path.isdir(app_root), "entries": [],
            "triggers": {"deploy": False, "restart": False}}
    for key in RUNTIME_KEYS:
        info[key] = None
    if not info["exists"]:
        return info
    if not os.access(app_root, os.R_OK | os.X_OK):
        raise HelperError("The application root %s cannot be read by the system user" % app_root)
    names, count, more = _scan_names(app_root, LIST_KEEP_ROOT)
    entries = sorted(name.encode("utf-8", "surrogateescape").decode("utf-8", "replace") for name in names)
    info["entry_count"] = count
    info["more"] = more
    info["entries"] = entries[:80]
    for key, rt in RUNTIMES.items():
        try:
            info[key] = rt.inspect(app_root)
        except Exception as exc:  # noqa: BLE001 - one broken project file must not hide the rest
            info.setdefault("inspect_errors", {})[key] = str(exc)[:300]
    info["triggers"]["deploy"] = os.path.exists(os.path.join(app_root, TRIGGER_DEPLOY))
    info["triggers"]["restart"] = os.path.exists(os.path.join(app_root, TRIGGER_RESTART))
    return info


# ---------------------------------------------------------------------------
# systemd helpers
# ---------------------------------------------------------------------------

def systemctl(*args, check=False, timeout=90):
    return run(["systemctl"] + list(args), check=check, timeout=timeout)


def unit_show(units, props):
    if not units:
        return {}
    cmd = ["systemctl", "show", "--no-pager"]
    for prop in props:
        cmd += ["-p", prop]
    # TZ=UTC: timestamps come as "Wed 2026-11-11 16:10:15 UTC" whatever the server's time zone is.
    proc = run(cmd + list(units), timeout=30, env=root_env({"TZ": "UTC"}))
    result = {}
    blocks = proc.stdout.strip().split("\n\n") if proc.stdout.strip() else []
    for unit, block in zip(units, blocks):
        values = {}
        for line in block.splitlines():
            if "=" in line:
                key, val = line.split("=", 1)
                values[key] = val
        result[unit] = values
    return result


def unit_running(unit):
    info = unit_show([unit], ["ActiveState", "SubState"]).get(unit, {})
    return info.get("ActiveState") == "active" and info.get("SubState") == "running"


def unit_is_active(unit):
    state = run(["systemctl", "is-active", unit], timeout=30).stdout.strip()
    return state in ("active", "activating", "reloading", "deactivating")


def systemd_time_iso(value):
    """'Wed 2026-11-11 16:10:15 UTC' (systemctl show with TZ=UTC) -> '2026-11-11T16:10:15+00:00'."""
    match = re.match(r"^(?:\w{3} )?(\d{4}-\d{2}-\d{2}) (\d{2}:\d{2}:\d{2}) UTC$", (value or "").strip())
    return "%sT%s+00:00" % (match.group(1), match.group(2)) if match else None


def systemd_version():
    try:
        first = run(["systemctl", "--version"], timeout=15).stdout.splitlines()[0]
        return int(re.search(r"systemd (\d+)", first).group(1))
    except Exception:  # noqa: BLE001
        return 0


def env_quote(value):
    # systemd EnvironmentFile= double-quoted value: backslash escapes \ " ` $
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("`", "\\`").replace("$", "\\$")
    return '"' + escaped + '"'


def sanitize_description(text):
    return re.sub(r"[^A-Za-z0-9._@+-]", "_", text)[:120]


def toolchain_env(state, pw):
    """Environment shared by builds and the running application: toolchain + per-user caches
    (adapter env()) and the runtime's listen conventions (e.g. ASPNETCORE_URLS, SERVER_PORT)."""
    rt = RUNTIMES.get(state["runtime"])
    paths = []
    env = {}
    if rt is not None:
        if state["toolchain"] and rt.toolchain != "none":
            spec = dict(rt.env(pw.pw_dir, state["toolchain"], state["app_dir"]))
            paths = list(spec.pop("PATH", []))
            env.update(spec)
        if state.get("port"):
            env.update(rt.listen_env(state))
    env["PATH"] = ":".join(paths + [USER_PATH])
    return env


def socket_dir(domain_id):
    return "%s/%d" % (RUN_DIR, domain_id)


def socket_path(domain_id):
    return socket_dir(domain_id) + "/app.sock"


def web_server_group():
    try:
        return grp.getgrnam(WEB_GROUP).gr_name
    except KeyError:
        raise HelperError("The web server group '%s' does not exist; use the TCP listen mode" % WEB_GROUP)


_DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def ensure_run_dir():
    """/run/runway: a real directory owned by root, mode 0755 (only root creates entries in it, so
    no customer can plant or replace /run/runway/<id>)."""
    try:
        st = os.lstat(RUN_DIR)
    except FileNotFoundError:
        st = None
    if st is not None and not stat.S_ISDIR(st.st_mode):
        os.unlink(RUN_DIR)
        st = None
    if st is None:
        os.mkdir(RUN_DIR, 0o755)
    fd = os.open(RUN_DIR, _DIR_FLAGS)
    try:
        os.fchown(fd, 0, 0)
        os.fchmod(fd, 0o755)
    finally:
        os.close(fd)


def ensure_socket_dir(domain_id, pw):
    """Creates /run/runway/<id> as root, owned by the system user and the web server group,
    mode 2750 (setgid: sockets inherit the group). An existing entry must be a real directory
    (anything else is replaced); owner and mode are re-applied through an O_NOFOLLOW descriptor."""
    gid = grp.getgrnam(web_server_group()).gr_gid
    ensure_run_dir()
    parent = os.open(RUN_DIR, _DIR_FLAGS)
    try:
        name = str(int(domain_id))
        try:
            st = os.stat(name, dir_fd=parent, follow_symlinks=False)
        except FileNotFoundError:
            st = None
        if st is not None and not stat.S_ISDIR(st.st_mode):
            os.unlink(name, dir_fd=parent)
            st = None
        if st is None:
            os.mkdir(name, 0o700, dir_fd=parent)
        fd = os.open(name, _DIR_FLAGS, dir_fd=parent)
        try:
            os.fchown(fd, pw.pw_uid, gid)
            os.fchmod(fd, 0o2750)
        finally:
            os.close(fd)
    finally:
        os.close(parent)


def remove_socket_dir(domain_id):
    """Root: removes /run/runway/<id> and its entries (the application is gone or uses TCP now).
    Entries are unlinked through a directory descriptor, never followed."""
    try:
        parent = os.open(RUN_DIR, _DIR_FLAGS)
    except OSError:
        return
    try:
        name = str(int(domain_id))
        try:
            fd = os.open(name, _DIR_FLAGS, dir_fd=parent)
        except OSError:
            try:
                os.unlink(name, dir_fd=parent)
            except OSError:
                pass
            return
        try:
            names = []
            with os.scandir(fd) as entries:
                for entry in entries:
                    names.append(entry.name)
                    if len(names) >= 1000:
                        break
            for entry in names:
                try:
                    st = os.stat(entry, dir_fd=fd, follow_symlinks=False)
                    if not stat.S_ISDIR(st.st_mode):
                        os.unlink(entry, dir_fd=fd)
                except OSError:
                    pass
        except OSError:
            pass
        finally:
            os.close(fd)
        try:
            os.rmdir(name, dir_fd=parent)
        except OSError:
            pass
    finally:
        os.close(parent)


def tmpfiles_path(domain_id):
    return os.path.join(TMPFILES_DIR, "runway-%d.conf" % domain_id)


def write_tmpfiles(state, pw):
    """systemd-tmpfiles entry that recreates the socket directory at boot (before the units
    start), or removes the entry when the application does not use a unix socket."""
    path = tmpfiles_path(state["domain_id"])
    if state.get("listen") != "unix":
        remove_quietly(path)
        return
    ensure_dir(TMPFILES_DIR, 0o755)
    if not os.path.isfile(TMPFILES_BASE):
        write_file_atomic(TMPFILES_BASE, "# Managed by the Plesk Runway extension. Do not edit.\n"
                          "d %s 0755 root root -\n" % RUN_DIR, 0o644)
    write_file_atomic(path, "# Managed by the Plesk Runway extension. Do not edit.\n"
                      "d %s 2750 %s %s -\n" % (socket_dir(state["domain_id"]), pw.pw_name, web_server_group()), 0o644)


def socket_check(state, pw):
    """Unix mode: (detail, code, params) when /run/runway/<id>/app.sock is anything but a socket
    owned by the application's user (e.g. a symbolic link to another application's socket, which
    nginx would follow), else None (also when nothing is there)."""
    path = socket_path(state["domain_id"])
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if stat.S_ISLNK(st.st_mode):
        try:
            target = os.readlink(path)[:200]
        except OSError:
            target = "?"
        return ("%s was replaced by a symbolic link to %s" % (path, target), "socket_symlink",
                {"path": path, "target": target})
    if not stat.S_ISSOCK(st.st_mode):
        return "%s is not a socket" % path, "socket_not_socket", {"path": path}
    if st.st_uid != pw.pw_uid:
        return ("%s belongs to uid %d, not to %s" % (path, st.st_uid, pw.pw_name), "socket_owner",
                {"path": path, "uid": st.st_uid, "user": pw.pw_name})
    return None


def socket_tampered(state, pw):
    """The detail text of socket_check(), or None."""
    found = socket_check(state, pw)
    return found[0] if found else None


def journal_note(domain_id, message, priority=4):
    """Writes a message into the journal of the application unit (shown in its application log)."""
    fields = "MESSAGE=Runway: %s\nPRIORITY=%d\nSYSLOG_IDENTIFIER=runway\nOBJECT_SYSTEMD_UNIT=%s\n" % (
        message.replace("\n", " "), priority, UNIT_APP % domain_id)
    try:
        proc = run(["logger", "--journald"], input_text=fields, timeout=15)
        if proc.returncode == 0:
            return
    except HelperError:
        pass
    try:
        run(["logger", "-t", "runway", "-p", "daemon.warning", "app #%d: %s" % (domain_id, message)], timeout=15)
    except HelperError:
        pass


def contain_tampering(state, detail):
    """The socket path of a unix-mode application was tampered with: stop and disable the service,
    remove the offending entry (as root, through a directory descriptor: unlink never follows a
    link), remember it in the state (Start clears it) and note it in the application's journal."""
    domain_id = state["domain_id"]
    # Unlink first (nginx stops following the link at once), stop the service, unlink again in
    # case the still running application recreated it.
    unlink_socket_entry(domain_id)
    systemctl("disable", "--now", UNIT_APP % domain_id, timeout=120)
    unlink_socket_entry(domain_id)
    with FileLock("ports"):
        stored = read_json(app_state_path(domain_id))
        if isinstance(stored, dict):
            stored.update({"stopped": True, "tampered": True, "tampered_at": now_iso(),
                           "tampered_detail": detail[:300]})
            write_json(app_state_path(domain_id), stored)
    state.update({"stopped": True, "tampered": True, "tampered_detail": detail[:300]})
    journal_note(domain_id, "the application was stopped because its socket path was tampered with (%s). "
                 "Start it again from the panel after checking the start command." % detail)


def update_state_flags(domain_id, **flags):
    """Changes flags (stopped, tampered, ...) of the stored state under the state lock."""
    with FileLock("ports"):
        stored = read_json(app_state_path(domain_id))
        if not isinstance(stored, dict):
            raise HelperError("Application #%d is not configured" % domain_id)
        stored.update(flags)
        write_json(app_state_path(domain_id), stored)
    return stored


def prepare_start(state, pw):
    """Everything a start of the application unit needs that the unit cannot do itself (it runs
    no root lines): the socket directory in unix mode, and files that Runway manages inside the
    application root (as the user). Called by every path that starts or restarts the unit."""
    if state.get("listen") == "unix":
        ensure_socket_dir(state["domain_id"], pw)
        if socket_tampered(state, pw):
            # e.g. the socket of the previous system user after a subscription change.
            unlink_socket_entry(state["domain_id"])
    rt = RUNTIMES.get(state["runtime"])
    if rt is not None:
        rt.prepare_start(state, pw)


def unlink_socket_entry(domain_id):
    """Root: removes whatever /run/runway/<id>/app.sock is (never follows it)."""
    try:
        fd = os.open(socket_dir(domain_id), _DIR_FLAGS)
    except OSError:
        return
    try:
        st = os.stat("app.sock", dir_fd=fd, follow_symlinks=False)
        if stat.S_ISDIR(st.st_mode):
            os.rmdir("app.sock", dir_fd=fd)
        else:
            os.unlink("app.sock", dir_fd=fd)
    except OSError:
        pass
    finally:
        os.close(fd)


_SYSTEMD_VERSION = []


def cached_systemd_version():
    if not _SYSTEMD_VERSION:
        _SYSTEMD_VERSION.append(systemd_version())
    return _SYSTEMD_VERSION[0]


def forced_env(state):
    """Runway-managed variables. Unix socket mode exports only RUNWAY_SOCKET (no PORT, HOST or
    LISTEN_ADDR: the unit denies every TCP bind there, and frameworks that prefer PORT would try
    to bind it); the port stays reserved in the state so switching back to TCP keeps it."""
    env = {
        "RUNWAY_APP_ROOT": state["app_dir"],
        "RUNWAY_LISTEN": state.get("listen", "tcp"),
    }
    if state.get("listen") == "unix":
        env["RUNWAY_SOCKET"] = socket_path(state["domain_id"])
    else:
        port = str(state["port"])
        env.update({"PORT": port, "HOST": "127.0.0.1", "LISTEN_ADDR": "127.0.0.1:" + port})
    return env


def merged_env(state, pw):
    """Toolchain env + user-defined variables + Runway-managed variables (in that precedence order)."""
    env = toolchain_env(state, pw)
    for key, val in state["env"].items():
        if key == "PATH":
            if val:
                env["PATH"] = val + ":" + env["PATH"]
        else:
            env[key] = val
    env.update(forced_env(state))
    return env


def render_env_file(state, pw):
    env = merged_env(state, pw)
    env["RUNWAY_START_CMD"] = state["start_cmd"] or "echo 'No start command configured' >&2; exit 1"
    lines = ["# Managed by the Plesk Runway extension. Do not edit."]
    for key in sorted(env):
        lines.append("%s=%s" % (key, env_quote(env[key])))
    return "\n".join(lines) + "\n"


def render_app_unit(state, pw):
    domain_id = state["domain_id"]
    group = grp.getgrgid(pw.pw_gid).gr_name
    lines = [
        "# Managed by the Plesk Runway extension. Manual changes will be overwritten.",
        "[Unit]",
        "Description=Runway app #%d (%s, %s)" % (domain_id, sanitize_description(state["domain"]), state["runtime"]),
        # Soft ordering after local databases (units that do not exist are ignored), so an app that
        # needs its database at boot does not exhaust the start limit while it recovers.
        "After=network-online.target mariadb.service mysql.service postgresql.service",
        "Wants=network-online.target",
        "StartLimitIntervalSec=120",
        "StartLimitBurst=%d" % APP_START_LIMIT_BURST,
        "",
        "[Service]",
        "Type=simple",
        "User=%s" % pw.pw_name,
        "Group=%s" % group,
        "WorkingDirectory=%s" % state["app_dir"],
        "EnvironmentFile=%s" % env_file_path(domain_id),
    ]
    if state.get("listen") == "unix":
        # /run/runway/<id> is created by the helper (prepare_start) and by systemd-tmpfiles at boot
        # (/etc/tmpfiles.d/runway-<id>.conf). No Exec line of this unit ever runs as root ("+"/"!"):
        # every Exec line gets the customer's environment file.
        lines.append("ExecStartPre=/bin/rm -f %s" % socket_path(domain_id))
    lines += [
        # ${VAR} as a separate word expands to exactly one argument (no word splitting).
        "ExecStart=/bin/bash -c ${RUNWAY_START_CMD}",
        "Restart=always",
        "RestartSec=3",
        "TimeoutStopSec=30",
        "SyslogIdentifier=runway-app-%d" % domain_id,
        # Unix socket mode needs a group-connectable socket (group = web server group).
        "UMask=%s" % ("0007" if state.get("listen") == "unix" else "0027"),
        "LimitNOFILE=65536",
        "NoNewPrivileges=yes",
        "PrivateTmp=yes",
        "PrivateDevices=yes",
        "ProtectSystem=full",
        "ProtectKernelTunables=yes",
        "ProtectKernelModules=yes",
        "ProtectControlGroups=yes",
        "RestrictSUIDSGID=yes",
        "RestrictRealtime=yes",
        "LockPersonality=yes",
    ]
    if cached_systemd_version() >= 249:
        # Applications may only bind their own port, so a Runway app can never squat another
        # app's port (Unix sockets are not affected by these settings).
        if state.get("listen") == "unix":
            lines.append("SocketBindDeny=any")
        else:
            lines += ["SocketBindAllow=tcp:%d" % int(state["port"]), "SocketBindDeny=any"]
    limits = state["limits"]
    if limits["memory_mb"]:
        lines.append("MemoryMax=%dM" % limits["memory_mb"])
    if limits["cpu_percent"]:
        lines.append("CPUQuota=%d%%" % limits["cpu_percent"])
    if limits["tasks"]:
        lines.append("TasksMax=%d" % limits["tasks"])
    lines += ["", "[Install]", "WantedBy=multi-user.target", ""]
    return "\n".join(lines)


def deploy_timeout(state):
    """Backstop of the deploy unit: a fetch (bounded by FETCH_TIMEOUT and the build timeout), the
    build itself, and 300 s for the restart and the listener check. The helper enforces its own
    deadlines for each step; TimeoutStartSec only catches a hung job."""
    return min(FETCH_TIMEOUT, state["build_timeout"]) + state["build_timeout"] + 300


def render_deploy_service(state):
    domain_id = state["domain_id"]
    timeout = deploy_timeout(state)
    return "\n".join([
        "# Managed by the Plesk Runway extension. Manual changes will be overwritten.",
        "[Unit]",
        "Description=Runway deploy job #%d (%s)" % (domain_id, sanitize_description(state["domain"])),
        "",
        "[Service]",
        "Type=oneshot",
        "ExecStart=%s _deploy %d" % (HELPER_COPY, domain_id),
        "TimeoutStartSec=%d" % timeout,
        "Nice=10",
        "IOSchedulingClass=best-effort",
        "IOSchedulingPriority=7",
    ] + build_limit_lines(state) + [""])


def build_limit_lines(state):
    """Builds run customer code: always cap tasks, and apply the admin's build limits."""
    limits = state.get("build_limits") or {}
    lines = ["TasksMax=%d" % (int(limits.get("tasks") or 0) or DEFAULT_BUILD_TASKS)]
    if limits.get("memory_mb"):
        lines.append("MemoryMax=%dM" % int(limits["memory_mb"]))
    if limits.get("cpu_percent"):
        lines.append("CPUQuota=%d%%" % int(limits["cpu_percent"]))
    return lines


def render_deploy_path(state):
    domain_id = state["domain_id"]
    root = state["app_dir"]
    return "\n".join([
        "# Managed by the Plesk Runway extension. Manual changes will be overwritten.",
        "[Unit]",
        "Description=Runway deploy trigger #%d (%s)" % (domain_id, sanitize_description(state["domain"])),
        "",
        "[Path]",
        "PathChanged=%s/%s" % (root, TRIGGER_DEPLOY),
        "PathChanged=%s/%s" % (root, TRIGGER_RESTART),
        "Unit=%s" % (UNIT_DEPLOY % domain_id),
        "",
        "[Install]",
        "WantedBy=multi-user.target",
        "",
    ])


# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

def listening_ports():
    ports = set()
    for name in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(name, "r") as fh:
                rows = fh.read().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            parts = row.split()
            if len(parts) > 3 and parts[3] == "0A":  # TCP_LISTEN
                try:
                    ports.add(int(parts[1].rsplit(":", 1)[1], 16))
                except (IndexError, ValueError):
                    pass
    return ports


def assigned_ports(exclude_id=None):
    ports = {}
    for state in iter_app_states():
        if state.get("domain_id") != exclude_id and state.get("port"):
            ports[int(state["port"])] = state.get("domain_id")
    return ports


def allocate_port(domain_id, current, port_range):
    taken = assigned_ports(exclude_id=domain_id)
    if current and current not in taken:
        return current
    listening = listening_ports()
    for port in range(port_range[0], port_range[1] + 1):
        if port not in taken and port not in listening:
            return port
    raise HelperError("No free port left in range %d-%d" % tuple(port_range))


def tcp_listener_uids(port):
    """uids of the sockets listening on `port` (any address), from /proc/net/tcp{,6}."""
    uids = set()
    for name in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(name, "r") as fh:
                rows = fh.read().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            parts = row.split()
            if len(parts) > 7 and parts[3] == "0A":
                try:
                    if int(parts[1].rsplit(":", 1)[1], 16) == port:
                        uids.add(int(parts[7]))
                except (IndexError, ValueError):
                    pass
    return uids


def listener_info(state, pw):
    """Returns (state, detail, code, params): "ok" when the app's own user listens on the app's
    endpoint, "none" when nothing listens, "foreign" when another user holds the TCP port (hijack
    attempt), "tampered" when the unix socket path is not the application's own socket (e.g. a
    symbolic link to another application's socket), "worker" for listen mode none (nothing to
    check). detail is English; code + params let the panel translate it (docs/DESIGN.md 7)."""
    if state.get("listen") == "none":
        return "worker", "workers are not checked for a listener", "worker", {}
    if state.get("listen") == "unix":
        path = socket_path(state["domain_id"])
        if state.get("tampered"):
            return "tampered", state.get("tampered_detail") or path, "tampered", {"path": path}
        found = socket_check(state, pw)
        if found:
            return "tampered", found[0], found[1], found[2]
        try:
            os.lstat(path)
        except OSError:
            return "none", path, "none", {"endpoint": path}
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(0.5)
        try:
            sock.connect(path)
            return "ok", path, "ok", {"endpoint": path}
        except OSError:
            return "none", path, "none", {"endpoint": path}
        finally:
            sock.close()
    port = int(state.get("port") or 0)
    endpoint = "127.0.0.1:%d" % port
    uids = tcp_listener_uids(port) if port else set()
    if not uids:
        return "none", endpoint, "none", {"endpoint": endpoint}
    if uids == {pw.pw_uid}:
        return "ok", endpoint, "ok", {"endpoint": endpoint}
    others = ", ".join(str(uid) for uid in sorted(uid for uid in uids if uid != pw.pw_uid))
    return "foreign", "port %d is held by uid %s" % (port, others), "foreign", {"port": port, "uids": others}


def listener_state(state, pw):
    """(state, detail) of listener_info()."""
    return listener_info(state, pw)[:2]


def port_is_listening(port, timeout=0.5):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except OSError:
        return False


def iter_app_states():
    try:
        names = os.listdir(APPS_DIR)
    except OSError:
        return
    for name in sorted(names):
        if re.match(r"^\d+\.json$", name):
            state = read_json(os.path.join(APPS_DIR, name))
            if isinstance(state, dict):
                yield state


# ---------------------------------------------------------------------------
# Jobs (status files + logs)
# ---------------------------------------------------------------------------

def job_unit(job):
    if job == "admin":
        return UNIT_ADMIN_JOB
    match = re.match(r"^deploy-(\d+)$", job)
    if match:
        return UNIT_DEPLOY % int(match.group(1))
    raise HelperError("Unknown job")


def v_job(value):
    if not isinstance(value, str) or not re.match(r"^(admin|deploy-\d{1,10})$", value):
        raise HelperError("Invalid job name")
    return value


def job_set_status(job, **fields):
    ensure_dir(JOBS_DIR, 0o700)
    status_path = job_paths(job)[0]
    status = read_json(status_path, {}) or {}
    status.update(fields)
    status["job"] = job
    status["updated_at"] = now_iso()
    write_json(status_path, status)
    return status


def job_get_status(job):
    status_path, log_path, _ = job_paths(job)
    status = read_json(status_path, None)
    if not status:
        return {"job": job, "state": "none"}
    if status.get("state") in ("queued", "running"):
        active = unit_is_active(job_unit(job))
        if not active:
            # The job may have finished between the read above and the is-active check:
            # re-read, and only mark it failed if nothing was written in the meantime.
            fresh = read_json(status_path, None) or {}
            if fresh.get("updated_at") != status.get("updated_at") or fresh.get("state") != status.get("state"):
                return fresh
            started = status.get("queued_epoch") or 0
            if status.get("state") == "running" or time.time() - started > 20:
                status = job_set_status(job, state="failed", finished_at=now_iso(),
                                        message="The job was interrupted before it could finish.")
    return status


class JobLog(object):
    """Root-owned job log with a size cap."""

    def __init__(self, job, append=False):
        ensure_dir(JOBS_DIR, 0o700)
        self.path = job_paths(job)[1]
        self.fh = open(self.path, "ab" if append else "wb")
        os.chmod(self.path, 0o600)
        self.size = self.fh.tell()
        self.truncated = False

    def write(self, data):
        if isinstance(data, str):
            data = data.encode("utf-8", "replace")
        if self.size >= LOG_CAP:
            if not self.truncated:
                self.fh.write(b"\n[log truncated: size limit reached]\n")
                self.truncated = True
            return
        self.fh.write(data)
        self.size += len(data)
        self.fh.flush()

    def line(self, text):
        self.write("[%s] %s\n" % (datetime.datetime.now().strftime("%H:%M:%S"), text))

    def close(self):
        self.fh.close()


def stream_process(cmd, log, timeout, env, cwd=None, preexec=None):
    """Runs cmd, streaming combined output to the log. Returns the exit code (124 on timeout)."""
    proc = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
        env=env, cwd=cwd, preexec_fn=preexec, start_new_session=True, close_fds=True,
    )
    deadline = time.time() + timeout
    fd = proc.stdout.fileno()
    try:
        while True:
            remaining = deadline - time.time()
            if remaining <= 0:
                log.line("Timed out after %d seconds, terminating." % timeout)
                kill_group(proc)
                return 124
            ready, _, _ = select.select([fd], [], [], min(remaining, 1.0))
            if ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                log.write(chunk)
        return proc.wait(timeout=max(1, deadline - time.time()))
    except subprocess.TimeoutExpired:
        kill_group(proc)
        return 124
    finally:
        try:
            proc.stdout.close()
        except OSError:
            pass


def kill_group(proc):
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except OSError:
            return
        try:
            proc.wait(timeout=10)
            return
        except subprocess.TimeoutExpired:
            continue


# ---------------------------------------------------------------------------
# Network downloads (toolchains)
# ---------------------------------------------------------------------------

def http_get(url, timeout=HTTP_TIMEOUT):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=timeout) as resp:  # nosec - fixed https URLs
        return resp.read()


def download(url, dest, sha256, log, algo="sha256"):
    """Downloads url to dest and verifies the hex digest `sha256` (computed with `algo`) when given."""
    log.line("Downloading %s" % url)
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    digest = hashlib.new(algo)
    total = 0
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as resp, open(dest, "wb") as out:  # nosec
        while True:
            chunk = resp.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
            out.write(chunk)
            total += len(chunk)
    log.line("Downloaded %.1f MiB" % (total / 1048576.0))
    if sha256 and digest.hexdigest().lower() != sha256.lower():
        raise HelperError("Checksum mismatch for %s" % url)
    if sha256:
        log.line("%s verified" % algo.upper().replace("SHA", "SHA-"))
    return dest


def go_releases(force=False):
    ensure_dir(CACHE_DIR, 0o700)
    cache = os.path.join(CACHE_DIR, "go-releases.json")
    cached = read_json(cache)
    if not force and cached and time.time() - cached.get("fetched", 0) < 6 * 3600:
        return cached["releases"]
    arch = host_arch()[0]
    raw = json.loads(http_get("https://go.dev/dl/?mode=json&include=all").decode("utf-8"))
    releases = []
    for rel in raw:
        if not rel.get("stable"):
            continue
        version = rel.get("version", "")
        for item in rel.get("files", []):
            if item.get("os") == "linux" and item.get("arch") == arch and item.get("kind") == "archive":
                releases.append({
                    "version": version[2:] if version.startswith("go") else version,
                    "filename": item.get("filename"),
                    "sha256": item.get("sha256"),
                    "size": item.get("size"),
                })
                break
    write_json(cache, {"fetched": time.time(), "releases": releases})
    return releases


def version_key(version):
    return [int(part) if part.isdigit() else 0 for part in re.split(r"[.]", re.sub(r"(rc|beta).*$", "", version))]


def rust_latest_stable(force=False):
    ensure_dir(CACHE_DIR, 0o700)
    cache = os.path.join(CACHE_DIR, "rust-stable.json")
    cached = read_json(cache)
    if not force and cached and time.time() - cached.get("fetched", 0) < 6 * 3600:
        return cached["version"]
    text = http_get("https://static.rust-lang.org/dist/channel-rust-stable.toml").decode("utf-8", "replace")
    match = re.search(r'\[pkg\.rust\]\s*\nversion\s*=\s*"(\d+\.\d+\.\d+)', text)
    version = match.group(1) if match else None
    write_json(cache, {"fetched": time.time(), "version": version})
    return version


def _link_inside(name, linkname, hard=False):
    """True when a relative link target stays inside the archive tree."""
    while linkname.startswith("./"):
        linkname = linkname[2:]
    if not linkname or linkname.startswith("/"):
        return False
    target = os.path.normpath(os.path.join("" if hard else os.path.dirname(name), linkname))
    return target != ".." and not target.startswith("../")


def safe_extract(archive, dest, skip=None):
    """Extracts a .tar.gz after checking every member (no absolute paths, no '..', no devices,
    no links leaving the tree). Returns the member names (without a leading './')."""
    names = []
    with tarfile.open(archive, "r:gz") as tar:
        members = []
        for member in tar.getmembers():
            name = member.name
            while name.startswith("./"):
                name = name[2:]
            if name in ("", "."):
                continue
            if name.startswith("/") or ".." in name.split("/") or member.isdev() \
                    or not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
                raise HelperError("Refusing to extract suspicious archive member: %s" % name)
            if (member.issym() or member.islnk()) and not _link_inside(name, member.linkname, member.islnk()):
                raise HelperError("Refusing to extract suspicious link: %s" % name)
            if skip and name in skip:
                continue
            member.name = name
            # Toolchains are root-owned: never keep the archive's uid/gid (it may be a customer's).
            member.uid = member.gid = 0
            member.uname = member.gname = "root"
            members.append(member)
            names.append(name.rstrip("/"))
        if hasattr(tarfile, "data_filter"):
            tar.extractall(dest, members=members, filter="tar")
        else:
            tar.extractall(dest, members=members)  # nosec - members checked above
    return names


def chmod_public(root):
    """Makes a toolchain tree readable/executable by all users and writable only by root."""
    as_root = os.geteuid() == 0
    for dirpath, dirnames, filenames in os.walk(root):
        if as_root:
            os.lchown(dirpath, 0, 0)
        os.chmod(dirpath, 0o755)
        for name in filenames + [d for d in dirnames if os.path.islink(os.path.join(dirpath, d))]:
            path = os.path.join(dirpath, name)
            if as_root:
                os.lchown(path, 0, 0)
            if os.path.islink(path):
                continue
            mode = os.stat(path).st_mode
            os.chmod(path, 0o755 if mode & 0o111 else 0o644)


# ---------------------------------------------------------------------------
# Toolchains
# ---------------------------------------------------------------------------

def installed_go():
    result = []
    try:
        names = os.listdir(GO_ROOT_DIR)
    except OSError:
        return result
    for name in names:
        if RE_GO_VERSION.match(name) and os.path.isfile(os.path.join(GO_ROOT_DIR, name, "bin", "go")):
            result.append(name)
    return sorted(result, key=version_key, reverse=True)


def installed_rust():
    result = []
    triple = host_arch()[1]
    base = os.path.join(RUSTUP_HOME, "toolchains")
    try:
        names = os.listdir(base)
    except OSError:
        return result
    for name in names:
        if not name.endswith("-" + triple):
            continue
        toolchain = name[: -len(triple) - 1]
        rustc = os.path.join(base, name, "bin", "rustc")
        if RE_RUST_TOOLCHAIN.match(toolchain) and os.path.isfile(rustc):
            version = ""
            try:
                version = run([rustc, "--version"], timeout=20).stdout.strip()
            except HelperError:
                pass
            result.append({"name": toolchain, "version": version})
    return sorted(result, key=lambda item: item["name"])


def toolchain_installed(runtime, toolchain):
    rt = RUNTIMES.get(runtime)
    if not toolchain or rt is None or rt.toolchain == "none":
        return True
    return rt.is_installed(toolchain)


def toolchains_in_use():
    used = dict((key, {}) for key in RUNTIME_KEYS)
    for state in iter_app_states():
        runtime = state.get("runtime")
        if runtime in used and state.get("toolchain"):
            used[runtime].setdefault(state["toolchain"], []).append(state.get("domain"))
    return used


def rust_env():
    return root_env({
        "RUSTUP_HOME": RUSTUP_HOME,
        "CARGO_HOME": RUSTUP_CARGO_HOME,
        "RUSTUP_INIT_SKIP_PATH_CHECK": "yes",
        "PATH": RUSTUP_CARGO_HOME + "/bin:" + ROOT_PATH,
    })


def rustup_bin():
    return os.path.join(RUSTUP_CARGO_HOME, "bin", "rustup")


def job_install_go(version, log):
    if not RE_GO_VERSION.match(version or ""):
        raise HelperError("Invalid Go version")
    target = go_dir(version)
    if os.path.isfile(os.path.join(target, "bin", "go")):
        log.line("Go %s is already installed." % version)
        return
    release = next((r for r in go_releases(force=True) if r["version"] == version), None)
    if not release:
        raise HelperError("Go %s is not available for this architecture" % version)
    ensure_dir(GO_ROOT_DIR)
    work = tempfile.mkdtemp(prefix=".install-", dir=GO_ROOT_DIR)
    try:
        archive = download("https://dl.google.com/go/" + release["filename"],
                           os.path.join(work, release["filename"]), release["sha256"], log)
        log.line("Extracting archive")
        extract_to = os.path.join(work, "x")
        os.mkdir(extract_to, 0o755)
        safe_extract(archive, extract_to)
        if not os.path.isfile(os.path.join(extract_to, "go", "bin", "go")):
            raise HelperError("Unexpected archive layout")
        if os.path.exists(target):
            shutil.rmtree(target)
        os.rename(os.path.join(extract_to, "go"), target)
        chmod_public(target)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    proc = run([os.path.join(target, "bin", "go"), "version"], env=root_env({"GOTOOLCHAIN": "local", "GOCACHE": "/tmp/runway-go-cache"}), timeout=60)
    log.line(proc.stdout.strip() or proc.stderr.strip())
    log.line("Go %s installed to %s" % (version, target))


def ensure_rustup(log):
    if os.path.isfile(rustup_bin()):
        return
    triple = host_arch()[1]
    url = "https://static.rust-lang.org/rustup/dist/%s/rustup-init" % triple
    sha = http_get(url + ".sha256").decode("utf-8").split()[0]
    ensure_dir(RUST_ROOT_DIR)
    work = tempfile.mkdtemp(prefix=".install-", dir=RUST_ROOT_DIR)
    try:
        init = download(url, os.path.join(work, "rustup-init"), sha, log)
        os.chmod(init, 0o700)
        log.line("Installing rustup to %s" % RUST_ROOT_DIR)
        code = stream_process([init, "-y", "--no-modify-path", "--default-toolchain", "none", "--profile", "minimal"],
                              log, 900, rust_env())
        if code != 0:
            raise HelperError("rustup-init failed with exit code %d" % code)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    run([rustup_bin(), "set", "auto-self-update", "disable"], env=rust_env(), timeout=60)
    run([rustup_bin(), "set", "profile", "minimal"], env=rust_env(), timeout=60)


def job_install_rust(toolchain, log):
    if not RE_RUST_TOOLCHAIN.match(toolchain or ""):
        raise HelperError("Invalid Rust toolchain")
    ensure_rustup(log)
    log.line("Installing Rust toolchain '%s'" % toolchain)
    code = stream_process([rustup_bin(), "toolchain", "install", toolchain, "--profile", "minimal", "--no-self-update"],
                          log, 3600, rust_env())
    if code != 0:
        raise HelperError("rustup toolchain install failed with exit code %d" % code)
    chmod_public(RUST_ROOT_DIR)
    proc = run([os.path.join(rust_toolchain_dir(toolchain), "bin", "rustc"), "--version"], timeout=60)
    log.line(proc.stdout.strip())


def job_update_rust(toolchain, log):
    if toolchain not in ("stable", "beta") and not toolchain.startswith("nightly"):
        raise HelperError("Only channel toolchains (stable, beta, nightly) can be updated")
    job_install_rust(toolchain, log)
    code = stream_process([rustup_bin(), "update", toolchain, "--no-self-update"], log, 3600, rust_env())
    if code != 0:
        raise HelperError("rustup update failed with exit code %d" % code)
    chmod_public(RUST_ROOT_DIR)


def job_build_deps(log):
    if shutil.which("apt-get", path=ROOT_PATH):
        env = root_env({"DEBIAN_FRONTEND": "noninteractive"})
        code = stream_process(["apt-get", "update"], log, 900, env)
        if code != 0:
            raise HelperError("apt-get update failed")
        code = stream_process(["apt-get", "install", "-y", "--no-install-recommends",
                               "build-essential", "pkg-config", "libssl-dev", "cmake", "git", "unzip",
                               "zlib1g-dev", "libgmp-dev", "libyaml-dev", "libffi-dev"], log, 1800, env)
    elif shutil.which("dnf", path=ROOT_PATH):
        # strict=0: packages missing from the enabled repositories (e.g. CRB) are skipped.
        code = stream_process(["dnf", "install", "-y", "--setopt=strict=0", "gcc", "gcc-c++", "make",
                               "pkgconf-pkg-config", "openssl-devel", "cmake", "git", "unzip", "zlib-devel",
                               "gmp-devel", "libyaml-devel", "libffi-devel"], log, 1800, root_env())
    else:
        raise HelperError("No supported package manager (apt-get or dnf) found")
    if code != 0:
        raise HelperError("Package installation failed with exit code %d" % code)


def build_deps_status():
    return {name: bool(shutil.which(name, path=ROOT_PATH)) for name in ("cc", "pkg-config", "cmake", "git")}


# ---------------------------------------------------------------------------
# Runtime adapters (docs/DESIGN.md section 5). RUNTIMES (end of this section) is the single
# source of truth for runtime metadata, toolchains, environments, detection and samples.
# Methods documented "as the user" run inside call_as_user (dropped privileges).
# ---------------------------------------------------------------------------

RELEASE_CACHE_TTL = 6 * 3600
COMPOSER_BIN_DIR = BASE_DIR + "/composer/bin"
COMPOSER_PHARS = ("/usr/lib/plesk-9.0/composer.phar", "/usr/lib64/plesk-9.0/composer.phar",
                  "/usr/local/psa/var/modules/composer/composer.phar")


def _listdir(path):
    try:
        return os.listdir(path)
    except OSError:
        return []


def _read_text(path, limit=8192):
    try:
        with open(path, "r", errors="replace") as fh:
            return fh.read(limit).strip()
    except OSError:
        return ""


def write_text(path, content, mode=0o644):
    with open(path, "w") as fh:
        fh.write(content)
    os.chmod(path, mode)


def num_key(value):
    return [int(part) for part in re.findall(r"\d+", value or "")]


def java_key(value):
    """Sort key of Temurin ids: (feature, interim, update, patch, build), missing parts = 0, so the
    GA "27+37" sorts below its update "27.0.1+8" (num_key would rank [27, 37] above [27, 0, 1, 8])."""
    match = re.match(r"^(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:\.(\d+))?(?:\.\d+)*(?:\+(\d+))?$", value or "")
    if not match:
        return (-1,) + tuple(num_key(value))
    return tuple(int(part or 0) for part in match.groups())


def machine_arch():
    machine = os.uname().machine
    if machine in ("x86_64", "amd64"):
        return "x86_64"
    if machine in ("aarch64", "arm64"):
        return "aarch64"
    raise HelperError("Unsupported CPU architecture: %s" % machine)


def cpu_flags():
    try:
        with open("/proc/cpuinfo") as fh:
            for line in fh:
                if line.startswith("flags"):
                    return set(line.split(":", 1)[1].split())
    except OSError:
        pass
    return set()


def http_json(url, headers=None, timeout=HTTP_TIMEOUT, limit=32 * 1024 * 1024):
    hdrs = {"User-Agent": USER_AGENT, "Accept": "application/json"}
    hdrs.update(headers or {})
    request = urllib.request.Request(url, headers=hdrs)
    with urllib.request.urlopen(request, timeout=timeout) as resp:  # nosec - fixed https URLs
        return json.loads(resp.read(limit).decode("utf-8"))


def cached_json(name, force, fetch):
    """Release metadata cached for 6 hours. A failed refresh serves the stale copy if any."""
    ensure_dir(CACHE_DIR, 0o700)
    path = os.path.join(CACHE_DIR, name + ".json")
    cached = read_json(path)
    if not force and isinstance(cached, dict) and time.time() - cached.get("fetched", 0) < RELEASE_CACHE_TTL:
        return cached.get("data")
    try:
        data = fetch()
    except Exception:  # noqa: BLE001
        if isinstance(cached, dict) and cached.get("data"):
            return cached["data"]
        raise
    write_json(path, {"fetched": time.time(), "data": data})
    return data


def github_releases(repo, force=False, per_page=30):
    """Published releases of a GitHub repository (newest first) with their Linux assets.
    The unauthenticated API needs a User-Agent and allows 60 requests per hour: cached 6 h."""
    def fetch():
        try:
            raw = http_json("https://api.github.com/repos/%s/releases?per_page=%d" % (repo, per_page),
                            {"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"})
        except urllib.error.HTTPError as exc:
            if exc.code in (403, 429):
                raise HelperError("GitHub API rate limit reached (60 requests per hour); try again later")
            raise
        result = []
        for rel in raw if isinstance(raw, list) else []:
            if not isinstance(rel, dict) or rel.get("draft"):
                continue
            assets = {}
            for asset in rel.get("assets") or []:
                name = str(asset.get("name") or "")
                if "linux" not in name and not name.lower().startswith(("sha", "checksum")):
                    continue
                digest = str(asset.get("digest") or "")
                assets[name] = {"url": asset.get("browser_download_url"), "size": asset.get("size"),
                                "sha256": digest[7:].lower() if digest.startswith("sha256:") else None}
            result.append({"tag": str(rel.get("tag_name") or ""), "prerelease": bool(rel.get("prerelease")),
                           "published": str(rel.get("published_at") or "")[:10], "assets": assets})
        return result
    return cached_json("github-" + repo.replace("/", "-"), force, fetch)


def parse_shasums(text):
    sums = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2 and re.match(r"^[0-9a-fA-F]{64}$", parts[0]):
            sums[parts[1].lstrip("*")] = parts[0].lower()
    return sums


def https_url(url):
    if not isinstance(url, str) or not url.startswith("https://") or RE_CTRL_ANY.search(url) or " " in url:
        raise HelperError("Unexpected download URL in the release metadata")
    return url


def swap_dir(stage, target, work):
    """Moves a staged toolchain into place; a previous one is moved into `work` (deleted later)."""
    if os.path.lexists(target):
        os.rename(target, os.path.join(work, ".old"))
    os.rename(stage, target)


def _which_status(names):
    return dict((name, bool(shutil.which(name, path=ROOT_PATH))) for name in names)


def _files(app_dir, *names):
    """As the user: the names (relative paths) that exist as files in app_dir."""
    return [name for name in names if os.path.isfile(os.path.join(app_dir, name))]


def _json_file(path):
    try:
        data = json.loads(_read_small(path))
    except (ValueError, HelperError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def _safe_rel(value):
    return value if isinstance(value, str) and len(value) <= 200 and RE_REL_PATH.match(value) \
        and ".." not in value.split("/") else None


def ensure_composer_wrapper():
    """composer on PATH for PHP apps: a wrapper around Plesk's composer.phar."""
    phar = next((p for p in COMPOSER_PHARS if os.path.isfile(p)), None)
    if not phar:
        return
    content = ("#!/bin/sh\n# Managed by the Plesk Runway extension: Plesk's composer.phar with the php on PATH.\n"
               "exec php %s \"$@\"\n" % phar)
    path = COMPOSER_BIN_DIR + "/composer"
    if _read_text(path) == content.strip():
        return
    ensure_dir(os.path.dirname(COMPOSER_BIN_DIR))
    ensure_dir(COMPOSER_BIN_DIR)
    write_file_atomic(path, content, 0o755)


class Runtime(object):
    """Common interface of the runtime adapters (docs/DESIGN.md section 5.1)."""
    key = ""
    label = ""
    toolchain = "managed"   # managed | detected | none
    version_re = ""
    hint = ""
    docs_url = ""
    default_listen = "tcp"
    supports_build = True
    install_help = ""
    # Toolchains whose default start command can listen on a unix socket ("" = all of them).
    unix_toolchain_re = ""
    # The default commands differ per toolchain (app-page then adds variants per installed toolchain).
    defaults_per_toolchain = False

    def meta(self):
        # hint_key / install_help_key: locale keys of the panel for the English hint/install_help
        # (the panel translates them and falls back to the English text).
        return {"key": self.key, "label": self.label, "toolchain": self.toolchain,
                "version_re": self.version_re, "hint": self.hint, "docs_url": self.docs_url,
                "default_listen": self.default_listen, "supports_build": self.supports_build,
                "install_help": self.install_help, "detected_only": self.toolchain == "detected",
                "unix_toolchain_re": self.unix_toolchain_re,
                "hint_key": "Runtime.%s.hint" % self.key if self.hint else "",
                "install_help_key": "Runtime.%s.installHelp" % self.key if self.install_help else ""}

    def check_version(self, value):
        value = str(value if value is not None else "").strip()
        if not self.version_re or not re.match(self.version_re, value):
            raise HelperError("Invalid %s version '%s'" % (self.label, value[:64]))
        return value

    def resolve(self, version):
        """The installed toolchain id a configured version uses (e.g. a Java major)."""
        return version

    def may_use(self, configured, build):
        """True when the configured id is a channel that can resolve to the installed build."""
        return False

    def list_installed(self):
        return []

    def is_installed(self, version):
        version = self.resolve(version)
        return any(item.get("id") == version for item in self.list_installed())

    def list_available(self, force=False):
        return []

    def check_installable(self, version):
        if self.toolchain != "managed":
            raise HelperError(self.install_help or "The %s runtime has no installable toolchain" % self.label)

    def updatable(self, version):
        return False

    def install(self, version, log):
        raise HelperError(self.install_help or "The %s runtime has no installable toolchain" % self.label)

    def update(self, version, log):
        raise HelperError("Only channel toolchains can be updated: install the newer version, then remove the old one")

    def remove(self, version):
        raise HelperError("%s versions provided by the system cannot be removed by Runway" % self.label)

    def env(self, home, version, app_dir=None):
        return {"PATH": []}

    def listen_env(self, state):
        return {}

    def inspect(self, app_dir):
        return None

    def defaults(self, inspect, listen="tcp", toolchain=""):
        return {"build_cmd": "", "start_cmd": "./app"}

    def sample(self, listen, toolchain=""):
        return {}

    def prepare_start(self, state, pw):
        """Runs as root before every start of the application unit (see prepare_start())."""
        return None

    def build_deps(self):
        return []

    def _remove_dir(self, root, name):
        path = os.path.join(root, name)
        if not os.path.isdir(path) or os.path.islink(path):
            raise HelperError("%s %s is not installed" % (self.label, name))
        shutil.rmtree(path)


# --- Go -------------------------------------------------------------------

class GoRuntime(Runtime):
    key = "go"
    label = "Go"
    version_re = RE_GO_VERSION.pattern
    hint = "Official go.dev release archives, verified with SHA-256."
    docs_url = "https://go.dev/doc/"

    def list_installed(self):
        return [{"id": v, "label": "Go " + v, "path": go_dir(v)} for v in installed_go()]

    def list_available(self, force=False):
        latest_by_minor = {}
        for rel in go_releases(force):
            minor = ".".join(rel["version"].split(".")[:2])
            if minor not in latest_by_minor or version_key(rel["version"]) > version_key(latest_by_minor[minor]):
                latest_by_minor[minor] = rel["version"]
        versions = sorted(latest_by_minor.values(), key=version_key, reverse=True)[:12]
        return [{"id": v, "label": "Go " + v} for v in versions]

    def install(self, version, log):
        job_install_go(version, log)

    def remove(self, version):
        self._remove_dir(GO_ROOT_DIR, self.check_version(version))

    def env(self, home, version, app_dir=None):
        goroot = go_dir(version)
        gopath = os.path.join(home, ".runway", "go")
        return {
            "PATH": [goroot + "/bin", gopath + "/bin"],
            "GOROOT": goroot,
            "GOPATH": gopath,
            "GOMODCACHE": os.path.join(gopath, "pkg", "mod"),
            "GOCACHE": os.path.join(home, ".runway", "cache", "go-build"),
            "GOENV": os.path.join(home, ".runway", "go.env"),
            "GOTOOLCHAIN": "local",
            # Keep the module cache deletable by the customer (FTP / File Manager).
            "GOFLAGS": "-modcacherw",
        }

    def inspect(self, app_dir):
        gomod = os.path.join(app_dir, "go.mod")
        if not os.path.isfile(gomod):
            return None
        text = _read_small(gomod)
        module = re.search(r"^module\s+(\S+)", text, re.M)
        godir = re.search(r"^go\s+(\S+)", text, re.M)
        toolchain = re.search(r"^toolchain\s+go(\S+)", text, re.M)
        return {
            "module": module.group(1) if module else None,
            "go": godir.group(1) if godir else None,
            "toolchain": toolchain.group(1) if toolchain else None,
            "has_main": os.path.isfile(os.path.join(app_dir, "main.go")),
            "has_cmd": os.path.isdir(os.path.join(app_dir, "cmd")),
        }

    def defaults(self, inspect, listen="tcp", toolchain=""):
        return {"build_cmd": "go build -o bin/app .", "start_cmd": "./bin/app"}

    def sample(self, listen, toolchain=""):
        match = re.match(r"^(1\.\d+)", toolchain or "")
        godir = match.group(1) if match else "1.22"
        return {"go.mod": ("module sample\n\ngo %s\n" % godir, 0o640), "main.go": (SAMPLE_GO, 0o640)}

    def build_deps(self):
        return ["git"]


# --- Rust -----------------------------------------------------------------

class RustRuntime(Runtime):
    key = "rust"
    label = "Rust"
    version_re = RE_RUST_TOOLCHAIN.pattern
    hint = "Installed with rustup (minimal profile). Channels (stable, beta, nightly) can be updated later."
    docs_url = "https://doc.rust-lang.org/cargo/"
    install_help = "Rust needs a C linker: install the build dependencies once."

    def list_installed(self):
        result = []
        for item in installed_rust():
            label = "Rust " + item["name"]
            match = re.search(r"rustc (\S+)", item.get("version") or "")
            if match and match.group(1) != item["name"]:
                label += " (%s)" % match.group(1)
            result.append({"id": item["name"], "label": label, "path": rust_toolchain_dir(item["name"]),
                           "version": item.get("version") or ""})
        return result

    def list_available(self, force=False):
        stable = rust_latest_stable(force)
        available = [
            {"id": "stable", "label": "stable (%s)" % stable if stable else "stable"},
            {"id": "beta", "label": "beta"},
            {"id": "nightly", "label": "nightly"},
        ]
        if stable:
            available.append({"id": stable, "label": stable})
        return available

    def install(self, version, log):
        job_install_rust(version, log)

    def updatable(self, version):
        return version in ("stable", "beta") or version.startswith("nightly")

    def update(self, version, log):
        job_update_rust(version, log)

    def remove(self, version):
        version = self.check_version(version)
        if not os.path.isfile(rustup_bin()):
            raise HelperError("rustup is not installed")
        run([rustup_bin(), "toolchain", "uninstall", version], env=rust_env(), check=True, timeout=600)

    def env(self, home, version, app_dir=None):
        tcdir = rust_toolchain_dir(version)
        cargo_home = os.path.join(home, ".runway", "cargo")
        return {
            "PATH": [tcdir + "/bin", cargo_home + "/bin"],
            "RUSTUP_HOME": RUSTUP_HOME,
            "RUSTUP_TOOLCHAIN": version,
            "CARGO_HOME": cargo_home,
            "RUSTC": tcdir + "/bin/rustc",
            "RUSTDOC": tcdir + "/bin/rustdoc",
        }

    def inspect(self, app_dir):
        cargo = os.path.join(app_dir, "Cargo.toml")
        if not os.path.isfile(cargo):
            return None
        info = _parse_cargo_toml(_read_small(cargo))
        toolchain_file = os.path.join(app_dir, "rust-toolchain.toml")
        if os.path.isfile(toolchain_file):
            channel = re.search(r'channel\s*=\s*"([^"]+)"', _read_small(toolchain_file))
            info["toolchain_file"] = channel.group(1) if channel else True
        return info

    def defaults(self, inspect, listen="tcp", toolchain=""):
        rust = (inspect or {}).get("rust") or {}
        bins = [b for b in rust.get("bins") or [] if isinstance(b, str)]
        paths = rust.get("bin_paths") if isinstance(rust.get("bin_paths"), dict) else {}
        # An explicit [[bin]] for src/main.rs replaces the binary named after the package; a single
        # declared [[bin]] is the application; otherwise cargo names the binary after the package.
        main_bin = next((b for b in bins if paths.get(b) in ("src/main.rs", "./src/main.rs")), None)
        name = main_bin or (bins[0] if len(bins) == 1 else None) or rust.get("package") or (bins or [None])[0]
        binary = name if isinstance(name, str) and re.match(r"^[A-Za-z0-9_-]+$", name) else "app"
        return {"build_cmd": "cargo build --release", "start_cmd": "./target/release/" + binary}

    def sample(self, listen, toolchain=""):
        return {"Cargo.toml": (SAMPLE_CARGO, 0o640), "src/main.rs": (SAMPLE_RUST, 0o640)}

    def build_deps(self):
        return ["cc", "pkg-config"]


# --- Bun ------------------------------------------------------------------

class BunRuntime(Runtime):
    key = "bun"
    label = "Bun"
    version_re = r"^(latest|\d+\.\d+\.\d+)$"
    hint = ("Official oven-sh/bun releases from GitHub, verified with SHASUMS256.txt. "
            "'latest' is a channel that can be updated later.")
    docs_url = "https://bun.sh/docs"
    root = BASE_DIR + "/bun"

    def target(self):
        if machine_arch() == "aarch64":
            return "aarch64"
        flags = cpu_flags()
        if flags and "sse4_2" not in flags:
            raise HelperError("Bun needs a CPU with SSE4.2")
        # The baseline build runs on CPUs without AVX2 (older hosts, some virtual CPUs).
        return "x64" if not flags or "avx2" in flags else "x64-baseline"

    def list_installed(self):
        result = []
        for name in _listdir(self.root):
            path = os.path.join(self.root, name)
            if not re.match(self.version_re, name) or not os.path.isfile(path + "/bin/bun"):
                continue
            label = "Bun " + name
            if name == "latest":
                label = "Bun latest (%s)" % (_read_text(path + "/.version") or "?")
            result.append({"id": name, "label": label, "path": path})
        result.sort(key=lambda item: (item["id"] == "latest", num_key(item["id"])), reverse=True)
        return result

    def releases(self, force=False):
        result = []
        for rel in github_releases("oven-sh/bun", force, per_page=60):
            match = re.match(r"^bun-v(\d+\.\d+\.\d+)$", rel["tag"])
            if not match or rel["prerelease"] or "SHASUMS256.txt" not in rel["assets"] \
                    or "bun-linux-x64.zip" not in rel["assets"]:
                continue
            result.append({"version": match.group(1), "assets": rel["assets"]})
        result.sort(key=lambda r: num_key(r["version"]), reverse=True)
        return result

    def list_available(self, force=False):
        rels = self.releases(force)
        if not rels:
            return []
        return [{"id": "latest", "label": "latest (channel, currently %s)" % rels[0]["version"]}] + \
            [{"id": r["version"], "label": "Bun " + r["version"]} for r in rels[:10]]

    def install(self, version, log, replace=False):
        version = self.check_version(version)
        target_dir = os.path.join(self.root, version)
        if os.path.isfile(target_dir + "/bin/bun") and not replace:
            log.line("Bun %s is already installed." % version)
            return
        rels = self.releases(force=True)
        rel = (rels[0] if rels else None) if version == "latest" else \
            next((r for r in rels if r["version"] == version), None)
        if not rel:
            raise HelperError("Bun %s was not found in the release list" % version)
        target = self.target()
        asset = "bun-linux-%s.zip" % target
        if asset not in rel["assets"]:
            raise HelperError("Bun %s has no %s build" % (rel["version"], target))
        ensure_dir(self.root)
        # Not /tmp: it may be mounted noexec, and the binary is executed for verification.
        work = tempfile.mkdtemp(prefix=".tmp-", dir=self.root)
        try:
            sums = parse_shasums(http_get(https_url(rel["assets"]["SHASUMS256.txt"]["url"])).decode("utf-8", "replace"))
            sha = sums.get(asset) or rel["assets"][asset].get("sha256")
            if not sha:
                raise HelperError("No published checksum for %s" % asset)
            archive = download(https_url(rel["assets"][asset]["url"]), os.path.join(work, asset), sha, log)
            stage = os.path.join(work, "stage")
            os.makedirs(stage + "/bin", 0o755)
            member = "bun-linux-%s/bun" % target
            with zipfile.ZipFile(archive) as zf:
                if member not in zf.namelist():
                    raise HelperError("Unexpected archive layout (no %s)" % member)
                with zf.open(member) as src, open(stage + "/bin/bun", "wb") as dst:
                    shutil.copyfileobj(src, dst, 1024 * 1024)
            os.chmod(stage + "/bin/bun", 0o755)  # zipfile does not restore Unix modes
            os.symlink("bun", stage + "/bin/bunx")
            write_text(stage + "/.target", target + "\n")
            if version == "latest":
                write_text(stage + "/.version", rel["version"] + "\n")
            chmod_public(stage)
            proc = run([stage + "/bin/bun", "--version"], timeout=60,
                       env=root_env({"BUN_INSTALL": work + "/home", "DO_NOT_TRACK": "1"}))
            if proc.returncode != 0 or proc.stdout.strip() != rel["version"]:
                raise HelperError("bun --version failed: %s" % (proc.stderr or proc.stdout).strip()[-500:])
            log.line("bun --version: %s (%s build)" % (proc.stdout.strip(), target))
            swap_dir(stage, target_dir, work)
        finally:
            shutil.rmtree(work, ignore_errors=True)
        log.line("Bun %s installed to %s" % (version, target_dir))

    def updatable(self, version):
        return version == "latest"

    def update(self, version, log):
        if not self.updatable(version):
            Runtime.update(self, version, log)
        self.install(version, log, replace=True)

    def remove(self, version):
        self._remove_dir(self.root, self.check_version(version))

    def env(self, home, version, app_dir=None):
        rw = os.path.join(home, ".runway", "bun")
        return {
            "PATH": [os.path.join(self.root, version, "bin"), rw + "/bin"],
            "BUN_INSTALL": rw,
            "BUN_INSTALL_CACHE_DIR": rw + "/cache",
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": rw + "/transpiler-cache",
            "DO_NOT_TRACK": "1",
            "NO_COLOR": "1",
        }

    def inspect(self, app_dir):
        entry = (_files(app_dir, "index.ts", "index.js", "server.ts", "server.js", "src/index.ts", "src/index.js")
                 or [None])[0]
        if not os.path.isfile(os.path.join(app_dir, "package.json")):
            return {"package": False, "entry": entry} if entry else None
        pkg = _json_file(os.path.join(app_dir, "package.json"))
        scripts = pkg.get("scripts") if isinstance(pkg.get("scripts"), dict) else {}
        main = _safe_rel(pkg.get("module")) or _safe_rel(pkg.get("main"))
        return {
            "package": True,
            "name": str(pkg.get("name") or "")[:100],
            "start_script": isinstance(scripts.get("start"), str),
            "build_script": isinstance(scripts.get("build"), str),
            "lockfile": (_files(app_dir, "bun.lock", "bun.lockb") or [None])[0],
            "entry": main if main and os.path.isfile(os.path.join(app_dir, main)) else entry,
        }

    def defaults(self, inspect, listen="tcp", toolchain=""):
        info = (inspect or {}).get("bun") or {}
        build = ""
        if info.get("package"):
            build = "bun install --frozen-lockfile" if info.get("lockfile") else "bun install"
            if info.get("build_script"):
                build += " && bun run build"
        start = "bun run start" if info.get("start_script") else "bun run " + (_safe_rel(info.get("entry")) or "index.ts")
        return {"build_cmd": build, "start_cmd": start}

    def sample(self, listen, toolchain=""):
        return {"package.json": (SAMPLE_BUN_PACKAGE, 0o640), "index.ts": (SAMPLE_BUN, 0o640)}

    def build_deps(self):
        return ["git"]


# --- Java (Eclipse Temurin) -------------------------------------------------

class JavaRuntime(Runtime):
    key = "java"
    label = "Java"
    version_re = r"^\d{1,2}(\.\d+){0,5}(\+\d+)?$"
    hint = ("Eclipse Temurin JDK builds from the Adoptium API, verified with SHA-256. "
            "Install a major (17, 21, 25) to get its latest build.")
    docs_url = "https://adoptium.net/docs/"
    root = BASE_DIR + "/java"
    api = "https://api.adoptium.net/v3"

    def arch(self):
        return "x64" if machine_arch() == "x86_64" else "aarch64"

    def latest_build(self, major, lts):
        query = urllib.parse.urlencode({"os": "linux", "architecture": self.arch(), "image_type": "jdk",
                                        "vendor": "eclipse"})
        assets = http_json("%s/assets/latest/%d/hotspot?%s" % (self.api, major, query))
        if not isinstance(assets, list) or not assets:
            return None
        asset = assets[0]
        package = asset["binary"]["package"]
        release = str(asset.get("release_name") or "")
        build_id = release[4:] if release.startswith("jdk-") else release
        if not re.match(self.version_re, build_id) or not re.match(r"^[0-9a-fA-F]{64}$", package.get("checksum") or ""):
            return None
        return {"id": build_id, "major": major, "lts": lts or (asset.get("version") or {}).get("optional") == "LTS",
                "release_name": release, "url": https_url(package.get("link")),
                "sha256": package["checksum"].lower(), "size": package.get("size")}

    def builds(self, force=False):
        def fetch():
            info = http_json(self.api + "/info/available_releases")
            lts = [m for m in info.get("available_lts_releases") or [] if isinstance(m, int)]
            majors = set(m for m in lts if m >= 17)
            if isinstance(info.get("most_recent_feature_release"), int):
                majors.add(info["most_recent_feature_release"])
            result = []
            for major in sorted(majors, reverse=True):
                build = self.latest_build(major, major in lts)
                if build:
                    result.append(build)
            return result
        return cached_json("java-temurin", force, fetch)

    def list_available(self, force=False):
        return [{"id": b["id"], "label": "Temurin %s%s" % (b["id"], " (LTS)" if b["lts"] else "")}
                for b in self.builds(force)]

    def list_installed(self):
        result = []
        for name in _listdir(self.root):
            path = os.path.join(self.root, name)
            if not re.match(self.version_re, name) or not os.path.isfile(path + "/bin/java"):
                continue
            release = _read_text(path + "/release")
            lts = "-LTS" in release
            result.append({"id": name, "label": "Temurin %s%s" % (name, " (LTS)" if lts else ""), "path": path})
        result.sort(key=lambda item: java_key(item["id"]), reverse=True)
        return result

    def resolve(self, version):
        if re.match(r"^\d{1,2}$", version or ""):
            for item in self.list_installed():
                if self.may_use(version, item["id"]):
                    return item["id"]
        return version

    def may_use(self, configured, build):
        return bool(re.match(r"^\d{1,2}$", configured or "")) and bool(re.match(r"^%s([.+]|$)" % configured, build or ""))

    def install(self, version, log):
        version = self.check_version(version)
        builds = self.builds(force=True)
        if re.match(r"^\d{1,2}$", version):
            build = next((b for b in builds if str(b["major"]) == version), None) or \
                self.latest_build(int(version), False)
        else:
            build = next((b for b in builds if b["id"] == version), None)
        if not build:
            raise HelperError("Temurin %s is not available (only the latest build of a major can be installed)" % version)
        target = os.path.join(self.root, build["id"])
        if os.path.isfile(target + "/bin/java"):
            log.line("Temurin %s is already installed." % build["id"])
            return
        ensure_dir(self.root)
        work = tempfile.mkdtemp(prefix=".tmp-", dir=self.root)
        try:
            archive = download(build["url"], os.path.join(work, "jdk.tar.gz"), build["sha256"], log)
            log.line("Extracting archive")
            stage = os.path.join(work, "x")
            os.mkdir(stage, 0o755)
            safe_extract(archive, stage)
            tops = [d for d in os.listdir(stage) if os.path.isdir(os.path.join(stage, d))]
            if len(tops) != 1 or not os.path.isfile(os.path.join(stage, tops[0], "bin", "java")):
                raise HelperError("Unexpected archive layout")
            top = os.path.join(stage, tops[0])
            chmod_public(top)
            proc = run([top + "/bin/java", "-version"], timeout=60)
            log.line((proc.stderr or proc.stdout).strip())
            if proc.returncode != 0:
                raise HelperError("java -version failed")
            swap_dir(top, target, work)
        finally:
            shutil.rmtree(work, ignore_errors=True)
        log.line("Temurin %s installed to %s" % (build["id"], target))

    def remove(self, version):
        self._remove_dir(self.root, self.resolve(self.check_version(version)))

    def env(self, home, version, app_dir=None):
        java_home = os.path.join(self.root, self.resolve(version))
        rw = os.path.join(home, ".runway", "java")
        return {
            "PATH": [java_home + "/bin"],
            "JAVA_HOME": java_home,
            "MAVEN_USER_HOME": rw + "/maven",
            "MAVEN_OPTS": "-Dmaven.repo.local=" + rw + "/m2/repository",
            "GRADLE_USER_HOME": rw + "/gradle",
        }

    def listen_env(self, state):
        if state.get("listen") == "unix":
            return {}
        # Spring Boot and Quarkus bind 0.0.0.0 and their own default ports otherwise.
        port = str(state["port"])
        return {"SERVER_PORT": port, "SERVER_ADDRESS": "127.0.0.1",
                "QUARKUS_HTTP_PORT": port, "QUARKUS_HTTP_HOST": "127.0.0.1"}

    def inspect(self, app_dir):
        found = _files(app_dir, "pom.xml", "build.gradle", "build.gradle.kts", "mvnw", "gradlew")
        top = sorted(_scan_names(app_dir, 500)[0])
        jars = []
        for sub in ("target", "build/libs", "."):
            folder = os.path.join(app_dir, sub)
            if os.path.islink(folder) or not os.path.isdir(folder):
                continue
            for name in (top if sub == "." else sorted(_scan_names(folder, 500)[0])):
                if name.endswith(".jar") and not name.startswith("original-") and not re.search(
                        r"-(plain|sources|javadoc|tests)\.jar$", name):
                    rel = name if sub == "." else sub + "/" + name
                    if RE_REL_PATH.match(rel):
                        jars.append(rel)
        main_java, main_class = self.find_main(app_dir, top)
        if not found and not jars and not main_java:
            return None
        info = {"maven": "pom.xml" in found, "gradle": "build.gradle" in found or "build.gradle.kts" in found,
                "mvnw": "mvnw" in found, "gradlew": "gradlew" in found, "main_java": main_java,
                "main_class": main_class, "jars": jars[:20], "artifact": None}
        if info["maven"]:
            text = _read_small(os.path.join(app_dir, "pom.xml"))
            final = re.search(r"<finalName>\s*([A-Za-z0-9_.-]+)\s*</finalName>", text)
            own = re.sub(r"<(parent|dependencies|dependencyManagement|build|profiles|modules)>.*?</\1>", "", text, flags=re.S)
            artifact = re.search(r"<artifactId>\s*([A-Za-z0-9_.-]+)\s*</artifactId>", own)
            version = re.search(r"<version>\s*([A-Za-z0-9_.+-]+)\s*</version>", own)
            if final:
                info["artifact"] = final.group(1)
            elif artifact:
                info["artifact"] = artifact.group(1) + ("-" + version.group(1) if version else "")
        return info

    def find_main(self, app_dir, names):
        """As the user: the top-level .java source with a "static void main" (Main.java and App.java
        first, at most 20 files read) and its class name (with the package): (file, class) or (None, None)."""
        sources = [n for n in names if re.match(r"^[A-Za-z_$][A-Za-z0-9_$]*\.java$", n)]
        sources.sort(key=lambda n: (n not in ("Main.java", "App.java"), n))
        for name in sources[:20]:
            try:
                text = _read_small(os.path.join(app_dir, name), 262144)
            except (HelperError, OSError):
                continue
            if re.search(r"\bstatic\s+void\s+main\s*\(", text):
                package = re.search(r"^\s*package\s+([A-Za-z_][\w.]*)\s*;", text, re.M)
                return name, (package.group(1) + "." if package else "") + name[:-len(".java")]
        return None, None

    def defaults(self, inspect, listen="tcp", toolchain=""):
        info = (inspect or {}).get("java") or {}
        build = ""
        if info.get("mvnw"):
            build = "sh ./mvnw -q -B -DskipTests package"
        elif info.get("gradlew"):
            build = "sh ./gradlew build -x test --no-daemon"
        elif info.get("main_java") and not info.get("maven") and not info.get("gradle") \
                and re.match(r"^[A-Za-z_$][\w$.]*$", str(info.get("main_class") or "")) \
                and re.match(r"^[A-Za-z_$][\w$]*\.java$", str(info.get("main_java"))):
            return {"build_cmd": "javac -d build " + info["main_java"],
                    "start_cmd": "java -XX:MaxRAMPercentage=75 -cp build " + info["main_class"]}
        jars = [j for j in info.get("jars") or [] if j.startswith(("target/", "build/libs/"))] or info.get("jars") or []
        if jars:
            jar = jars[0]
        elif info.get("artifact"):
            jar = "target/%s.jar" % info["artifact"]
        elif info.get("gradle"):
            jar = "build/libs/app.jar"
        else:
            jar = "app.jar"
        # The JVM sizes its heap from the service's memory limit (MemoryMax); the default of 25 %
        # is too small for typical web frameworks (docs/runtimes/java.md).
        return {"build_cmd": build, "start_cmd": "java -XX:MaxRAMPercentage=75 -jar " + jar}

    def sample(self, listen, toolchain=""):
        return {"Main.java": (SAMPLE_JAVA, 0o640)}

    def build_deps(self):
        return ["git", "unzip"]


# --- .NET -------------------------------------------------------------------

class DotnetRuntime(Runtime):
    key = "dotnet"
    label = ".NET"
    version_re = r"^\d+\.\d+(\.\d{3})?$"
    hint = ("Official .NET SDKs from Microsoft's release metadata, verified with SHA-512. All SDKs share "
            "/opt/runway/dotnet; a global.json in the project selects a specific SDK.")
    docs_url = "https://learn.microsoft.com/dotnet/core/"
    root = BASE_DIR + "/dotnet"
    meta_url = "https://builds.dotnet.microsoft.com/dotnet/release-metadata/"
    shared_files = ("dotnet", "dnx", "LICENSE.txt", "ThirdPartyNotices.txt")

    def rid(self):
        return "linux-x64" if machine_arch() == "x86_64" else "linux-arm64"

    def manifest_path(self, sdk):
        return os.path.join(self.root, ".runway", "installed", sdk + ".json")

    def channels(self, force=False):
        def fetch():
            index = http_json(self.meta_url + "releases-index.json").get("releases-index") or []
            result = []
            for channel in index:
                version = str(channel.get("channel-version") or "")
                sdk = str(channel.get("latest-sdk") or "")
                if channel.get("support-phase") not in ("active", "maintenance", "go-live") \
                        or not re.match(r"^\d+\.\d+$", version) or int(version.split(".")[0]) < 8 \
                        or not re.match(r"^\d+\.\d+\.\d{3}$", sdk):
                    continue
                result.append({"channel": version, "sdk": sdk, "type": str(channel.get("release-type") or "").upper(),
                               "eol": channel.get("eol-date")})
            return result
        return cached_json("dotnet-channels", force, fetch)

    def list_available(self, force=False):
        return [{"id": c["sdk"], "label": ".NET %s (%s) SDK %s" % (c["channel"], c["type"], c["sdk"])}
                for c in self.channels(force)]

    def sdk_versions(self):
        return sorted([n for n in _listdir(self.root + "/sdk") if re.match(r"^\d+\.\d+\.\d{3}$", n)],
                      key=num_key, reverse=True)

    def list_installed(self):
        return [{"id": v, "label": ".NET SDK " + v, "path": os.path.join(self.root, "sdk", v)}
                for v in self.sdk_versions()]

    def resolve(self, version):
        if re.match(r"^\d+\.\d+$", version or ""):
            match = [v for v in self.sdk_versions() if v.startswith(version + ".")]
            if match:
                return match[0]
        return version

    def may_use(self, configured, build):
        return bool(re.match(r"^\d+\.\d+$", configured or "")) and (build or "").startswith(configured + ".")

    def install(self, version, log):
        version = self.check_version(version)
        if re.match(r"^\d+\.\d+$", version):
            channel = next((c for c in self.channels(force=True) if c["channel"] == version), None)
            if not channel:
                raise HelperError(".NET channel %s is not supported" % version)
            sdk = channel["sdk"]
        else:
            sdk = version
        channel_version = ".".join(sdk.split(".")[:2])
        if os.path.isdir(os.path.join(self.root, "sdk", sdk)):
            log.line(".NET SDK %s is already installed." % sdk)
            return
        data = http_json("%s%s/releases.json" % (self.meta_url, channel_version))
        url = sha512 = None
        for rel in data.get("releases") or []:
            for entry in [rel.get("sdk")] + list(rel.get("sdks") or []):
                if not isinstance(entry, dict) or entry.get("version") != sdk:
                    continue
                for item in entry.get("files") or []:
                    if item.get("rid") == self.rid() and str(item.get("name") or "").endswith(".tar.gz"):
                        url, sha512 = item.get("url"), str(item.get("hash") or "").lower()
        if not url or not re.match(r"^[0-9a-f]{128}$", sha512 or ""):
            raise HelperError(".NET SDK %s was not found for %s" % (sdk, self.rid()))
        ensure_dir(self.root)
        work = tempfile.mkdtemp(prefix=".tmp-", dir=self.root)
        try:
            archive = download(https_url(url), os.path.join(work, "sdk.tar.gz"), sha512, log, algo="sha512")
            newer = [v for v in self.sdk_versions() if num_key(v) > num_key(sdk)]
            # The muxer is backward compatible: never replace a newer one with an older one.
            skip = set(["dotnet", "dnx"]) if newer and os.path.isfile(self.root + "/dotnet") else None
            log.line("Extracting archive")
            stage = os.path.join(work, "x")
            os.mkdir(stage, 0o755)
            members = safe_extract(archive, stage, skip=skip)
            chmod_public(stage)
            files = []
            for name in sorted(members):
                src, dst = os.path.join(stage, name), os.path.join(self.root, name)
                if os.path.isdir(src) and not os.path.islink(src):
                    ensure_dir(dst)
                    continue
                files.append(name)
                if os.path.lexists(dst) and "/" in name:
                    continue  # versioned content shared with another SDK of the same runtime
                ensure_dir(os.path.dirname(dst))
                os.rename(src, dst)  # rename: running processes keep the old inode
            ensure_dir(os.path.dirname(self.manifest_path(sdk)), 0o755)
            write_json(self.manifest_path(sdk), {"sdk": sdk, "members": files}, mode=0o644)
            os.chmod(self.root, 0o755)
            proc = run([self.root + "/dotnet", "--list-sdks"], timeout=120, env=root_env({
                "DOTNET_ROOT": self.root, "DOTNET_CLI_HOME": CACHE_DIR + "/dotnet-cli",
                "DOTNET_CLI_TELEMETRY_OPTOUT": "1", "DOTNET_NOLOGO": "1"}))
            log.line(proc.stdout.strip() or proc.stderr.strip())
            if sdk not in proc.stdout:
                raise HelperError("dotnet --list-sdks does not show %s" % sdk)
        finally:
            shutil.rmtree(work, ignore_errors=True)
        log.line(".NET SDK %s installed to %s" % (sdk, self.root))

    def remove(self, version):
        sdk = self.resolve(self.check_version(version))
        installed = self.sdk_versions()
        if sdk not in installed:
            raise HelperError(".NET SDK %s is not installed" % sdk)
        others = [v for v in installed if v != sdk]
        if not others:
            shutil.rmtree(self.root)
            return
        manifest = read_json(self.manifest_path(sdk))
        if isinstance(manifest, dict):
            claimed = set(self.shared_files)
            for other in others:
                data = read_json(self.manifest_path(other))
                claimed.update(data.get("members") or [] if isinstance(data, dict) else [])
            parents = set()
            for name in manifest.get("members") or []:
                if not isinstance(name, str) or name in claimed or name.startswith("/") or ".." in name.split("/"):
                    continue
                path = os.path.join(self.root, name)
                if os.path.islink(path) or os.path.isfile(path):
                    os.unlink(path)
                    parent = os.path.dirname(name)
                    while parent:
                        parents.add(parent)
                        parent = os.path.dirname(parent)
            for parent in sorted(parents, key=len, reverse=True):
                try:
                    os.rmdir(os.path.join(self.root, parent))
                except OSError:
                    pass
        shutil.rmtree(os.path.join(self.root, "sdk", sdk), ignore_errors=True)
        remove_quietly(self.manifest_path(sdk))

    def env(self, home, version, app_dir=None):
        rw = os.path.join(home, ".runway", "dotnet")
        return {
            "PATH": [self.root, rw + "/tools"],
            "DOTNET_ROOT": self.root,
            "DOTNET_CLI_HOME": rw,
            "NUGET_PACKAGES": rw + "/nuget/packages",
            "NUGET_HTTP_CACHE_PATH": rw + "/nuget/http-cache",
            "NUGET_PLUGINS_CACHE_PATH": rw + "/nuget/plugins-cache",
            "DOTNET_BUNDLE_EXTRACT_BASE_DIR": rw + "/bundle",
            "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
            "DOTNET_NOLOGO": "1",
            "DOTNET_GENERATE_ASPNET_CERTIFICATE": "false",
            "DOTNET_ADD_GLOBAL_TOOLS_TO_PATH": "0",
            "DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE": "1",
            "MSBUILDDISABLENODEREUSE": "1",
            "DOTNET_CLI_UI_LANGUAGE": "en",
        }

    def listen_env(self, state):
        if state.get("listen") == "unix":
            return {"ASPNETCORE_URLS": "http://unix:" + socket_path(state["domain_id"])}
        return {"ASPNETCORE_URLS": "http://127.0.0.1:%d" % int(state["port"])}

    def inspect(self, app_dir):
        names = sorted(_scan_names(app_dir, 2000)[0])
        projects = [n for n in names if n.endswith((".csproj", ".fsproj", ".vbproj")) and RE_REL_PATH.match(n)]
        solutions = [n for n in names if n.endswith((".sln", ".slnx"))]
        prebuilt = []
        for folder in ("publish", "."):
            if folder == "publish" and os.path.islink(os.path.join(app_dir, folder)):
                continue
            for n in (names if folder == "." else _scan_names(os.path.join(app_dir, folder), 2000)[0]):
                if n.endswith(".runtimeconfig.json") and RE_REL_PATH.match(n):
                    prebuilt.append(n[:-len(".runtimeconfig.json")] if folder == "." else "publish/" + n[:-len(".runtimeconfig.json")])
        if not projects and not solutions and not prebuilt:
            return None
        info = {"projects": projects[:20], "solutions": solutions[:20], "prebuilt": sorted(prebuilt)[:20],
                "project": projects[0] if len(projects) == 1 else None, "assembly_name": None,
                "target_framework": None, "self_contained": False}
        if info["project"]:
            text = _read_small(os.path.join(app_dir, info["project"]))
            name = re.search(r"<AssemblyName>\s*([A-Za-z0-9_.-]+)\s*</AssemblyName>", text)
            framework = re.search(r"<TargetFrameworks?>\s*([A-Za-z0-9_.;-]+)\s*</TargetFrameworks?>", text)
            info["assembly_name"] = name.group(1) if name else re.sub(r"\.[a-z]+proj$", "", info["project"])
            info["target_framework"] = framework.group(1) if framework else None
            info["self_contained"] = bool(re.search(r"<SelfContained>\s*true\s*</SelfContained>", text, re.I))
        return info

    def defaults(self, inspect, listen="tcp", toolchain=""):
        info = (inspect or {}).get("dotnet") or {}
        project, name = info.get("project"), info.get("assembly_name")
        if project:
            build = "dotnet publish %s -c Release -o publish --nologo" % project
        elif info.get("prebuilt"):
            build = ""
            name = name or info["prebuilt"][0].replace("publish/", "")
        elif info.get("solutions"):
            build = ""
        else:
            build = "dotnet publish -c Release -o publish --nologo"
        if not name or not re.match(r"^[A-Za-z0-9_.-]+$", name):
            start = ""
        elif info.get("self_contained"):
            start = "./publish/" + name
        elif project or (info.get("prebuilt") or [""])[0].startswith("publish/"):
            start = "dotnet publish/%s.dll" % name
        else:
            start = "dotnet %s.dll" % name
        return {"build_cmd": build, "start_cmd": start}

    def sample(self, listen, toolchain=""):
        sdk = self.resolve(toolchain) if toolchain else (self.sdk_versions() or [""])[0]
        match = re.match(r"^(\d+)\.", sdk or "")
        framework = "net%s.0" % (match.group(1) if match else "10")
        return {"app.csproj": (SAMPLE_DOTNET_PROJECT % framework, 0o640),
                "Program.cs": (SAMPLE_DOTNET, 0o640)}

    def build_deps(self):
        return ["git"]


# --- Python (uv-managed CPython) ---------------------------------------------

class PythonRuntime(Runtime):
    key = "python"
    label = "Python"
    version_re = r"^3\.\d{1,2}(\.\d{1,2})?$"
    hint = ("CPython builds installed with uv (astral-sh/uv from GitHub, verified with SHA-256). "
            "Apps use a .venv in the application root.")
    docs_url = "https://docs.astral.sh/uv/"
    root = BASE_DIR + "/python"
    uv_dir = BASE_DIR + "/uv"
    uv = uv_dir + "/uv"

    def dir_for(self, version):
        return "%s/cpython-%s-linux-%s-gnu" % (self.root, version, machine_arch())

    def uv_env(self):
        return root_env({"UV_PYTHON_INSTALL_DIR": self.root, "UV_CACHE_DIR": CACHE_DIR + "/uv",
                         "UV_NO_PROGRESS": "1", "UV_PYTHON_BIN_DIR": self.root + "/bin"})

    def list_installed(self):
        pattern = re.compile(r"^cpython-(3\.\d+\.\d+)-linux-%s-gnu$" % re.escape(machine_arch()))
        result = []
        for name in _listdir(self.root):
            match = pattern.match(name)
            path = os.path.join(self.root, name)
            if match and not os.path.islink(path) and os.path.isfile(path + "/bin/python3"):
                result.append({"id": match.group(1), "label": "Python " + match.group(1), "path": path})
        result.sort(key=lambda item: num_key(item["id"]), reverse=True)
        return result

    def resolve(self, version):
        if re.match(r"^3\.\d+$", version or ""):
            for item in self.list_installed():
                if item["id"].startswith(version + "."):
                    return item["id"]
        return version

    def may_use(self, configured, build):
        return bool(re.match(r"^3\.\d+$", configured or "")) and (build or "").startswith(configured + ".")

    def ensure_uv(self, log, update=False):
        if os.path.isfile(self.uv) and not update:
            return
        rels = [r for r in github_releases("astral-sh/uv", True, per_page=10)
                if not r["prerelease"] and re.match(r"^\d+\.\d+\.\d+$", r["tag"])]
        rels.sort(key=lambda r: num_key(r["tag"]), reverse=True)
        asset = "uv-%s-unknown-linux-gnu.tar.gz" % machine_arch()
        rel = next((r for r in rels if asset in r["assets"]), None)
        if not rel:
            raise HelperError("No uv release with %s found" % asset)
        sha = rel["assets"][asset].get("sha256")
        if not sha and asset + ".sha256" in rel["assets"]:
            sha = (http_get(https_url(rel["assets"][asset + ".sha256"]["url"])).decode("utf-8", "replace").split() or [""])[0]
        if not re.match(r"^[0-9a-fA-F]{64}$", sha or ""):
            raise HelperError("No published checksum for %s" % asset)
        ensure_dir(self.uv_dir)
        work = tempfile.mkdtemp(prefix=".tmp-", dir=self.uv_dir)
        try:
            archive = download(https_url(rel["assets"][asset]["url"]), os.path.join(work, asset), sha, log)
            stage = os.path.join(work, "x")
            os.mkdir(stage, 0o755)
            safe_extract(archive, stage)
            binary = os.path.join(stage, asset[:-len(".tar.gz")], "uv")
            if not os.path.isfile(binary) or os.path.islink(binary):
                raise HelperError("Unexpected uv archive layout")
            os.chown(binary, 0, 0)
            os.chmod(binary, 0o755)
            proc = run([binary, "--version"], env=self.uv_env(), timeout=60)
            if proc.returncode != 0:
                raise HelperError("uv --version failed: %s" % proc.stderr.strip()[-300:])
            os.rename(binary, self.uv)
            log.line("Installed %s to %s" % (proc.stdout.strip(), self.uv))
        finally:
            shutil.rmtree(work, ignore_errors=True)

    def list_available(self, force=False):
        if not os.path.isfile(self.uv):
            return [{"id": minor, "label": "Python %s (newest patch; uv is installed first)" % minor}
                    for minor in ("3.14", "3.13", "3.12", "3.11", "3.10")]
        proc = run([self.uv, "python", "list", "--only-downloads", "--output-format", "json"],
                   env=self.uv_env(), timeout=60)
        if proc.returncode != 0:
            raise HelperError("uv python list failed: %s" % proc.stderr.strip()[-300:])
        result = []
        for item in json.loads(proc.stdout or "[]"):
            version = str(item.get("version") or "")
            if item.get("implementation") != "cpython" or item.get("variant") != "default" \
                    or item.get("os") != "linux" or item.get("libc") != "gnu" or item.get("arch") != machine_arch() \
                    or not re.match(r"^3\.\d+\.\d+$", version) or num_key(version)[1] < 9:
                continue
            result.append({"id": version, "label": "Python " + version})
        result.sort(key=lambda item: num_key(item["id"]), reverse=True)
        return result

    def install(self, version, log):
        version = self.check_version(version)
        self.ensure_uv(log)
        log.line("Installing Python %s with uv" % version)
        code = stream_process([self.uv, "python", "install", version, "--no-bin"], log, 1800, self.uv_env(), cwd="/")
        if code != 0:
            raise HelperError("uv python install failed with exit code %d" % code)
        chmod_public(self.root)
        exact = self.resolve(version)
        python = self.dir_for(exact) + "/bin/python3"
        if not os.path.isfile(python):
            raise HelperError("Python %s was not found in %s after the installation" % (version, self.root))
        proc = run([python, "--version"], timeout=60)
        log.line("%s (%s)" % ((proc.stdout or proc.stderr).strip(), python))

    def updatable(self, version):
        return bool(re.match(self.version_re, version or ""))

    def update(self, version, log):
        """Updates uv (which brings new patch releases), then installs the newest patch of the minor."""
        self.ensure_uv(log, update=True)
        self.install(".".join(self.check_version(version).split(".")[:2]), log)

    def remove(self, version):
        version = self.resolve(self.check_version(version))
        if version.count(".") != 2:
            raise HelperError("Python %s is not installed" % version)
        self._remove_dir(self.root, os.path.basename(self.dir_for(version)))
        # Virtual environments reference the minor-version link: re-point it or drop it.
        minor = ".".join(version.split(".")[:2])
        link = self.dir_for(minor)
        if os.path.islink(link):
            remaining = [i["id"] for i in self.list_installed() if i["id"].startswith(minor + ".")]
            remove_quietly(link + ".tmp")
            if remaining:
                os.symlink(self.dir_for(remaining[0]), link + ".tmp")
                os.rename(link + ".tmp", link)
            else:
                os.unlink(link)

    def env(self, home, version, app_dir=None):
        pydir = self.dir_for(self.resolve(version))
        rw = os.path.join(home, ".runway")
        env = {
            "PATH": [pydir + "/bin", self.uv_dir],
            "UV_PYTHON_INSTALL_DIR": self.root,
            "UV_PYTHON": pydir + "/bin/python3",
            "UV_PYTHON_PREFERENCE": "only-managed",
            "UV_PYTHON_DOWNLOADS": "never",
            "UV_CACHE_DIR": rw + "/uv",
            "UV_TOOL_DIR": rw + "/uv/tools",
            "UV_TOOL_BIN_DIR": rw + "/uv/bin",
            "UV_PYTHON_BIN_DIR": rw + "/uv/bin",
            "UV_LINK_MODE": "copy",
            "UV_NO_PROGRESS": "1",
            "UV_HTTP_TIMEOUT": "120",
            "PIP_CACHE_DIR": rw + "/pip",
            "PIP_DISABLE_PIP_VERSION_CHECK": "1",
            "PYTHONUNBUFFERED": "1",
        }
        if app_dir:
            env["VIRTUAL_ENV"] = app_dir + "/.venv"
            env["PATH"].insert(0, app_dir + "/.venv/bin")
        return env

    def inspect(self, app_dir):
        found = _files(app_dir, "pyproject.toml", "requirements.txt", "uv.lock", "manage.py", "Procfile",
                       ".python-version", "main.py", "app.py", "api.py", "asgi.py", "wsgi.py", "app/main.py")
        if not found:
            return None
        info = {"pyproject": "pyproject.toml" in found, "requirements": "requirements.txt" in found,
                "uv_lock": "uv.lock" in found, "python_version": None, "app": None, "kind": None,
                "django": None, "script": None}
        if ".python-version" in found:
            match = re.match(r"^\s*(3\.\d+(\.\d+)?)", _read_small(os.path.join(app_dir, ".python-version"), 256))
            info["python_version"] = match.group(1) if match else None
        if "manage.py" in found:
            match = re.search(r"DJANGO_SETTINGS_MODULE['\"],\s*['\"]([\w.]+)['\"]",
                              _read_small(os.path.join(app_dir, "manage.py"), 65536))
            package = match.group(1).split(".")[0] if match else None
            if package and os.path.isfile(os.path.join(app_dir, package, "wsgi.py")):
                info["django"] = package
        for name in ("main.py", "app.py", "api.py", "asgi.py", "wsgi.py", "app/main.py"):
            if name not in found:
                continue
            text = _read_small(os.path.join(app_dir, name), 65536)
            match = re.search(r"^\s*(app|api|application)\s*=\s*(FastAPI|Starlette|Quart|Flask)\(", text, re.M)
            if match:
                info["app"] = "%s:%s" % (name[:-3].replace("/", "."), match.group(1))
                info["kind"] = "wsgi" if match.group(2) == "Flask" else "asgi"
                break
            if not info["script"] and "__main__" in text:
                info["script"] = name
        return info

    def defaults(self, inspect, listen="tcp", toolchain=""):
        info = (inspect or {}).get("python") or {}
        if info.get("uv_lock"):
            build = "uv sync --frozen --no-dev"
        elif info.get("pyproject"):
            build = "uv sync --no-dev"
        elif info.get("requirements"):
            build = "uv venv --allow-existing .venv && uv pip install -r requirements.txt"
        else:
            build = "uv venv --allow-existing .venv"
        unix = listen == "unix"
        gunicorn_bind = "--bind unix:$RUNWAY_SOCKET --umask 0117" if unix else "--bind $HOST:$PORT"
        if info.get("django"):
            start = ".venv/bin/gunicorn %s.wsgi:application %s" % (info["django"], gunicorn_bind)
        elif info.get("app") and info.get("kind") == "asgi":
            start = ".venv/bin/uvicorn %s %s" % (info["app"], "--uds $RUNWAY_SOCKET --forwarded-allow-ips '*'"
                                                 if unix else "--host $HOST --port $PORT")
        elif info.get("app"):
            start = ".venv/bin/gunicorn %s %s" % (info["app"], gunicorn_bind)
        else:
            start = ".venv/bin/python " + (info.get("script") or "app.py")
        return {"build_cmd": build, "start_cmd": start}

    def sample(self, listen, toolchain=""):
        return {"app.py": ("#!/usr/bin/env python3\n" + SAMPLE_PYTHON, 0o640)}

    def build_deps(self):
        return ["cc", "make", "pkg-config"]


# --- Ruby (detected) ----------------------------------------------------------

class RubyRuntime(Runtime):
    key = "ruby"
    label = "Ruby"
    toolchain = "detected"
    version_re = r"^(system|\d+\.\d+\.\d+)$"
    hint = "Uses the Ruby versions of the Plesk Ruby extension (/opt/plesk/ruby) or the system Ruby."
    install_help = ("Runway uses the Ruby versions already on the server. Install them with the Plesk Ruby "
                    "extension (plesk bin extension --install ruby) or the distribution packages (apt-get install "
                    "ruby-full ruby-dev / dnf install ruby ruby-devel). Native gems also need the build dependencies.")
    docs_url = "https://www.ruby-lang.org/en/documentation/"
    # The defaults of the system Ruby depend on whether Bundler is available (see system_bundle()).
    defaults_per_toolchain = True
    _installed = None
    wrapper_dir = BASE_DIR + "/ruby/system/bin"

    def prefix(self, version):
        return "/usr" if version == "system" else "/opt/plesk/ruby/" + version

    def system_bundle(self):
        """The Bundler executable of the system Ruby: /usr/bin/bundle, or the versioned
        /usr/bin/bundle<X.Y> that Debian and Ubuntu ship without the ruby-bundler package."""
        if os.path.isfile("/usr/bin/bundle"):
            return "/usr/bin/bundle"
        try:
            match = re.search(r"ruby (\d+\.\d+)", run(["/usr/bin/ruby", "--version"], timeout=10).stdout)
        except HelperError:
            match = None
        if match and os.path.isfile("/usr/bin/bundle" + match.group(1)):
            return "/usr/bin/bundle" + match.group(1)
        return None

    def ensure_wrappers(self):
        """Root: bundle/bundler wrappers for the versioned Bundler of the system Ruby, in a directory
        on the PATH of system-Ruby applications (like the composer wrapper of PHP)."""
        bundle = self.system_bundle() if os.path.isfile("/usr/bin/ruby") else None
        if not bundle or bundle == "/usr/bin/bundle":
            return
        ensure_dir(os.path.dirname(os.path.dirname(self.wrapper_dir)))
        ensure_dir(os.path.dirname(self.wrapper_dir))
        ensure_dir(self.wrapper_dir)
        for name, target in (("bundle", bundle), ("bundler", bundle.replace("/bundle", "/bundler", 1))):
            if not os.path.isfile(target):
                target = bundle
            content = ("#!/bin/sh\n# Managed by the Plesk Runway extension: the Bundler of the system Ruby.\n"
                       "exec %s \"$@\"\n" % target)
            path = os.path.join(self.wrapper_dir, name)
            if _read_text(path) != content.strip():
                write_file_atomic(path, content, 0o755)

    def list_installed(self):
        if self._installed is not None:
            return self._installed
        found = set()
        for name in _listdir("/etc/psa/ruby_versions.d"):
            data = read_json(os.path.join("/etc/psa/ruby_versions.d", name)) if name.endswith(".json") else None
            version = str((data or {}).get("version") or "") if isinstance(data, dict) else ""
            if re.match(r"^\d+\.\d+\.\d+$", version) and data.get("path") == self.prefix(version):
                found.add(version)
        for name in _listdir("/opt/plesk/ruby"):
            if re.match(r"^\d+\.\d+\.\d+$", name):
                found.add(name)
        result = [{"id": v, "label": "Ruby %s (Plesk)" % v, "path": self.prefix(v)}
                  for v in sorted(found, key=num_key, reverse=True) if os.path.isfile(self.prefix(v) + "/bin/ruby")]
        if os.path.isfile("/usr/bin/ruby"):
            match = None
            try:
                match = re.search(r"ruby (\d+\.\d+\.\d+)", run(["/usr/bin/ruby", "--version"], timeout=10).stdout)
            except HelperError:
                pass
            result.append({"id": "system", "label": "Ruby %s (system /usr/bin/ruby)" % (match.group(1) if match else "?"),
                           "path": "/usr"})
        self._installed = result
        return result

    def env(self, home, version, app_dir=None):
        rw = os.path.join(home, ".runway")
        gems = rw + "/gems"
        paths = [gems + "/bin", self.prefix(version) + "/bin"]
        if version == "system":
            try:
                self.ensure_wrappers()
            except OSError:
                pass
            paths.append(self.wrapper_dir)
        # No GEM_PATH: RubyGems then searches GEM_HOME plus the interpreter's default directory,
        # which holds the bundled gems (rexml, csv, ...) of Ruby 3.x.
        return {
            "PATH": paths,
            "GEM_HOME": gems,
            "GEM_SPEC_CACHE": gems + "/specs",
            "BUNDLE_PATH": rw + "/bundle",
            "BUNDLE_APP_CONFIG": rw + "/bundle-config",
            "BUNDLE_USER_HOME": rw + "/bundle-user",
            "BUNDLE_USER_CACHE": rw + "/bundle-user/cache",
            "BUNDLE_JOBS": "4",
            "BUNDLE_WITHOUT": "development:test",
            "BUNDLE_RETRY": "3",
            "BUNDLE_SILENCE_ROOT_WARNING": "1",
            "RAILS_ENV": "production",
            "RACK_ENV": "production",
            "RAILS_LOG_TO_STDOUT": "1",
            "MALLOC_ARENA_MAX": "2",
        }

    def inspect(self, app_dir):
        found = _files(app_dir, "Gemfile", "Gemfile.lock", "config.ru", "config/puma.rb", "bin/rails", "app.rb",
                       ".ruby-version", "config/database.yml")
        if not found:
            return None
        info = {"gemfile": "Gemfile" in found, "lockfile": "Gemfile.lock" in found, "rack": "config.ru" in found,
                "puma_config": "config/puma.rb" in found, "rails": "bin/rails" in found, "gems": [],
                "script": "app.rb" if "app.rb" in found else None, "ruby_version": None}
        if info["gemfile"]:
            text = _read_small(os.path.join(app_dir, "Gemfile"), 65536)
            info["gems"] = [g for g in ("puma", "unicorn", "rails", "sinatra", "falcon")
                            if re.search(r"^\s*gem\s+['\"]%s['\"]" % g, text, re.M)]
        if ".ruby-version" in found:
            match = re.search(r"(\d+\.\d+(\.\d+)?)", _read_small(os.path.join(app_dir, ".ruby-version"), 256))
            info["ruby_version"] = match.group(1) if match else None
        return info

    def defaults(self, inspect, listen="tcp", toolchain=""):
        info = (inspect or {}).get("ruby") or {}
        unix = listen == "unix"
        steps = []
        if info.get("gemfile"):
            if toolchain == "system" and not self.system_bundle():
                # No Bundler at all for the system Ruby: install it into GEM_HOME (on PATH) first.
                steps.append("gem install --no-document bundler")
            steps.append("bundle install")
        if info.get("rails"):
            # Through Bundler, not bin/rails: uploads (FTP, File Manager) often lose the exec bit.
            steps.append("SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile")
        build = " && ".join(steps)
        gems = info.get("gems") or []
        result = {"build_cmd": build}
        if info.get("puma_config") and (info.get("rails") or "puma" in gems):
            # The project's config/puma.rb decides where puma listens (a command-line -b would replace
            # every bind of the file); it reads RUNWAY_SOCKET or PORT, see examples/ruby-hello.
            start = "bundle exec puma -C config/puma.rb -e production"
        elif info.get("rails") or (info.get("rack") and "puma" in gems):
            bind = '"unix://$RUNWAY_SOCKET?umask=0117"' if unix else "tcp://$HOST:$PORT"
            start = "bundle exec puma -e production -b %s" % bind
        elif "unicorn" in gems:
            start = "bundle exec unicorn -E production -l %s" % ("$RUNWAY_SOCKET" if unix else "$HOST:$PORT")
        elif info.get("rack"):
            # rackup has no unix socket option: TCP only.
            start = "bundle exec rackup -E production -o $HOST -p $PORT"
            result["unix_supported"] = False
        else:
            start = "ruby " + (info.get("script") or "app.rb")
        result["start_cmd"] = start
        return result

    def sample(self, listen, toolchain=""):
        return {"app.rb": (SAMPLE_RUBY, 0o640)}

    def build_deps(self):
        return ["cc", "make"]


# --- PHP (detected Plesk handlers + managed FrankenPHP) ------------------------

class PhpRuntime(Runtime):
    key = "php"
    label = "PHP"
    toolchain = "detected"
    version_re = r"^(system|plesk-\d+\.\d+|frankenphp-\d+\.\d+\.\d+)$"
    hint = ("Plesk PHP versions (php -S, Composer) are detected; FrankenPHP (static binary from GitHub, "
            "verified with SHA-256) can be installed for production servers and unix sockets.")
    install_help = ("PHP versions come from Plesk (Tools & Settings > Updates > PHP interpreter versions). "
                    "FrankenPHP versions can be installed here.")
    docs_url = "https://frankenphp.dev/docs/"
    unix_toolchain_re = r"^frankenphp-"
    defaults_per_toolchain = True
    fp_root = BASE_DIR + "/frankenphp"
    _plesk = None

    def plesk_versions(self):
        """{minor: full version} of the Plesk PHP CLI binaries."""
        if self._plesk is not None:
            return self._plesk
        found = {}
        data = read_json("/etc/psa/php_versions.json")
        for item in (data.get("php") if isinstance(data, dict) else None) or []:
            clipath = str(item.get("clipath") or "") if isinstance(item, dict) else ""
            match = re.match(r"^/opt/plesk/php/(\d+\.\d+)/bin/php$", clipath)
            if match and os.path.isfile(clipath):
                full = str(item.get("version") or "")
                found[match.group(1)] = full if re.match(r"^\d+\.\d+\.\d+$", full) else match.group(1)
        for name in _listdir("/opt/plesk/php"):
            if re.match(r"^\d+\.\d+$", name) and os.path.isfile("/opt/plesk/php/%s/bin/php" % name):
                found.setdefault(name, name)
        self._plesk = found
        return found

    def list_installed(self):
        result = []
        plesk = self.plesk_versions()
        for minor in sorted(plesk, key=num_key, reverse=True):
            result.append({"id": "plesk-" + minor, "label": "PHP %s (Plesk)" % plesk[minor],
                           "path": "/opt/plesk/php/%s/bin/php" % minor, "kind": "detected"})
        if os.path.isfile("/usr/bin/php"):
            result.append({"id": "system", "label": "PHP (system /usr/bin/php)", "path": "/usr/bin/php",
                           "kind": "detected"})
        for name in sorted(_listdir(self.fp_root), key=num_key, reverse=True):
            path = os.path.join(self.fp_root, name, "frankenphp")
            if re.match(r"^\d+\.\d+\.\d+$", name) and os.path.isfile(path):
                result.append({"id": "frankenphp-" + name, "label": "FrankenPHP " + name, "path": path,
                               "kind": "managed"})
        return result

    def releases(self, force=False):
        asset = "frankenphp-linux-" + machine_arch()
        result = []
        for rel in github_releases("php/frankenphp", force, per_page=20):
            match = re.match(r"^v(\d+\.\d+\.\d+)$", rel["tag"])
            if match and not rel["prerelease"] and asset in rel["assets"]:
                result.append({"version": match.group(1), "asset": rel["assets"][asset]})
        result.sort(key=lambda r: num_key(r["version"]), reverse=True)
        return result

    def list_available(self, force=False):
        return [{"id": "frankenphp-" + r["version"], "label": "FrankenPHP " + r["version"]}
                for r in self.releases(force)[:10]]

    def check_installable(self, version):
        if not version.startswith("frankenphp-"):
            raise HelperError(self.install_help)

    def install(self, version, log):
        version = self.check_version(version)
        self.check_installable(version)
        number = version[len("frankenphp-"):]
        target = os.path.join(self.fp_root, number)
        if os.path.isfile(target + "/frankenphp"):
            log.line("FrankenPHP %s is already installed." % number)
            return
        rel = next((r for r in self.releases(force=True) if r["version"] == number), None)
        if not rel:
            raise HelperError("FrankenPHP %s was not found in the release list" % number)
        sha = rel["asset"].get("sha256")
        if not sha:
            log.line("WARNING: the release publishes no checksum for this file; the download is NOT verified.")
        ensure_dir(self.fp_root)
        work = tempfile.mkdtemp(prefix=".tmp-", dir=self.fp_root)
        try:
            stage = os.path.join(work, number)
            os.mkdir(stage, 0o755)
            download(https_url(rel["asset"]["url"]), stage + "/frankenphp", sha, log)
            os.chmod(stage + "/frankenphp", 0o755)
            proc = run([stage + "/frankenphp", "version"], timeout=60,
                       env=root_env({"XDG_DATA_HOME": work + "/data", "XDG_CONFIG_HOME": work + "/config"}))
            if proc.returncode != 0:
                raise HelperError("frankenphp version failed: %s" % (proc.stderr or proc.stdout).strip()[-300:])
            log.line(proc.stdout.strip())
            swap_dir(stage, target, work)
        finally:
            shutil.rmtree(work, ignore_errors=True)
        log.line("FrankenPHP %s installed to %s" % (number, target))

    def remove(self, version):
        version = self.check_version(version)
        if not version.startswith("frankenphp-"):
            Runtime.remove(self, version)
        self._remove_dir(self.fp_root, version[len("frankenphp-"):])

    def is_installed(self, version):
        if version.startswith("frankenphp-"):
            return os.path.isfile(os.path.join(self.fp_root, version[len("frankenphp-"):], "frankenphp"))
        return Runtime.is_installed(self, version)

    def env(self, home, version, app_dir=None):
        rw = os.path.join(home, ".runway")
        paths = []
        if version.startswith("frankenphp-"):
            paths.append(os.path.join(self.fp_root, version[len("frankenphp-"):]))
            plesk = self.plesk_versions()
            if plesk:  # php CLI for Composer and artisan
                paths.append("/opt/plesk/php/%s/bin" % max(plesk, key=num_key))
        elif version.startswith("plesk-"):
            paths.append("/opt/plesk/php/%s/bin" % version[len("plesk-"):])
        paths.append(COMPOSER_BIN_DIR)
        return {
            "PATH": paths,
            "COMPOSER_HOME": rw + "/composer",
            "COMPOSER_CACHE_DIR": rw + "/composer/cache",
            "COMPOSER_NO_INTERACTION": "1",
            "COMPOSER_FUND": "0",
            "COMPOSER_PROCESS_TIMEOUT": "600",
            "COMPOSER_MEMORY_LIMIT": "-1",
            "XDG_DATA_HOME": rw + "/data",
            "XDG_CONFIG_HOME": rw + "/config",
            "XDG_CACHE_HOME": rw + "/cache",
            "APP_ENV": "production",
        }

    def inspect(self, app_dir):
        found = _files(app_dir, "composer.json", "composer.lock", "artisan", "public/index.php", "index.php",
                       "config/octane.php", "public/worker.php", "Caddyfile")
        if not found:
            return None
        info = {"composer": "composer.json" in found, "lockfile": "composer.lock" in found,
                "artisan": "artisan" in found, "public": "public/index.php" in found,
                "root_index": "index.php" in found, "worker": "public/worker.php" in found,
                "octane": False, "laravel": False}
        if info["composer"]:
            data = _json_file(os.path.join(app_dir, "composer.json"))
            require = data.get("require") if isinstance(data.get("require"), dict) else {}
            info["octane"] = "laravel/octane" in require
            info["laravel"] = "laravel/framework" in require
        return info

    def defaults(self, inspect, listen="tcp", toolchain=""):
        info = (inspect or {}).get("php") or {}
        build = "composer install --no-dev --optimize-autoloader --no-interaction --no-progress" \
            if info.get("composer") else ""
        docroot = "." if info.get("root_index") and not info.get("public") else "public/"
        unix = listen == "unix"
        if (toolchain or "").startswith("frankenphp-"):
            if info.get("octane") and info.get("artisan"):
                # Octane with Runway's Caddyfile (written before every start, see prepare_start):
                # admin endpoint off (the unit may bind only its own port) and the site bound to
                # 127.0.0.1:$PORT or the socket. Octane probes the HTTP and the admin port on
                # 127.0.0.1 before it starts: both are $PORT in TCP mode; in socket mode another
                # host than 127.0.0.1 skips that probe (the Caddyfile binds the socket).
                start = "php artisan octane:frankenphp --caddyfile=%s %s" % (
                    OCTANE_CADDYFILE, "--host=localhost" if unix else "--port=$PORT --admin-port=$PORT")
            else:
                address = '"unix/$RUNWAY_SOCKET|0660"' if unix else "$HOST:$PORT"
                start = "frankenphp php-server --listen %s -r %s" % (address, docroot)
                if info.get("worker") and docroot == "public/":
                    start += " -w public/worker.php"
            return {"build_cmd": build, "start_cmd": start}
        # php -S cannot listen on a unix socket: unix mode needs a FrankenPHP toolchain.
        return {"build_cmd": build, "start_cmd": "php -S $HOST:$PORT -t " + docroot.rstrip("/"),
                "unix_supported": False}

    def sample(self, listen, toolchain=""):
        return {"public/index.php": (SAMPLE_PHP, 0o640)}

    def prepare_start(self, state, pw):
        if OCTANE_CADDYFILE in (state.get("start_cmd") or ""):
            call_as_user(pw, _user_write_octane_caddyfile, state["app_dir"], state.get("listen"))

    def build_deps(self):
        return ["git", "unzip"]


OCTANE_CADDYFILE = ".runway/Caddyfile"
OCTANE_STUB = "vendor/laravel/octane/src/Commands/stubs/Caddyfile"
# Laravel Octane 2.24's stubs/Caddyfile: used when the project has no vendor/ copy yet.
OCTANE_CADDYFILE_STUB = """{
	{$CADDY_GLOBAL_OPTIONS}

	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			{$CADDY_SERVER_WATCH_DIRECTIVES}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$CADDY_SERVER_SERVER_NAME} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL}
		format filter {
			wrap {$CADDY_SERVER_LOGGER}
			fields {
				request>uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	@compressible not path /.well-known/mercure

	route {
		root * "{$APP_PUBLIC_PATH}"
		encode @compressible zstd br gzip

		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
"""


def octane_caddyfile(stub, listen):
    """Runway's Caddyfile for Laravel Octane from Octane's own stub: the admin endpoint is turned
    off (the unit may bind only the application's port; Octane would bind 2019+) and the site
    address (Octane's "http://:$PORT", i.e. every interface) is replaced by 127.0.0.1:$PORT or the
    unix socket. Returns None when the stub does not look like Octane's."""
    if listen == "unix":
        site = ["http:// {", "\tbind unix/{$RUNWAY_SOCKET}|0660"]
    else:
        site = ["http://:{$PORT} {", "\tbind 127.0.0.1"]
    out = []
    site_done = admin_done = False
    for line in stub.splitlines():
        if re.match(r"^\s*admin(\s|$)", line):
            if not admin_done:
                out.append("\tadmin off")
                admin_done = True
            continue
        if not site_done and re.match(r"^\{\$CADDY_SERVER_SERVER_NAME\}\s*\{$", line.strip()):
            out += site
            site_done = True
            continue
        out.append(line)
    if not site_done:
        return None
    if not admin_done:
        first = next((i for i, line in enumerate(out) if line.strip() and not line.strip().startswith("#")), None)
        if first is None or out[first].strip() != "{":
            return None
        out.insert(first + 1, "\tadmin off")
    header = ["# Managed by the Plesk Runway extension: Laravel Octane's Caddyfile with the admin endpoint off",
              "# and the site bound to %s. Rewritten before every start; do not edit."
              % ("the unix socket RUNWAY_SOCKET" if listen == "unix" else "127.0.0.1:PORT")]
    return "\n".join(header + out) + "\n"


def _user_write_octane_caddyfile(app_dir, listen):
    """Runs as the customer: writes .runway/Caddyfile from the project's Octane stub (or the built-in
    copy) for the listen mode."""
    text = None
    stub = os.path.join(app_dir, OCTANE_STUB)
    if os.path.isfile(stub):
        try:
            text = octane_caddyfile(_read_small(stub, 65536), listen)
        except (HelperError, OSError):
            text = None
    if text is None:
        text = octane_caddyfile(OCTANE_CADDYFILE_STUB, listen)
    folder = os.path.join(app_dir, os.path.dirname(OCTANE_CADDYFILE))
    os.makedirs(folder, 0o750, exist_ok=True)
    if os.path.islink(folder):
        raise HelperError("%s is a symbolic link" % folder)
    fd = os.open(os.path.join(app_dir, OCTANE_CADDYFILE), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o640)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
    return True


# --- Prebuilt binary -----------------------------------------------------------

def _is_program(path):
    """True for an ELF binary or a script with a shebang line (files copied from Windows often
    carry the executable bit, e.g. README.md). Never follows symbolic links or blocks on FIFOs."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return False
        head = os.read(fd, 4)
    except OSError:
        return False
    finally:
        os.close(fd)
    return head == b"\x7fELF" or head[:2] == b"#!"


class BinaryRuntime(Runtime):
    key = "binary"
    label = "Prebuilt binary"
    toolchain = "none"
    version_re = ""
    hint = "Upload an executable compiled for Linux (or fetch it from a URL) and set the start command."
    supports_build = False

    def inspect(self, app_dir):
        executables = []
        for name in sorted(_scan_names(app_dir, 2000)[0]):
            try:
                st = os.lstat(os.path.join(app_dir, name))
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode) and st.st_mode & 0o100 and not name.startswith(".") and RE_REL_PATH.match(name)                     and _is_program(os.path.join(app_dir, name)):
                executables.append(name)
        return {"executables": executables[:20]} if executables else None

    def defaults(self, inspect, listen="tcp", toolchain=""):
        executables = ((inspect or {}).get("binary") or {}).get("executables") or []
        name = "app" if "app" in executables or not executables else executables[0]
        return {"build_cmd": "", "start_cmd": "./" + name}

    def sample(self, listen, toolchain=""):
        return {"app": ("#!/usr/bin/python3\n" + SAMPLE_PYTHON, 0o750)}


SAMPLE_GO = """// Runway sample app: listens on RUNWAY_SOCKET (unix mode) or LISTEN_ADDR (tcp mode).
package main

import (
	"fmt"
	"net"
	"net/http"
	"os"
	"runtime"
)

func main() {
	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		fmt.Fprintf(w, "Hello from Go %s on Runway\\n", runtime.Version())
	})
	if sock := os.Getenv("RUNWAY_SOCKET"); sock != "" {
		os.Remove(sock)
		ln, err := net.Listen("unix", sock)
		if err != nil {
			panic(err)
		}
		panic(http.Serve(ln, nil))
	}
	addr := os.Getenv("LISTEN_ADDR")
	if addr == "" {
		addr = "127.0.0.1:8080"
	}
	panic(http.ListenAndServe(addr, nil))
}
"""

