#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
#
# Runway for Plesk - privileged helper.
#
# This program runs as root. It is invoked either by the Plesk panel through
# pm_ApiCli::callSbin() on behalf of the extension UI, or by systemd units that
# this program generates itself (deploy jobs and toolchain jobs).
#
# Every input is treated as untrusted and validated here, even though the PHP
# side validates it too. Anything that touches files owned by a hosting
# customer is done in a child process that has dropped root privileges, so a
# customer can never trick this program into following a symlink as root.
#
# Protocol:  runway-helper <command>            (JSON payload on stdin)
#            runway-helper <command> <base64>   (manual debugging only: argv is visible
#                                             to every local user through ps)
# Output:    exactly one JSON object on stdout:
#              {"ok": true, ...}  or  {"ok": false, "error": "..."}
#            The exit code is 0 on success and 1 on failure.
#
# Compatible with Python 3.8+ (Ubuntu 20.04 and newer, Debian 11+, EL8+).

import base64
import datetime
import fcntl
import hashlib
import http.client
import ipaddress
import json
import os
import pwd
import grp
import re
import resource
import select
import shutil
import signal
import socket
import ssl
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile

VERSION = "1.0.0"

BASE_DIR = "/opt/runway"
BIN_DIR = BASE_DIR + "/bin"
HELPER_COPY = BIN_DIR + "/runway-helper"
GO_ROOT_DIR = BASE_DIR + "/go"
RUST_ROOT_DIR = BASE_DIR + "/rust"
RUSTUP_HOME = RUST_ROOT_DIR + "/rustup"
RUSTUP_CARGO_HOME = RUST_ROOT_DIR + "/cargo"

STATE_DIR = "/var/lib/runway"
APPS_DIR = STATE_DIR + "/apps"
JOBS_DIR = STATE_DIR + "/jobs"
LOCK_DIR = STATE_DIR + "/locks"
CACHE_DIR = STATE_DIR + "/cache"

CONF_DIR = "/etc/runway"
ENV_DIR = CONF_DIR + "/env"
UNIT_DIR = "/etc/systemd/system"
# systemd-tmpfiles entries recreate /run/runway/<id> (unix socket mode) at boot, before any unit
# starts: runway.conf for /run/runway itself, runway-<id>.conf per application.
TMPFILES_DIR = "/etc/tmpfiles.d"
TMPFILES_BASE = TMPFILES_DIR + "/runway.conf"

ROOT_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
USER_PATH = "/usr/local/bin:/usr/bin:/bin"

UNIT_APP = "runway-app-%d.service"
UNIT_DEPLOY = "runway-deploy-%d.service"
UNIT_PATH = "runway-deploy-%d.path"
UNIT_ADMIN_JOB = "runway-job-admin.service"

# Unix socket mode: /run/runway/<id>/app.sock, directory owned by the system user with the
# web server group (nginx and Apache are members of psaserv, hosting customers are not).
RUN_DIR = "/run/runway"
WEB_GROUP = "psaserv"

TRIGGER_DEPLOY = "tmp/deploy.txt"
TRIGGER_RESTART = "tmp/restart.txt"

LOG_CAP = 8 * 1024 * 1024
LOG_READ_CAP = 2 * 1024 * 1024
LOG_LINE_CAP = 4096
LOCK_TIMEOUT = 60
CHILD_TIMEOUT = 30
# Resource limits of the children that run as the customer (call_as_user): they are forked from
# the panel's helper invocation, outside any per-subscription cgroup.
CHILD_MEMORY = 512 * 1024 * 1024
CHILD_FSIZE = 64 * 1024 * 1024
# Directory listings in those children: names kept per listing, and the most entries counted.
LIST_KEEP_ROOT = 10000
LIST_COUNT_CAP = 10000
DEFAULT_BUILD_TASKS = 4096
# Crash-loop guard of the app units: systemd gives up after this many starts within 120 s.
APP_START_LIMIT_BURST = 10
MAX_PAYLOAD = 1024 * 1024
HTTP_TIMEOUT = 60
USER_AGENT = "plesk-runway/" + VERSION

# Variables that Runway manages itself; users must not override them.
RESERVED_ENV = frozenset([
    "PORT", "HOST", "LISTEN_ADDR", "RUNWAY_APP_ROOT", "RUNWAY_START_CMD",
    "RUNWAY_SOCKET", "RUNWAY_LISTEN",
    "HOME", "USER", "LOGNAME",
])
# Variables of the dynamic loader and the C library that change what a process loads. They are
# refused in the environment file (defence in depth: no unit line runs as root with the customer's
# environment); an application that needs one sets it in its start command.
LOADER_ENV = frozenset(["LD_PRELOAD", "LD_AUDIT", "GCONV_PATH", "GLIBC_TUNABLES"])

RE_GO_VERSION = re.compile(r"^1\.\d{1,3}(\.\d{1,3})?((rc|beta)\d{1,2})?$")
RE_RUST_TOOLCHAIN = re.compile(r"^(stable|beta|nightly(-\d{4}-\d{2}-\d{2})?|1\.\d{1,3}(\.\d{1,3})?)$")
RE_SYSUSER = re.compile(r"^[a-z_][a-z0-9_.-]{0,31}$")
RE_ENV_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,127}$")
RE_SAFE_PATH = re.compile(r"^/[A-Za-z0-9._@+/-]{1,1023}$")
RE_REL_PATH = re.compile(r"^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$")
RE_DOMAIN = re.compile(r"^[^\s/\\'\"`$;&|<>(){}\[\]*?!#%=,]{1,253}$")
RE_CTRL_ANY = re.compile(r"[\x00-\x1f\x7f]")
RE_CTRL_BUT_NL = re.compile(r"[\x00-\x09\x0b-\x1f\x7f]")

# Listen modes, application modes and URL rules (docs/DESIGN.md section 5.3). The runtime
# adapters (RUNTIMES, RUNTIME_KEYS) are defined in the "Runtime adapters" section below.
LISTEN_MODES = ("tcp", "unix", "none")
APP_MODES = ("web", "path", "worker")
RE_URL_PREFIX = re.compile(r"^/[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$")
RE_HEALTH_PATH = re.compile(r"^/[A-Za-z0-9._~%/?=&+,:@-]{0,511}$")
RE_FETCH_NAME = re.compile(r"^[A-Za-z0-9_+-][A-Za-z0-9._+-]{0,127}$")
MAX_STATIC_PATHS = 20
FETCH_MAX_BYTES = 500 * 1024 * 1024
FETCH_TIMEOUT = 1800
HEALTH_TIMEOUT = 2.0
# Root-owned switch for tests only: allows http:// and non-public addresses in fetch mode.
FETCH_INSECURE_FLAG = CONF_DIR + "/allow-insecure-fetch"
# Root-only test flag: while it exists (and is younger than RECONCILE_PAUSE_MAX seconds) the
# panel's Reconcile leaves helper apps alone, so tests can use fake domain ids.
RECONCILE_PAUSE_FLAG = STATE_DIR + "/pause-reconcile"
RECONCILE_PAUSE_MAX = 3600


class HelperError(Exception):
    """An expected failure whose message is safe to show in the UI. "code" is an optional
    machine-readable reason (e.g. "not_empty") that the panel can map to a form field."""

    def __init__(self, message, code=None):
        Exception.__init__(self, message)
        self.code = code


# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def root_env(extra=None):
    env = {"PATH": ROOT_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": "/root"}
    if extra:
        env.update(extra)
    return env


def run(cmd, check=False, timeout=120, env=None, input_text=None):
    try:
        proc = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            input=input_text,
            timeout=timeout,
            env=env if env is not None else root_env(),
            universal_newlines=True,
            errors="replace",
        )
    except FileNotFoundError:
        raise HelperError("Command not found: %s" % cmd[0])
    except subprocess.TimeoutExpired:
        raise HelperError("Command timed out: %s" % " ".join(cmd[:3]))
    if check and proc.returncode != 0:
        msg = (proc.stderr or proc.stdout or "").strip()
        raise HelperError("%s failed (exit %d): %s" % (" ".join(cmd[:3]), proc.returncode, msg[-2000:]))
    return proc


def ensure_dir(path, mode=0o755):
    os.makedirs(path, mode=mode, exist_ok=True)
    os.chmod(path, mode)


def write_file_atomic(path, content, mode=0o644):
    """Writes a root-owned file atomically. Only used for root-owned directories."""
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(content)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.rename(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def write_json(path, data, mode=0o600):
    write_file_atomic(path, json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n", mode)


def remove_quietly(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def tail_file(path, max_lines=300, max_bytes=512 * 1024):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - max_bytes))
            data = fh.read()
    except OSError:
        return ""
    lines = data.decode("utf-8", "replace").splitlines()
    return "\n".join(lines[-max_lines:])


class FileLock(object):
    def __init__(self, name):
        ensure_dir(LOCK_DIR, 0o700)
        self.path = os.path.join(LOCK_DIR, name + ".lock")
        self.fh = None

    def acquire(self, blocking=True, timeout=LOCK_TIMEOUT):
        self.fh = open(self.path, "a")
        deadline = time.time() + timeout
        while True:
            try:
                fcntl.flock(self.fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except OSError:
                if not blocking or time.time() >= deadline:
                    self.fh.close()
                    self.fh = None
                    return False
                time.sleep(0.2)

    def release(self):
        if self.fh:
            fcntl.flock(self.fh.fileno(), fcntl.LOCK_UN)
            self.fh.close()
            self.fh = None

    def __enter__(self):
        if not self.acquire(True):
            raise HelperError("Another operation is still in progress. Please try again in a moment.")
        return self

    def __exit__(self, *exc):
        self.release()


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

def v_int(value, lo, hi, name):
    if isinstance(value, bool):
        raise HelperError("Invalid %s" % name)
    try:
        number = int(value)
    except (TypeError, ValueError):
        raise HelperError("Invalid %s" % name)
    if number < lo or number > hi:
        raise HelperError("%s must be between %d and %d" % (name, lo, hi))
    return number


def v_domain_id(value):
    return v_int(value, 1, 2 ** 31 - 1, "domain_id")


def v_domain_name(value):
    if not isinstance(value, str) or not RE_DOMAIN.match(value) or value.startswith(("-", ".")):
        raise HelperError("Invalid domain name")
    return value


def v_sysuser(value):
    if not isinstance(value, str) or not RE_SYSUSER.match(value):
        raise HelperError("Invalid system user")
    try:
        pw = pwd.getpwnam(value)
    except KeyError:
        raise HelperError("System user '%s' does not exist" % value)
    if pw.pw_uid < 1000 or pw.pw_uid == 65534:
        raise HelperError("Refusing to run applications as privileged user '%s'" % value)
    if not pw.pw_dir or not pw.pw_dir.startswith("/") or pw.pw_dir == "/":
        raise HelperError("System user '%s' has no usable home directory" % value)
    return pw


def v_app_root(value, home):
    """Validates an application root given RELATIVE to the system user's home directory.

    The home directory always comes from the passwd database, never from the caller,
    so the resulting absolute path can only point inside the subscription.
    Returns (relative, absolute)."""
    if not isinstance(value, str):
        raise HelperError("Invalid application root")
    value = value.strip().strip("/")
    if not value or len(value) > 512 or not RE_REL_PATH.match(value):
        raise HelperError("Application root must be a path inside the subscription home "
                          "(allowed characters: letters, digits, . _ - @ + /)")
    if any(part in (".", "..") for part in value.split("/")):
        raise HelperError("Application root must not contain '.' or '..' segments")
    home = os.path.normpath(home)
    absolute = home + "/" + value
    if os.path.normpath(absolute) != absolute or not RE_SAFE_PATH.match(absolute):
        raise HelperError("Invalid application root")
    return value, absolute


def v_toolchain(runtime, value):
    value = value.strip() if isinstance(value, str) else ("" if value is None else str(value))
    rt = RUNTIMES.get(runtime)
    if rt is None or rt.toolchain == "none" or value == "":
        return ""
    if rt.version_re and re.match(rt.version_re, value):
        return value
    raise HelperError("Invalid %s toolchain version '%s'" % (runtime, value[:64]))


def v_url_prefix(value, name):
    value = value.strip() if isinstance(value, str) else ""
    if len(value) > 200 or not RE_URL_PREFIX.match(value) or any(part in (".", "..") for part in value.split("/")):
        raise HelperError("Invalid %s '%s' (expected a path like /api)" % (name, value[:64]))
    return value


def v_static_paths(value):
    if value in (None, "", []):
        return []
    if not isinstance(value, list) or len(value) > MAX_STATIC_PATHS:
        raise HelperError("Invalid static paths (at most %d)" % MAX_STATIC_PATHS)
    result = []
    for item in value:
        path = v_url_prefix(item, "static path")
        if path not in result:
            result.append(path)
    return result


def v_health_path(value):
    value = value.strip() if isinstance(value, str) else ""
    if value and not RE_HEALTH_PATH.match(value):
        raise HelperError("Invalid health check path")
    return value


def v_command(value, name, allow_empty, allow_newlines):
    if value is None:
        value = ""
    if not isinstance(value, str):
        raise HelperError("Invalid %s" % name)
    value = value.replace("\r\n", "\n").strip()
    if not value and not allow_empty:
        raise HelperError("The %s must not be empty" % name)
    if len(value) > 4000:
        raise HelperError("The %s is too long" % name)
    pattern = RE_CTRL_BUT_NL if allow_newlines else RE_CTRL_ANY
    if pattern.search(value):
        raise HelperError("The %s contains control characters%s" % (name, "" if allow_newlines else " or line breaks"))
    return value


def v_env(value):
    if value in (None, "", []):
        return {}
    if not isinstance(value, dict) or len(value) > 200:
        raise HelperError("Invalid environment variables")
    result = {}
    for key, val in value.items():
        if not isinstance(key, str) or not RE_ENV_KEY.match(key):
            raise HelperError("Invalid environment variable name '%s'" % key)
        if key in RESERVED_ENV:
            raise HelperError("Environment variable %s is managed by Runway" % key)
        if key in LOADER_ENV:
            raise HelperError("Environment variable %s cannot be set here; put it in the start command" % key)
        if not isinstance(val, str):
            val = str(val)
        if len(val) > 8192 or RE_CTRL_ANY.search(val.replace("\t", " ")):
            raise HelperError("Value of %s contains line breaks or control characters" % key)
        result[key] = val
    return result


def validate_app(payload):
    if not isinstance(payload, dict):
        raise HelperError("Invalid payload")
    pw = v_sysuser(payload.get("sysuser"))
    enabled = bool(payload.get("enabled"))
    runtime = payload.get("runtime")
    if runtime not in RUNTIME_KEYS:
        raise HelperError("Invalid runtime")
    limits = payload.get("limits") or {}
    build_limits = payload.get("build_limits") or {}
    listen = payload.get("listen") or "tcp"
    if listen not in LISTEN_MODES:
        raise HelperError("Invalid listen mode")
    mode = payload.get("mode") or ("worker" if listen == "none" else "web")
    if mode not in APP_MODES:
        raise HelperError("Invalid application mode")
    if mode == "worker" or listen == "none":
        # A worker has no listener and nothing is proxied to it (a port is still reserved).
        mode, listen = "worker", "none"
    port_range = payload.get("port_range") or [20000, 29999]
    if not isinstance(port_range, (list, tuple)) or len(port_range) != 2:
        raise HelperError("Invalid port range")
    pmin = v_int(port_range[0], 1024, 65535, "port range start")
    pmax = v_int(port_range[1], pmin, 65535, "port range end")
    app_root, app_dir = v_app_root(payload.get("app_root"), pw.pw_dir)
    state = {
        "version": 1,
        "domain_id": v_domain_id(payload.get("domain_id")),
        "domain": v_domain_name(payload.get("domain")),
        "sysuser": pw.pw_name,
        "app_root": app_root,
        "app_dir": app_dir,
        "runtime": runtime,
        "toolchain": v_toolchain(runtime, payload.get("toolchain")),
        "build_cmd": v_command(payload.get("build_cmd"), "build command", True, True),
        "start_cmd": v_command(payload.get("start_cmd"), "start command", not enabled, False),
        "env": v_env(payload.get("env")),
        "port": v_int(payload.get("port", 0) or 0, 0, 65535, "port"),
        "port_range": [pmin, pmax],
        "enabled": enabled,
        # The domain (or its subscription) is suspended/disabled in Plesk: keep the
        # configuration but do not run the service.
        "suspended": bool(payload.get("suspended")),
        # Stopped by the user (Stop) or by Runway (tampered socket path): the service stays
        # stopped (also across reboots, deployments and reconciles) until an explicit start.
        "stopped": bool(payload.get("stopped")),
        "tampered": bool(payload.get("tampered")),
        "tampered_at": str(payload.get("tampered_at") or "")[:40],
        "tampered_detail": str(payload.get("tampered_detail") or "")[:300],
        "auto_deploy": bool(payload.get("auto_deploy", True)),
        "build_timeout": v_int(payload.get("build_timeout", 3600), 60, 6 * 3600, "build timeout"),
        "limits": {
            "memory_mb": v_int(limits.get("memory_mb", 0) or 0, 0, 1024 * 1024, "memory limit"),
            "cpu_percent": v_int(limits.get("cpu_percent", 0) or 0, 0, 100 * 256, "CPU limit"),
            "tasks": v_int(limits.get("tasks", 0) or 0, 0, 1000000, "tasks limit"),
        },
        "build_limits": {
            "memory_mb": v_int(build_limits.get("memory_mb", 0) or 0, 0, 1024 * 1024, "build memory limit"),
            "cpu_percent": v_int(build_limits.get("cpu_percent", 0) or 0, 0, 100 * 256, "build CPU limit"),
            "tasks": v_int(build_limits.get("tasks", 0) or 0, 0, 1000000, "build tasks limit"),
        },
        "listen": listen,
        "mode": mode,
        "mount_path": v_url_prefix(payload.get("mount_path"), "mount path") if mode == "path" else "",
        "static_paths": v_static_paths(payload.get("static_paths")),
        "health_path": v_health_path(payload.get("health_path")) if listen != "none" else "",
    }
    if state["port"] and state["port"] < 1024:
        raise HelperError("Port must be 1024 or higher")
    if state["tampered"]:
        state["stopped"] = True
    return state, pw


def load_app_state(domain_id):
    state = read_json(app_state_path(domain_id))
    if not isinstance(state, dict):
        raise HelperError("Application #%d is not configured" % domain_id)
    # Re-validate: the state file is root-owned, but be strict anyway.
    validated, pw = validate_app(state)
    validated["port"] = state.get("port", 0)
    return validated, pw


