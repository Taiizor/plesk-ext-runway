RUNTIMES = {}
for _runtime in (GoRuntime(), RustRuntime(), BunRuntime(), JavaRuntime(), DotnetRuntime(), PythonRuntime(),
                 RubyRuntime(), PhpRuntime(), BinaryRuntime()):
    RUNTIMES[_runtime.key] = _runtime
RUNTIME_KEYS = tuple(RUNTIMES)


def runtime_defaults(runtime, inspect, listen="tcp", toolchain=""):
    """Default build and start commands of a runtime for the inspected project and listen mode."""
    rt = RUNTIMES.get(runtime)
    if rt is None:
        return {"build_cmd": "", "start_cmd": ""}
    try:
        result = dict(rt.defaults(inspect if isinstance(inspect, dict) else {}, listen, toolchain or ""))
    except Exception:  # noqa: BLE001 - defaults are suggestions; never fail the page for them
        result = {"build_cmd": "", "start_cmd": ""}
    result.setdefault("unix_supported", True)
    result["listen"] = listen
    return result


# ---------------------------------------------------------------------------
# Commands: info / toolchains / jobs
# ---------------------------------------------------------------------------

def cmd_info(_payload):
    os_release = {}
    try:
        with open("/etc/os-release") as fh:
            for line in fh:
                if "=" in line:
                    key, val = line.rstrip("\n").split("=", 1)
                    os_release[key] = val.strip('"')
    except OSError:
        pass
    try:
        arch = host_arch()
    except HelperError:
        arch = (os.uname().machine, None)
    return {
        "helper_version": VERSION,
        "python": sys.version.split()[0],
        "systemd": systemd_version(),
        "os": os_release.get("PRETTY_NAME", ""),
        "arch": arch[0],
        "rust_target": arch[1],
        "build_deps": build_deps_status(),
        "installed": os.path.isfile(HELPER_COPY),
        "fetch_insecure": fetch_insecure_allowed(),
        "selinux": selinux_mode(),
        "update_source": read_update_source(),
    }


def selinux_mode():
    """enforcing | permissive | None (no SELinux): nginx/Apache may then need policy changes to
    reach the applications (README, Requirements)."""
    value = _read_text("/sys/fs/selinux/enforce", 8)
    if value == "1":
        return "enforcing"
    if value == "0":
        return "permissive"
    return None


def v_runtime(value):
    if value not in RUNTIMES:
        raise HelperError("Unknown runtime")
    return value


def toolchain_list(runtime):
    """Installed (managed) or detected toolchains of a runtime: [{id, label, path, ...}], newest first."""
    rt = RUNTIMES.get(runtime)
    if rt is None or rt.toolchain == "none":
        return []
    try:
        return rt.list_installed()
    except (HelperError, OSError):
        return []


def cmd_runtimes(_payload):
    return {"runtimes": [rt.meta() for rt in RUNTIMES.values()]}


def cmd_toolchains(_payload):
    in_use = toolchains_in_use()
    runtimes = {}
    for key, rt in RUNTIMES.items():
        runtimes[key] = {"installed": toolchain_list(key), "in_use": in_use.get(key, {}),
                         "toolchain": rt.toolchain, "build_deps": _which_status(rt.build_deps())}
    return {
        "runtimes": runtimes,
        "build_deps": build_deps_status(),
        "job": job_get_status("admin"),
    }


def cmd_releases(payload):
    """Versions that can be installed: {available: [{id, label}], error}. Network failures are
    reported in "error" and never fail the command, so the UI keeps working offline."""
    payload = payload or {}
    rt = RUNTIMES[v_runtime(payload.get("runtime"))]
    available = []
    error = None
    try:
        available = rt.list_available(bool(payload.get("force"))) or []
    except Exception as exc:  # noqa: BLE001
        error = "%s release list: %s" % (rt.label, exc)
    return {"runtime": rt.key, "available": available, "error": error,
            "toolchain": rt.toolchain, "install_help": rt.install_help}


def start_admin_job(action, args, title=None, title_key=None, title_params=None):
    """Starts the administrator's background job (toolchains, build dependencies, self-update)
    in runway-job-admin.service. title_key + title_params let the panel translate the title
    (title stays the English text); by default they follow the action and its runtime."""
    title = title or {"build-deps": "Install build dependencies"}.get(action, action)
    rt = RUNTIMES.get(args.get("runtime")) if args.get("runtime") else None
    if title_key is None:
        title_key = action.replace("-", "_")
    if title_params is None:
        title_params = {"runtime": rt.label, "version": args.get("version", "")} if rt else {}
    with FileLock("admin-job"):
        if unit_is_active(UNIT_ADMIN_JOB):
            raise HelperError("Another background job (toolchain or update) is still running. "
                              "Please wait until it finishes.")
        ensure_helper_copy()
        status_path, _log_path, request_path = job_paths("admin")
        ensure_dir(JOBS_DIR, 0o700)
        write_json(request_path, {"action": action, "args": args})
        remove_quietly(status_path)
        job_set_status("admin", state="queued", title=title, title_key=title_key, title_params=title_params,
                       queued_at=now_iso(), queued_epoch=time.time(), started_at=None, finished_at=None, message=None)
        run(["systemctl", "reset-failed", UNIT_ADMIN_JOB], timeout=30)
        cmd = ["systemd-run", "--unit=" + UNIT_ADMIN_JOB[:-len(".service")], "--collect", "--quiet",
               "--description=Runway: " + title,
               "--property=RuntimeMaxSec=7200", "--property=Nice=5",
               HELPER_COPY, "_job", "admin"]
        proc = run(cmd, timeout=60)
        if proc.returncode != 0:
            job_set_status("admin", state="failed", finished_at=now_iso(), message=(proc.stderr or proc.stdout).strip())
            raise HelperError("Could not start background job: %s" % (proc.stderr or proc.stdout).strip())
    return {"job": "admin"}


def _admin_runtime(payload):
    rt = RUNTIMES[v_runtime((payload or {}).get("runtime"))]
    if rt.toolchain == "none":
        raise HelperError("The %s runtime has no installable toolchain" % rt.label)
    return rt, rt.check_version((payload or {}).get("version"))


def cmd_toolchain_install(payload):
    rt, version = _admin_runtime(payload)
    rt.check_installable(version)
    return start_admin_job("install", {"runtime": rt.key, "version": version}, "Install %s %s" % (rt.label, version))


def cmd_toolchain_update(payload):
    rt, version = _admin_runtime(payload)
    if not rt.updatable(version):
        raise HelperError("Only channel toolchains can be updated (Rust stable/beta/nightly, Bun latest, "
                          "Python: newest patch of the minor version)")
    return start_admin_job("update", {"runtime": rt.key, "version": version}, "Update %s %s" % (rt.label, version))


def cmd_toolchain_remove(payload):
    rt, version = _admin_runtime(payload)
    target = rt.resolve(version)
    used = []
    for toolchain, domains in toolchains_in_use().get(rt.key, {}).items():
        # A configured channel id (Java major "21", Python minor "3.13", .NET "10.0") may point at
        # any build it matches (its env file was rendered when another build was the newest).
        if toolchain == version or rt.resolve(toolchain) == target or rt.may_use(toolchain, target):
            used += [str(domain) for domain in domains]
    if used:
        raise HelperError("Toolchain is used by: %s" % ", ".join(sorted(set(used))))
    with FileLock("admin-job"):
        if unit_is_active(UNIT_ADMIN_JOB):
            raise HelperError("A toolchain job is running. Please wait until it finishes.")
        rt.remove(version)
    return {"removed": version}


def rerender_runtime_apps(runtime, log=None):
    """Re-renders the env files and units of every app of a runtime (after a toolchain install or
    update): channel ids such as Java "21" or Python "3.13" then point at the newest build. Running
    services pick the change up at their next restart."""
    count = 0
    for raw in list(iter_app_states()):
        if raw.get("runtime") != runtime or not raw.get("toolchain"):
            continue
        try:
            state, pw = validate_app(raw)
            state["port"] = raw.get("port", 0)
            state.update(helper_fields(raw))
            if zd_has_slots(state):
                lock = FileLock("deploy-%d" % state["domain_id"])
                if not lock.acquire(blocking=False):
                    if log:
                        log.line("App #%s is being deployed; its environment follows with its next apply." % state["domain_id"])
                    continue
                try:
                    state, pw = load_app_state(state["domain_id"])
                    write_units(state, pw)
                finally:
                    lock.release()
            else:
                write_units(state, pw)
            count += 1
        except Exception as exc:  # noqa: BLE001
            if log:
                log.line("Could not update the environment of app #%s: %s" % (raw.get("domain_id"), exc))
    if count:
        systemctl("daemon-reload")
        if log:
            log.line("Updated the environment of %d application(s) using %s (effective at their next restart)."
                     % (count, runtime))
    return count


def cmd_build_deps_install(_payload):
    return start_admin_job("build-deps", {})


def cmd_job_status(payload):
    job = v_job((payload or {}).get("job"))
    lines = v_int((payload or {}).get("lines", 200), 1, 5000, "lines")
    status = job_get_status(job)
    status["log"] = tail_file(job_paths(job)[1], lines)
    return status


def internal_admin_job():
    status_path, log_path, request_path = job_paths("admin")
    request = read_json(request_path)
    remove_quietly(request_path)
    if not isinstance(request, dict):
        return
    job_set_status("admin", state="running", started_at=now_iso(), pid=os.getpid())
    log = JobLog("admin")
    log.line("Job started: %s" % request.get("action"))
    try:
        action = request.get("action")
        args = request.get("args") or {}
        if action in ("install", "update"):
            rt = RUNTIMES[v_runtime(args.get("runtime"))]
            version = rt.check_version(args.get("version"))
            if action == "install":
                rt.install(version, log)
            else:
                rt.update(version, log)
            rerender_runtime_apps(rt.key, log)
        elif action == "build-deps":
            job_build_deps(log)
        elif action == "self-update":
            job_self_update(args, log)
        else:
            raise HelperError("Unknown job action")
        log.line("Job finished successfully.")
        job_set_status("admin", state="succeeded", finished_at=now_iso(), exit_code=0, message=None)
    except Exception as exc:  # noqa: BLE001
        log.line("ERROR: %s" % exc)
        job_set_status("admin", state="failed", finished_at=now_iso(), exit_code=1, message=str(exc))
    finally:
        log.close()


# ---------------------------------------------------------------------------
# Built-in updater (docs/DESIGN.md section 7): the extension is distributed through GitHub
# releases, so Plesk never offers updates for it. update-check reads releases/latest of
# UPDATE_REPO (cached), the "self-update" admin job downloads the versioned zip, verifies it
# against the release's SHA256SUMS and runs "plesk bin extension --upgrade".
# ---------------------------------------------------------------------------

def read_update_source():
    """The test-only release source: first line of UPDATE_SOURCE_FLAG, or None. Its content
    decides where root downloads packages from, so the file is only honoured while it and
    CONF_DIR are owned by root and writable by nobody else."""
    try:
        st = os.lstat(UPDATE_SOURCE_FLAG)
        parent = os.lstat(CONF_DIR)
    except OSError:
        return None
    if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022
            or not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_mode & 0o022):
        return None
    lines = _read_text(UPDATE_SOURCE_FLAG, 4096).splitlines()
    return lines[0].strip() if lines and lines[0].strip() else None


def update_source():
    """The release source: GitHub, or the test-only source ("custom").
    {api, asset_base, page_base, custom, exact, insecure}: with GitHub (exact) an asset URL must
    be exactly <asset_base><tag>/<name> and the release page <page_base><tag>; with the test
    source both must lie below its scheme://host:port/ and end in /<tag>/<name> or /<tag>.
    insecure: redirects may lead to http:// (test source while FETCH_INSECURE_FLAG exists)."""
    custom = read_update_source()
    if custom is None:
        return {"api": UPDATE_API, "asset_base": UPDATE_ASSET_PREFIX, "page_base": UPDATE_PAGE_PREFIX,
                "custom": None, "exact": True, "insecure": False}
    insecure = fetch_insecure_allowed()
    allowed = ("https", "http") if insecure else ("https",)
    try:
        parts = urllib.parse.urlsplit(custom)
        valid = parts.port is None or parts.port > 0  # .port raises ValueError for a bad port
    except ValueError:
        parts, valid = None, False
    if (not valid or len(custom) > 2048 or RE_CTRL_ANY.search(custom) or " " in custom
            or parts.scheme not in allowed or not parts.hostname or "@" in parts.netloc):
        raise HelperError("The update source in %s is not a valid %s URL"
                          % (UPDATE_SOURCE_FLAG, " or ".join(allowed)))
    origin = "%s://%s/" % (parts.scheme, parts.netloc)
    return {"api": custom, "asset_base": origin, "page_base": origin, "custom": custom, "exact": False,
            "insecure": insecure}


def _update_url(value, source, what, tag, name=None):
    """A URL of the release answer: an asset `name` of the release `tag`, or (no name) the
    release page. It must have the scheme and host of the source, no query, fragment,
    percent-escape, backslash or whitespace, no empty, "." or ".." path segment, and its path
    must be exactly <base path><tag>[/<name>] (GitHub) or lie below the test source's origin and
    end in /<tag>[/<name>]. Plain string prefixes are not enough: dot segments would escape."""
    base = urllib.parse.urlsplit(source["asset_base"] if name else source["page_base"])
    tail = "%s/%s" % (tag, name) if name else tag
    try:
        parts = urllib.parse.urlsplit(value) if isinstance(value, str) else None
    except ValueError:
        parts = None
    path = parts.path if parts is not None else ""
    if source["exact"]:
        path_ok = path == base.path + tail
    else:
        path_ok = path.startswith(base.path) and path.endswith("/" + tail)
    if (parts is None or not path_ok or len(value) > 2048 or RE_CTRL_ANY.search(value)
            or re.search(r"[\s?#%\\]", value) or parts.scheme != base.scheme or parts.netloc != base.netloc
            or any(segment in ("", ".", "..") for segment in path.split("/")[1:])):
        raise HelperError("The release has an unexpected %s URL" % what)
    return value


class _UpdateRedirect(urllib.request.HTTPRedirectHandler):
    """Redirects of the updater's requests: https:// only (http:// only for the test source
    while FETCH_INSECURE_FLAG exists), at most UPDATE_MAX_REDIRECTS hops. The default handler
    would also follow http:// and ftp:// targets, which would void the HTTPS promise for the
    package and for SHA256SUMS alike."""
    max_redirections = UPDATE_MAX_REDIRECTS

    def __init__(self, insecure):
        urllib.request.HTTPRedirectHandler.__init__(self)
        self.insecure = insecure

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        scheme = urllib.parse.urlsplit(newurl).scheme
        if scheme != "https" and not (self.insecure and scheme == "http"):
            raise HelperError("The release source redirected to a URL that is not https://: %s"
                              % RE_CTRL_ANY.sub("", newurl)[:200])
        return urllib.request.HTTPRedirectHandler.redirect_request(self, req, fp, code, msg, headers, newurl)


def update_opener(source):
    """urllib opener of the updater (API answer and downloads): redirects are re-checked."""
    return urllib.request.build_opener(_UpdateRedirect(source["insecure"]))


def update_key(version, release):
    """Comparable (X, Y, Z, R) tuple of a version "X.Y.Z" and a package release R."""
    return tuple(int(part) for part in version.split(".")) + (int(release),)


def parse_update_full(value):
    """("X.Y.Z", R) of "X.Y.Z-R"."""
    match = RE_UPDATE_FULL.match(value) if isinstance(value, str) else None
    if not match:
        raise HelperError("Invalid version (expected X.Y.Z-R)")
    return match.group(1), int(match.group(2))


def parse_meta_xml(data):
    """(version, release, id) of a meta.xml document."""
    try:
        root = ElementTree.fromstring(data)
    except (ElementTree.ParseError, ValueError):
        raise HelperError("meta.xml cannot be parsed")
    version = (root.findtext("version") or "").strip()
    release = (root.findtext("release") or "").strip()
    if not RE_UPDATE_VERSION.match(version) or not re.match(r"^\d{1,6}$", release):
        raise HelperError("meta.xml has no valid version and release")
    return version, int(release), (root.findtext("id") or "").strip()


def installed_version():
    """(version, release) of the installed extension from Plesk's copy of its meta.xml; the
    helper's VERSION and release 0 when it cannot be read."""
    try:
        with open(INSTALLED_META, "rb") as fh:
            version, release, _ = parse_meta_xml(fh.read(UPDATE_META_MAX))
        return version, release
    except (OSError, HelperError):
        return VERSION, 0


def read_package_meta(path):
    """(version, release, id) from meta.xml of an extension package (zip)."""
    try:
        with zipfile.ZipFile(path) as archive:
            info = archive.getinfo("meta.xml")
            if info.file_size > UPDATE_META_MAX:
                raise HelperError("meta.xml of the package is too large")
            data = archive.read(info)
    except HelperError:
        raise
    except KeyError:
        raise HelperError("The package has no meta.xml")
    except Exception as exc:  # noqa: BLE001 - zipfile raises many types for broken archives
        raise HelperError("The package is not a valid zip archive: %s" % exc)
    return parse_meta_xml(data)


def parse_update_release(raw, source):
    """The validated release of a releases/latest answer, or None for a draft or prerelease:
    {tag, version, release, full, html_url, published_at, zip: {name, url, size}, sums_url}.
    The release notes (body) are not kept."""
    if not isinstance(raw, dict):
        raise HelperError("Unexpected answer from the release source")
    if raw.get("draft") or raw.get("prerelease"):
        return None
    tag = raw.get("tag_name")
    match = RE_UPDATE_TAG.match(tag) if isinstance(tag, str) else None
    if not match:
        raise HelperError("The latest release has an unexpected tag: %s" % str(tag)[:64])
    tag_version, tag_release = match.group(1), match.group(2)
    packages = []
    sums_url = None
    assets = raw.get("assets")
    for asset in assets if isinstance(assets, list) else []:
        name = asset.get("name") if isinstance(asset, dict) else None
        if not isinstance(name, str):
            continue
        found = RE_UPDATE_ZIP.match(name)
        if found and found.group(1) == tag_version and (tag_release is None or int(found.group(2)) == int(tag_release)):
            packages.append((found, asset))
        elif name == "SHA256SUMS":
            sums_url = _update_url(asset.get("browser_download_url"), source, "checksum", tag, name)
    if len(packages) != 1:
        raise HelperError("The latest release %s has no package runway-%s-<release>.zip that matches its tag"
                          % (tag, tag_version))
    if not sums_url:
        raise HelperError("The latest release %s has no SHA256SUMS file" % tag)
    found, asset = packages[0]
    size = asset.get("size")
    if isinstance(size, bool) or not isinstance(size, int) or size <= 0 or size > UPDATE_ZIP_MAX:
        raise HelperError("The package of the latest release %s has an unexpected size" % tag)
    published = raw.get("published_at")
    version, release = found.group(1), int(found.group(2))
    return {
        "tag": tag,
        "version": version,
        "release": release,
        "full": "%s-%d" % (version, release),
        "html_url": _update_url(raw.get("html_url"), source, "release page", tag),
        "published_at": published[:40] if isinstance(published, str) else None,
        "zip": {"name": asset["name"], "size": size,
                "url": _update_url(asset.get("browser_download_url"), source, "download", tag, asset["name"])},
        "sums_url": sums_url,
    }


def fetch_update_release(source):
    """The validated latest release; None when none is published yet (HTTP 404) or when it is a
    draft or prerelease. Other failures raise HelperError."""
    try:
        raw = http_json(source["api"], {"Accept": "application/vnd.github+json"}, timeout=UPDATE_API_TIMEOUT,
                        limit=1024 * 1024, opener=update_opener(source))
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return None
        if exc.code in (403, 429):
            raise HelperError("GitHub API rate limit reached; try again later")
        raise HelperError("The release source answered HTTP %d" % exc.code)
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as exc:
        raise HelperError("The release source cannot be reached: %s" % (getattr(exc, "reason", None) or exc))
    return parse_update_release(raw, source)


def read_update_cache():
    cache = read_json(UPDATE_CACHE, {})
    return cache if isinstance(cache, dict) else {}


def write_update_cache(cache):
    ensure_dir(CACHE_DIR, 0o700)
    write_json(UPDATE_CACHE, cache)


def _epoch(value):
    try:
        return float(value or 0)
    except (TypeError, ValueError):
        return 0.0


def update_status(cache=None):
    """Installed version, the cached result of the last check against the current source (no
    network) and the admin job."""
    if cache is None:
        cache = read_update_cache()
    custom = read_update_source()
    current = "source" in cache and cache.get("source") == custom
    version, release = installed_version()
    latest = cache.get("latest") if current and isinstance(cache.get("latest"), dict) else None
    available = False
    if latest:
        try:
            available = update_key(latest["version"], latest["release"]) > update_key(version, release)
        except (KeyError, TypeError, ValueError, AttributeError):
            latest = None
    return {
        "installed": "%s-%d" % (version, release),
        "installed_version": version,
        "installed_release": release,
        "latest": latest,
        "available": available,
        "checked_at": cache.get("checked_at") if current else None,
        "error": cache.get("error") if current else None,
        "update_source": custom,
        "last_failed_version": cache.get("last_failed_version"),
        "last_failed_at": cache.get("last_failed_at"),
        "job": job_get_status("admin"),
    }


def start_self_update(full):
    return start_admin_job("self-update", {"version": full}, "Update Runway to %s" % full,
                           title_key="self_update", title_params={"version": full})


def cmd_update_status(_payload):
    return update_status()


def cmd_update_check(payload):
    """Checks releases/latest unless the cache is fresh (12 hours; a forced check: 60 seconds).
    Failures are cached with checked_at as well. With auto_install, an available update starts
    the self-update job unless an admin job runs or the same version failed within 24 hours."""
    payload = payload or {}
    force = bool(payload.get("force"))
    source = update_source()
    custom = source["custom"]
    checked = False
    with FileLock("update"):
        cache = read_update_cache()
        same_source = "source" in cache and cache.get("source") == custom
        age = time.time() - _epoch(cache.get("checked_epoch"))
        if not same_source or not 0 <= age < (UPDATE_FORCE_MIN_AGE if force else UPDATE_CHECK_INTERVAL):
            cache.update({"source": custom, "checked_at": now_iso(), "checked_epoch": time.time()})
            try:
                cache["latest"] = fetch_update_release(source)
                cache["error"] = None
            except Exception as exc:  # noqa: BLE001 - cached, so a broken answer is not retried every run
                cache["error"] = str(exc) if isinstance(exc, HelperError) else "Unexpected release data: %s" % exc
                if not same_source:
                    cache["latest"] = None
            write_update_cache(cache)
            checked = True
    result = update_status(cache)
    result.update({"checked": checked, "started": False})
    latest = result["latest"]
    if payload.get("auto_install") and result["available"] and result["job"].get("state") not in ("queued", "running"):
        if (cache.get("last_failed_version") == latest["full"]
                and 0 <= time.time() - _epoch(cache.get("last_failed_epoch")) < UPDATE_RETRY_AFTER):
            result["auto_skipped"] = "Runway %s failed to install within the last 24 hours" % latest["full"]
        else:
            try:
                start_self_update(latest["full"])
                result["started"] = True
                result["job"] = job_get_status("admin")
            except HelperError as exc:
                result["auto_error"] = str(exc)
    return result


def cmd_update_install(payload):
    """Starts the self-update job for the version the administrator saw ("X.Y.Z-R")."""
    wanted = parse_update_full((payload or {}).get("version"))
    status = update_status()
    installed = (status["installed_version"], status["installed_release"])
    if update_key(*wanted) <= update_key(*installed):
        raise HelperError("Runway %s is installed; %s-%d is not newer" % (status["installed"], wanted[0], wanted[1]))
    latest = status["latest"]
    if not latest or not status["available"]:
        raise HelperError("No newer Runway release is available (installed: %s). Check for updates first."
                          % status["installed"])
    if update_key(*wanted) != update_key(latest["version"], latest["release"]):
        raise HelperError("Runway %s-%d is not the available update (%s): check for updates again."
                          % (wanted[0], wanted[1], latest["full"]))
    if status["job"].get("state") in ("queued", "running"):
        raise HelperError("Another background job (toolchain or update) is still running. "
                          "Please wait until it finishes.")
    result = start_self_update(latest["full"])
    result["version"] = latest["full"]
    return result


class _TailLog(object):
    """Job log wrapper that keeps the last bytes written (the output of a failed command)."""

    def __init__(self, log, keep=4000):
        self.log = log
        self.keep = keep
        self.tail = b""

    def write(self, data):
        if isinstance(data, str):
            data = data.encode("utf-8", "replace")
        self.log.write(data)
        self.tail = (self.tail + data)[-self.keep:]

    def line(self, text):
        self.log.line(text)

    def text(self):
        return self.tail.decode("utf-8", "replace").strip()


def job_self_update(args, log):
    """Admin job "self-update": records a failure in the update cache (automatic installation
    then waits 24 hours before it tries the same version again) and removes the downloads."""
    wanted = args.get("version")
    try:
        _self_update(wanted, log)
    except BaseException:
        try:
            with FileLock("update"):
                cache = read_update_cache()
                cache.update({"last_failed_version": wanted if isinstance(wanted, str) else None,
                              "last_failed_at": now_iso(), "last_failed_epoch": time.time()})
                write_update_cache(cache)
        except Exception:  # noqa: BLE001 - best effort: the job reports the original error
            pass
        raise
    finally:
        shutil.rmtree(UPDATE_WORK_DIR, ignore_errors=True)


def _self_update(wanted, log):
    version, release = parse_update_full(wanted)
    target = update_key(version, release)
    source = update_source()
    cache = read_update_cache()
    latest = cache.get("latest") if cache.get("source") == source["custom"] else None
    if not isinstance(latest, dict) or latest.get("full") != wanted:
        raise HelperError("Runway %s is no longer the latest release: check for updates again." % wanted)
    # The cached release is checked again against the current source.
    package = latest.get("zip") if isinstance(latest.get("zip"), dict) else {}
    name = package.get("name")
    found = RE_UPDATE_ZIP.match(name) if isinstance(name, str) else None
    tag = latest.get("tag")
    tag_match = RE_UPDATE_TAG.match(tag) if isinstance(tag, str) else None
    if (not found or update_key(found.group(1), found.group(2)) != target or not tag_match
            or tag_match.group(1) != version
            or (tag_match.group(2) is not None and int(tag_match.group(2)) != release)):
        raise HelperError("The cached release does not describe Runway %s: check for updates again." % wanted)
    zip_url = _update_url(package.get("url"), source, "download", tag, name)
    sums_url = _update_url(latest.get("sums_url"), source, "checksum", tag, "SHA256SUMS")
    opener = update_opener(source)
    current = installed_version()
    if target <= update_key(*current):
        raise HelperError("Runway %s-%d is installed; %s is not newer." % (current[0], current[1], wanted))
    log.line("Updating Runway %s-%d to %s (release %s)" % (current[0], current[1], wanted, latest.get("tag")))

    shutil.rmtree(UPDATE_WORK_DIR, ignore_errors=True)
    ensure_dir(CACHE_DIR, 0o700)
    ensure_dir(UPDATE_WORK_DIR, 0o700)
    sums_path = os.path.join(UPDATE_WORK_DIR, "SHA256SUMS")
    download(sums_url, sums_path, None, log, limit=UPDATE_SUMS_MAX, opener=opener)
    with open(sums_path, "r", encoding="utf-8", errors="replace") as fh:
        expected = parse_shasums(fh.read()).get(name)
    if not expected:
        raise HelperError("SHA256SUMS of the release has no checksum for %s" % name)
    zip_path = os.path.join(UPDATE_WORK_DIR, name)
    download(zip_url, zip_path, expected, log, limit=UPDATE_ZIP_MAX, opener=opener)
    package_version, package_release, package_id = read_package_meta(zip_path)
    if package_id != EXTENSION_ID or update_key(package_version, package_release) != target:
        raise HelperError("The package is not Runway %s (meta.xml: %s %s-%d)"
                          % (wanted, package_id or "?", package_version, package_release))
    log.line("Package verified: meta.xml of %s %s-%d" % (package_id, package_version, package_release))
    current = installed_version()
    if target <= update_key(*current):
        raise HelperError("Runway %s-%d is installed; %s is not newer." % (current[0], current[1], wanted))

    # The upgrade replaces this helper's files, including /opt/runway/bin/runway-helper that
    # this job runs from (by rename: the running process keeps its copy). Nothing in the
    # upgrade stops runway-job-admin.service or removes the job files.
    plesk = shutil.which("plesk", path=ROOT_PATH) or "/usr/sbin/plesk"
    log.line("Running: plesk bin extension --upgrade %s" % zip_path)
    output = _TailLog(log)
    code = stream_process([plesk, "bin", "extension", "--upgrade", zip_path], output,
                          UPDATE_INSTALL_TIMEOUT, root_env(), cwd="/")
    if code != 0:
        raise HelperError("plesk bin extension --upgrade failed (exit %d): %s"
                          % (code, output.text()[-1500:] or "no output"))
    current = installed_version()
    if update_key(*current) != target:
        raise HelperError("plesk bin extension --upgrade finished, but Plesk reports Runway %s-%d instead of %s"
                          % (current[0], current[1], wanted))
    with FileLock("update"):
        cache = read_update_cache()
        if cache.get("last_failed_version") == wanted:
            cache.update({"last_failed_version": None, "last_failed_at": None, "last_failed_epoch": None})
            write_update_cache(cache)
    log.line("Runway %s is installed. Reload the Runway pages in the browser to use it." % wanted)


# ---------------------------------------------------------------------------
# Commands: applications
# ---------------------------------------------------------------------------

def ensure_helper_copy():
    """Installs a stable copy of this helper for systemd units to reference."""
    ensure_dir(BASE_DIR)
    ensure_dir(BIN_DIR)
    source = os.path.realpath(__file__)
    if source == HELPER_COPY:
        return
    with open(source, "rb") as fh:
        content = fh.read()
    try:
        with open(HELPER_COPY, "rb") as fh:
            if fh.read() == content:
                return
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=BIN_DIR)
    with os.fdopen(fd, "wb") as fh:
        fh.write(content)
    os.chmod(tmp, 0o755)
    os.rename(tmp, HELPER_COPY)


def ensure_layout():
    ensure_dir(BASE_DIR)
    ensure_dir(GO_ROOT_DIR)
    ensure_dir(STATE_DIR, 0o700)
    ensure_dir(APPS_DIR, 0o700)
    ensure_dir(JOBS_DIR, 0o700)
    ensure_dir(LOCK_DIR, 0o700)
    ensure_dir(CACHE_DIR, 0o700)
    ensure_dir(CONF_DIR, 0o755)
    ensure_dir(ENV_DIR, 0o700)
    ensure_helper_copy()
    try:
        ensure_composer_wrapper()
    except OSError:
        pass


def trigger_mtimes(pw, app_dir):
    try:
        return call_as_user(pw, _user_trigger_mtimes, app_dir, timeout=10)
    except HelperError:
        return {"deploy": None, "restart": None}


def write_units(state, pw):
    """Renders the units and environment files of an application. Without zero-downtime slots
    exactly the 1.0 set (with its tmpfiles entry); with slots both slot units and their
    environment files, and the 1.0 unit while it is the live instance. The pointer (include files,
    root link, tmpfiles entry of a switchable application) is not written here (write_pointer(),
    under the deploy lock)."""
    domain_id = state["domain_id"]
    if not zd_has_slots(state):
        write_tmpfiles(state, pw)
        write_file_atomic(env_file_path(domain_id), render_env_file(state, pw), 0o600)
        write_file_atomic(os.path.join(UNIT_DIR, UNIT_APP % domain_id), render_app_unit(state, pw), 0o644)
    else:
        if not state.get("slot"):
            write_slot_units(state, pw, "")
        for slot in SLOTS:
            if state.get("listen") == "tcp" and not slot_port(state, slot):
                continue
            write_slot_units(state, pw, slot)
    write_file_atomic(os.path.join(UNIT_DIR, UNIT_DEPLOY % domain_id), render_deploy_service(state), 0o644)
    write_file_atomic(os.path.join(UNIT_DIR, UNIT_PATH % domain_id), render_deploy_path(state), 0o644)


def app_status(domain_id, state=None):
    pw = None
    if state:
        try:
            pw = pwd.getpwnam(str(state.get("sysuser")))
        except KeyError:
            pw = None
    if state and pw is not None and state.get("listen") == "unix":
        # Unix mode: a socket path that is not the application's own socket is contained at once
        # (docs/DESIGN.md section 7, "tampered"): nginx would follow a symbolic link elsewhere.
        found = socket_check(state, pw)
        if found and not state.get("tampered"):
            contain_tampering(state, found[0])
        elif found:
            unlink_socket_entry(domain_id, os.path.basename(found[2]["path"]))
    slots = bool(state) and zd_has_slots(state)
    live = (state.get("slot") or "") if state else ""
    units = [app_unit(domain_id, live), UNIT_DEPLOY % domain_id, UNIT_PATH % domain_id]
    others = [slot for slot in ("",) + SLOTS if slot != live] if slots else []
    props = ["LoadState", "ActiveState", "SubState", "MainPID", "ExecMainStartTimestamp",
             "NRestarts", "MemoryCurrent", "ControlGroup", "Result", "UnitFileState", "ActiveEnterTimestamp"]
    shown = unit_show(units + [app_unit(domain_id, slot) for slot in others], props)
    app = shown.get(units[0], {})
    memory = unit_memory(app)
    started = app.get("ExecMainStartTimestamp") or None
    status = {
        "configured": state is not None,
        "service": {
            "load_state": app.get("LoadState"),
            "active_state": app.get("ActiveState"),
            "sub_state": app.get("SubState"),
            "main_pid": int(app.get("MainPID") or 0),
            "started_at": started,
            "started_iso": systemd_time_iso(started),
            "restarts": int(app.get("NRestarts") or 0) if (app.get("NRestarts") or "").isdigit() else 0,
            # MemoryCurrent; memory_used_bytes and memory_cache_bytes split it (unit_memory).
            "memory_bytes": memory["memory_bytes"],
            "memory_used_bytes": memory["memory_used_bytes"],
            "memory_cache_bytes": memory["memory_cache_bytes"],
            "result": app.get("Result"),
            "enabled": app.get("UnitFileState"),
        },
        "watcher": {
            "active_state": shown.get(units[2], {}).get("ActiveState"),
            "enabled": shown.get(units[2], {}).get("UnitFileState"),
        },
        "deploy": job_get_status("deploy-%d" % domain_id),
    }
    if state:
        status["enabled"] = bool(state.get("enabled"))
        status["suspended"] = bool(state.get("suspended"))
        status["stopped"] = bool(state.get("stopped"))
        status["tampered"] = bool(state.get("tampered"))
        if state.get("tampered"):
            status["tampered_at"] = state.get("tampered_at") or None
            status["tampered_detail"] = state.get("tampered_detail") or ""
        status["listen_mode"] = state.get("listen", "tcp")
        status["mode"] = state.get("mode", "web")
        status["mount_path"] = state.get("mount_path", "")
        status["static_paths"] = state.get("static_paths", [])
        status["health_path"] = state.get("health_path", "")
        # Expected response content of the health check ("" while it is off).
        status["health_match"] = state.get("health_match") if isinstance(state.get("health_match"), str) else ""
        status["health"] = "unknown"
        status["health_detail"] = "" if state.get("health_path") else "No health check path configured"
        status["health_code"] = "" if state.get("health_path") else "no_path"
        status["health_params"] = {}
        # Health watch: null while it is off.
        status["health_watch"] = health_watch_status(domain_id, state)
        # Zero-downtime deployments (docs/DESIGN.md section 12.10).
        status["zero_downtime"] = bool(state.get("zero_downtime"))
        status["switchable"] = zd_switchable(state)
        status["slot"] = live
        status["switched_at"] = state.get("switched_at") or None
        status["restart_plain"] = bool(state.get("restart_plain"))
        status["switch"] = state.get("switch")
        status["ready_timeout"] = state.get("ready_timeout", ZD_READY_DEFAULT)
        status["drain_seconds"] = state.get("drain_seconds", ZD_DRAIN_DEFAULT)
        if slots:
            status["slots"] = {}
            for slot in ("",) + SLOTS:
                unit = app_unit(domain_id, slot)
                info = shown.get(unit, {})
                if info.get("LoadState") in (None, "not-found") and slot != live:
                    continue
                mem = unit_memory(info)
                start = info.get("ExecMainStartTimestamp") or None
                if state.get("listen") == "unix":
                    endpoint = slot_socket_path(domain_id, slot)
                elif state.get("listen") == "tcp" and slot_port(state, slot):
                    endpoint = "127.0.0.1:%d" % slot_port(state, slot)
                else:
                    endpoint = None
                status["slots"][slot] = {
                    "unit": unit, "active_state": info.get("ActiveState"), "sub_state": info.get("SubState"),
                    "main_pid": int(info.get("MainPID") or 0) if (info.get("MainPID") or "").isdigit() else 0,
                    "memory_bytes": mem["memory_bytes"], "memory_used_bytes": mem["memory_used_bytes"],
                    "memory_cache_bytes": mem["memory_cache_bytes"],
                    "started_iso": systemd_time_iso(start), "enabled": info.get("UnitFileState"),
                    "endpoint": endpoint, "live": slot == live,
                }
        deploy = status["deploy"]
        if isinstance(deploy, dict) and deploy.get("phase") and deploy.get("state") in ("queued", "running"):
            deploy["phase_elapsed"] = max(0, int(time.time() - float(deploy.get("phase_started_epoch") or time.time())))
    if state and state.get("port"):
        view = live_view(state) if slots else state
        status["port"] = (slot_port(state, live) or state["port"]) if slots and state.get("listen") == "tcp" else state["port"]
        if state.get("listen") == "unix":
            status["socket"] = endpoint_socket(view)
            if zd_switchable(state):
                status["proxy_socket"] = link_path(domain_id)
        if pw is not None:
            listener, detail, code, params = listener_info(view, pw)
        else:
            listener, detail, code, params = "none", "", "none", {}
        status["listener"] = listener
        status["listener_detail"] = detail
        status["listener_code"] = code
        status["listener_params"] = params
        status["listening"] = listener == "ok"
        if state.get("health_path"):
            (status["health"], status["health_detail"], status["health_code"],
             status["health_params"]) = health_check(view, listener, pw)
        if slots and pw is not None and state.get("listen") == "tcp" and state.get("zero_downtime") and not state.get("switch") \
                and not (isinstance(status["deploy"], dict) and status["deploy"].get("phase")):
            standby = slot_port(state, "a" if live == "b" else "b")
            if standby:
                uids = tcp_listener_uids(standby)
                if not uids:
                    status.update({"standby_listener": "none", "standby_detail": "nothing listens on 127.0.0.1:%d" % standby,
                                   "standby_code": "standby_none", "standby_params": {"port": standby}})
                elif uids == {pw.pw_uid}:
                    status.update({"standby_listener": "ok", "standby_detail": "the application's user listens on 127.0.0.1:%d" % standby,
                                   "standby_code": "standby_ok", "standby_params": {"port": standby}})
                else:
                    others = ", ".join(str(uid) for uid in sorted(uids - {pw.pw_uid}))
                    status.update({"standby_listener": "foreign",
                                   "standby_detail": "port %d of the next switch is held by uid %s; the switch uses another port" % (standby, others),
                                   "standby_code": "standby_foreign", "standby_params": {"port": standby, "uids": others}})
    return status


def health_check(state, listener, pw=None, timeout=HEALTH_TIMEOUT):
    """One HTTP GET of the health path (timeout: 2 s for the status, 5 s for the health watch;
    Host = domain): (healthy | unhealthy | unknown, detail, code, params). Only talks to an
    endpoint held by the application's own user (listener "ok"); a unix socket is opened without
    following a symbolic link (unix_connect). Without an expected response content only the status
    line is read (2xx/3xx: healthy); with one (health_match) the whole response is read within the
    same deadline (health_read_response) and a 2xx/3xx answer must also contain it
    (health_match_result)."""
    if listener != "ok":
        return "unknown", "The application is not listening", "not_listening", {}
    expect = health_expectation(state)
    try:
        host = state["domain"].encode("idna").decode("ascii")
    except (UnicodeError, ValueError):
        host = state["domain"].encode("ascii", "replace").decode("ascii")
    request = ("GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: runway-health/%s\r\nAccept: */*\r\n"
               "Connection: close\r\n\r\n" % (state["health_path"], host, VERSION)).encode("ascii", "replace")
    deadline = time.time() + timeout
    data = b""
    sock = None
    try:
        if state.get("listen") == "unix":
            if pw is None:
                pw = pwd.getpwnam(str(state.get("sysuser")))
            sock = unix_connect(endpoint_socket(state), pw.pw_uid, timeout)
        else:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            sock.connect(("127.0.0.1", int(state["port"])))
        sock.sendall(request)
        if expect is not None:
            data = health_read_response(sock, deadline)
        else:
            while b"\r\n" not in data and len(data) < 4096:
                remaining = deadline - time.time()
                if remaining <= 0:
                    raise socket.timeout("timed out")
                sock.settimeout(remaining)
                chunk = sock.recv(4096)
                if not chunk:
                    break
                data += chunk
    except (OSError, KeyError) as exc:
        error = str(exc) or type(exc).__name__
        return "unhealthy", "Health check failed: %s" % error, "failed", {"error": error}
    finally:
        if sock is not None:
            sock.close()
    match = re.match(br"^HTTP/\d(?:\.\d)?\s+(\d{3})", data)
    if not match:
        return "unhealthy", "Health check got no valid HTTP response", "no_http", {}
    code = int(match.group(1))
    if expect is not None and 200 <= code < 400:
        return health_match_result(expect, data, code, state["health_path"])
    return (("healthy" if 200 <= code < 400 else "unhealthy"), "HTTP %d from %s" % (code, state["health_path"]),
            "http", {"code": code, "path": state["health_path"]})


# ---------------------------------------------------------------------------
# Expected response content of the health check (opt-in, docs/DESIGN.md section 7, health_match)
#
# The response is untrusted output of a customer's application and this process runs as root:
# no regular expression is built from it or from the expected text, nothing is evaluated, the
# response is read up to HEALTH_BODY_MAX bytes within the check's deadline and json.loads()
# only ever sees that much (ValueError and RecursionError mean "not JSON"). The body never
# reaches a detail text or the params.
# ---------------------------------------------------------------------------

def _json_no_constant(name):
    """json.loads parse_constant: NaN and Infinity are not JSON (PHP's json_decode refuses them too)."""
    raise ValueError("%s is not JSON" % name)


def health_json_object(text):
    """The JSON object a text holds, or None (not JSON, nested too deeply, not an object)."""
    try:
        value = json.loads(text, parse_constant=_json_no_constant)
    except (ValueError, RecursionError):
        return None
    return value if isinstance(value, dict) else None


def health_expectation(state):
    """The expected response content of a state: None (off, or no health path), ("json", object)
    or ("text", UTF-8 bytes). app-status passes the stored state as it is, so anything that is not
    a valid value (validate_app refuses it) becomes ("json", None), which never matches."""
    value = state.get("health_match") if isinstance(state, dict) else None
    if not isinstance(value, str) or not state.get("health_path"):
        return None
    value = value.strip(HEALTH_MATCH_TRIM)
    if not value:
        return None
    if len(value) > HEALTH_MATCH_MAX or RE_CTRL_UNICODE.search(value):
        return ("json", None)
    if value.startswith("{"):
        return ("json", health_json_object(value))
    return ("text", value.encode("utf-8", "replace"))


def _http_header_end(data, start=0):
    """Offset of the body in a raw response (after the empty line that ends the headers; a bare
    LF is tolerated), -1 while it has not arrived."""
    ends = []
    crlf = data.find(b"\r\n\r\n", start)
    if crlf >= 0:
        ends.append(crlf + 4)
    lf = data.find(b"\n\n", start)
    if lf >= 0:
        ends.append(lf + 2)
    return min(ends) if ends else -1


def _http_headers(head):
    """{lower-case name: lower-case value} of the header block (status line skipped, 100 lines)."""
    headers = {}
    for line in head.replace(b"\r\n", b"\n").split(b"\n")[1:101]:
        name, sep, value = line.partition(b":")
        if sep:
            headers[name.strip().lower()] = value.strip().lower()
    return headers


def _http_content_length(headers):
    """The Content-Length of a response without chunked transfer coding, or None."""
    if b"chunked" in headers.get(b"transfer-encoding", b""):
        return None
    value = headers.get(b"content-length", b"")
    return int(value) if value.isdigit() and len(value) <= 12 else None


def health_read_response(sock, deadline):
    """Reads a health check response for the content check: status line, headers and body until
    the server closes the connection, the body of its Content-Length is complete or HEALTH_BODY_MAX
    bytes arrived. Every recv waits only for the time left until the deadline, so a server that
    sends slowly cannot extend it (socket.timeout)."""
    data = bytearray()
    limit = HEALTH_BODY_MAX
    body_at = -1
    while len(data) < limit:
        remaining = deadline - time.time()
        if remaining <= 0:
            raise socket.timeout("timed out")
        sock.settimeout(remaining)
        chunk = sock.recv(min(16384, limit - len(data)))
        if not chunk:
            break
        searched = max(0, len(data) - 3)
        data += chunk
        if body_at < 0:
            body_at = _http_header_end(data, searched)
            if body_at >= 0:
                length = _http_content_length(_http_headers(bytes(data[:body_at])))
                if length is not None:
                    limit = min(HEALTH_BODY_MAX, body_at + length)
    return bytes(data)


def _decode_chunked(data):
    """The body of a chunked transfer coding: what arrived when it is cut off (at the read limit or
    by the server), None when it is malformed."""
    parts = []
    pos = 0
    size_of = len(data)
    while pos < size_of:
        end = data.find(b"\n", pos, pos + 1024)
        if end < 0:
            # A size line cut off by the read limit, or one that is far too long.
            return b"".join(parts) if size_of - pos < 1024 else None
        size = data[pos:end].rstrip(b"\r").split(b";", 1)[0].strip()
        if not RE_CHUNK_SIZE.fullmatch(size):
            return None
        size = int(size, 16)
        pos = end + 1
        if size == 0:
            break
        parts.append(data[pos:pos + size])
        pos += size
        if pos >= size_of or data[pos:] == b"\r":
            break
        if data[pos:pos + 2] == b"\r\n":
            pos += 2
        elif data[pos:pos + 1] == b"\n":
            pos += 1
        else:
            return None
    return b"".join(parts)


def health_response_body(data):
    """The body of a raw health check response (chunked transfer coding decoded, cut to its
    Content-Length); b"" without the end of the headers, None for a malformed chunked coding."""
    body_at = _http_header_end(data)
    if body_at < 0:
        return b""
    headers = _http_headers(data[:body_at])
    body = data[body_at:]
    if b"chunked" in headers.get(b"transfer-encoding", b""):
        return _decode_chunked(body)
    length = _http_content_length(headers)
    return body[:length] if length is not None else body


def _json_same(expected, actual):
    """Equality of two JSON values with their JSON types: "1" is not 1 and true is not 1 (Python's
    True == 1 must not count); numbers compare by value; arrays and objects in full."""
    if isinstance(expected, bool) or isinstance(actual, bool):
        return isinstance(expected, bool) and isinstance(actual, bool) and expected == actual
    if isinstance(expected, (int, float)):
        return isinstance(actual, (int, float)) and expected == actual
    if expected is None:
        return actual is None
    if isinstance(expected, str):
        return isinstance(actual, str) and expected == actual
    if isinstance(expected, list):
        return (isinstance(actual, list) and len(expected) == len(actual)
                and all(_json_same(item, other) for item, other in zip(expected, actual)))
    if isinstance(expected, dict):
        return (isinstance(actual, dict) and len(expected) == len(actual)
                and all(key in actual and _json_same(value, actual[key]) for key, value in expected.items()))
    return False


def _json_contains(expected, actual):
    """Every key of the expected object is in the actual one with an equal value; nested objects are
    compared as subsets, everything else with _json_same."""
    if not isinstance(actual, dict):
        return False
    for key, value in expected.items():
        if key not in actual:
            return False
        if isinstance(value, dict):
            if not _json_contains(value, actual[key]):
                return False
        elif not _json_same(value, actual[key]):
            return False
    return True


def health_match_result(expect, data, code, path):
    """The result of a 2xx/3xx health check with an expected response content: healthy
    ("http_match") when the body contains it, else unhealthy ("body_mismatch", or "body_not_json"
    when a JSON object is expected and the body is none). The body never reaches the detail."""
    params = {"code": code, "path": path}
    mode, wanted = expect
    body = health_response_body(data)
    found = False
    if mode == "text":
        found = body is not None and wanted in body
    else:
        actual = None
        if body is not None:
            try:
                actual = health_json_object(body.decode("utf-8").lstrip("\ufeff"))
            except UnicodeDecodeError:
                actual = None
        if actual is None:
            return ("unhealthy", "HTTP %d from %s, the response is not a JSON object" % (code, path),
                    "body_not_json", params)
        try:
            found = wanted is not None and _json_contains(wanted, actual)
        except RecursionError:
            found = False
    if found:
        return "healthy", "HTTP %d from %s, expected content found" % (code, path), "http_match", params
    return "unhealthy", "HTTP %d from %s, expected content not found" % (code, path), "body_mismatch", params


# ---------------------------------------------------------------------------
# Health watch (opt-in per application, docs/DESIGN.md section 7)
# ---------------------------------------------------------------------------

def epoch_iso(value):
    """Epoch seconds -> '2026-11-13T07:00:00+00:00', None for anything else."""
    if not isinstance(value, (int, float)) or isinstance(value, bool) or value <= 0:
        return None
    return datetime.datetime.fromtimestamp(value, datetime.timezone.utc).replace(microsecond=0).isoformat()


def health_watch_path(domain_id):
    return os.path.join(HEALTH_WATCH_DIR, "%d.json" % domain_id)


def read_health_watch(domain_id):
    data = read_json(health_watch_path(domain_id))
    return data if isinstance(data, dict) else {}


def _recent_restarts(watch, now):
    return [t for t in watch.get("restarts") or []
            if isinstance(t, (int, float)) and not isinstance(t, bool) and 0 <= now - t < HEALTH_WATCH_WINDOW]


def health_watch_status(domain_id, state):
    """The "health_watch" object of app-status (null without the watch)."""
    if not isinstance(state, dict) or not state.get("health_watch"):
        return None
    watch = read_health_watch(domain_id)
    now = time.time()

    def number(key, default):
        value = state.get(key)
        return value if isinstance(value, int) and not isinstance(value, bool) else default

    return {
        "interval": number("health_interval", HEALTH_WATCH_INTERVAL_DEFAULT),
        "failures_limit": number("health_failures", HEALTH_WATCH_FAILURES_DEFAULT),
        "failures": int(watch.get("failures") or 0),
        "checked_iso": epoch_iso(watch.get("checked_epoch")),
        "result": watch.get("result") if watch.get("result") in ("healthy", "unhealthy", "skipped") else None,
        "detail": str(watch.get("detail") or "")[:300],
        "code": str(watch.get("code") or "")[:40],
        "params": watch.get("params") if isinstance(watch.get("params"), dict) else {},
        "restarts_last_hour": len(_recent_restarts(watch, now)),
        "max_restarts": HEALTH_WATCH_MAX_RESTARTS,
        "restarted_iso": epoch_iso(watch.get("restarted_epoch")),
        "restart_detail": str(watch.get("restart_detail") or "")[:300],
        "restart_code": str(watch.get("restart_code") or "")[:40],
        "restart_params": watch.get("restart_params") if isinstance(watch.get("restart_params"), dict) else {},
        "paused": bool(watch.get("paused")),
    }


def sync_health_units():
    """Installs and starts runway-health.timer while an application has the health watch on, and
    removes it (with its service) when none has: servers without it run nothing."""
    service_path = os.path.join(UNIT_DIR, UNIT_HEALTH)
    timer_path = os.path.join(UNIT_DIR, UNIT_HEALTH_TIMER)
    states = list(iter_app_states())
    for raw in states:
        # The failures and restarts of a watch that was turned off are forgotten.
        if not raw.get("health_watch") and isinstance(raw.get("domain_id"), int) and not isinstance(raw.get("domain_id"), bool):
            remove_quietly(health_watch_path(raw["domain_id"]))
    if not any(raw.get("health_watch") for raw in states):
        if os.path.exists(timer_path) or os.path.exists(service_path):
            systemctl("disable", "--now", UNIT_HEALTH_TIMER)
            remove_quietly(timer_path)
            remove_quietly(service_path)
            systemctl("daemon-reload")
            systemctl("reset-failed", UNIT_HEALTH, UNIT_HEALTH_TIMER)
        return False
    service = "\n".join([
        "# Managed by the Plesk Runway extension. Manual changes will be overwritten.",
        "[Unit]",
        "Description=Runway: health watch (restarts an application whose health check keeps failing)",
        "",
        "[Service]",
        "Type=oneshot",
        "ExecStart=%s _health" % HELPER_COPY,
        "TimeoutStartSec=600",
        "",
    ])
    timer = "\n".join([
        "# Managed by the Plesk Runway extension. Manual changes will be overwritten.",
        "[Unit]",
        "Description=Runway: health watch every %d seconds" % HEALTH_WATCH_TICK,
        "",
        "[Timer]",
        "OnActiveSec=%d" % HEALTH_WATCH_TICK,
        "OnUnitActiveSec=%d" % HEALTH_WATCH_TICK,
        "AccuracySec=1",
        "",
        "[Install]",
        "WantedBy=timers.target",
        "",
    ])
    changed = write_unit_file(service_path, service)
    changed = write_unit_file(timer_path, timer) or changed
    if changed:
        systemctl("daemon-reload")
    if changed or not unit_enabled(UNIT_HEALTH_TIMER) or not unit_is_active(UNIT_HEALTH_TIMER):
        systemctl("enable", "--now", UNIT_HEALTH_TIMER)
    return True


def internal_health(now_mode=False):
    """runway-health.service (every HEALTH_WATCH_TICK seconds): the health watch of every application
    that has it on. now_mode ("_health now", tests and by hand): every one of them at once, without
    the interval and the start grace. Prints what it did (the journal of runway-health.service)."""
    ensure_dir(HEALTH_WATCH_DIR, 0o700)
    watched = set()
    for raw in list(iter_app_states()):
        domain_id = raw.get("domain_id")
        if not isinstance(domain_id, int) or isinstance(domain_id, bool) or not raw.get("health_watch"):
            continue
        watched.add(domain_id)
        try:
            line = health_watch_app(domain_id, now_mode)
        except Exception as exc:  # noqa: BLE001 - one application must not stop the others
            line = "#%d: %s" % (domain_id, exc)
        if line:
            print(line, flush=True)
    for name in _listdir(HEALTH_WATCH_DIR):
        match = re.match(r"^(\d+)\.json$", name)
        if match and int(match.group(1)) not in watched:
            remove_quietly(os.path.join(HEALTH_WATCH_DIR, name))


def health_watch_app(domain_id, now_mode=False):
    """One application of the health watch when its check is due; never while a deployment, a
    save or a switch holds its deploy lock (they restart it themselves). Returns a log line."""
    watch = read_health_watch(domain_id)
    state, _pw = load_app_state(domain_id)
    if not state["health_watch"]:
        return None
    if not now_mode and time.time() - float(watch.get("checked_epoch") or 0) < state["health_interval"] - 2:
        return None
    lock = FileLock("deploy-%d" % domain_id)
    if unit_is_active(UNIT_DEPLOY % domain_id) or not lock.acquire(blocking=False):
        return None
    try:
        state, pw = load_app_state(domain_id)
        return _health_watch_locked(state, pw, watch, now_mode)
    finally:
        lock.release()


def _health_watch_locked(state, pw, watch, now_mode):
    domain_id = state["domain_id"]
    now = time.time()
    path = health_watch_path(domain_id)
    slots = zd_has_slots(state)
    unit = app_unit(domain_id, state["slot"]) if slots else UNIT_APP % domain_id
    view = live_view(state) if slots else state
    if not state["health_watch"] or not state["enabled"] or state["suspended"] or state["stopped"] or state["tampered"]:
        if watch.get("failures"):
            watch["failures"] = 0
            write_json(path, watch)
        return None
    info = unit_show([unit], ["ActiveState", "SubState", "ActiveEnterTimestampMonotonic"]).get(unit, {})
    if info.get("ActiveState") != "active" or info.get("SubState") != "running":
        # Not running: systemd restarts a crashed application itself (Restart=always), and a
        # starting one is not judged yet.
        if watch.get("failures"):
            watch["failures"] = 0
            write_json(path, watch)
        return None
    entered = info.get("ActiveEnterTimestampMonotonic") or ""
    entered = int(entered) if entered.isdigit() else 0
    instance = "%s@%d" % (unit, entered)
    if watch.get("instance") != instance:
        # Another instance (restarted by anybody): its failures start from zero.
        watch.update({"instance": instance, "failures": 0})
    if not now_mode and entered and time.monotonic() - entered / 1e6 < HEALTH_WATCH_GRACE:
        write_json(path, watch)
        return None
    listener, ldetail, lcode, lparams = listener_info(view, pw)
    if listener in ("foreign", "tampered"):
        # Another user holds the endpoint: a restart would not help (the status reports it).
        watch.update({"checked_epoch": now, "result": "skipped", "detail": ldetail, "code": lcode, "params": lparams})
        write_json(path, watch)
        return None
    result, detail, code, params = health_check(view, listener, pw, HEALTH_WATCH_TIMEOUT)
    healthy = result == "healthy"
    watch.update({"checked_epoch": now, "result": "healthy" if healthy else "unhealthy",
                  "detail": detail, "code": code, "params": params})
    if healthy:
        watch.update({"failures": 0, "paused": False})
        write_json(path, watch)
        return None
    watch["failures"] = int(watch.get("failures") or 0) + 1
    if watch["failures"] < state["health_failures"]:
        write_json(path, watch)
        return "#%d: health check failed (%d of %d in a row): %s" % (domain_id, watch["failures"], state["health_failures"], detail)
    restarts = _recent_restarts(watch, now)
    watch["restarts"] = restarts
    if len(restarts) >= HEALTH_WATCH_MAX_RESTARTS:
        if not watch.get("paused"):
            journal_note(domain_id, "health watch: %d failed health checks in a row (last: %s), but no restart: it "
                                    "restarted the application %d times within the last hour and restarts it again once "
                                    "the oldest of them is an hour ago." % (watch["failures"], detail, len(restarts)))
        watch["paused"] = True
        write_json(path, watch)
        return "#%d: not restarted (%d restarts within the last hour): %s" % (domain_id, len(restarts), detail)
    message = "health watch: restarting the application after %d failed health checks in a row (last: %s)." % (
        watch["failures"], detail)
    journal_note(domain_id, message)
    if slots:
        zd_plain_restart(state, pw)
    else:
        prepare_start(state, pw)
        systemctl("enable", unit, check=True)
        systemctl("reset-failed", unit)
        systemctl("restart", "--no-block", unit, check=True)
    restarts.append(now)
    watch.update({"restarts": restarts, "restarted_epoch": now, "restart_detail": detail, "restart_code": code,
                  "restart_params": params, "failures": 0, "paused": False, "instance": None})
    write_json(path, watch)
    return "#%d: %s" % (domain_id, message)


FLAG_KEYS = ("stopped", "tampered", "tampered_at", "tampered_detail")
CLEARED_FLAGS = {"stopped": False, "tampered": False, "tampered_at": "", "tampered_detail": ""}


def cmd_app_apply(payload):
    result = _app_apply(payload)
    # The health watch timer exists while an application has the watch on.
    sync_health_units()
    return result


def _app_apply(payload):
    payload = dict(payload or {})
    if "env" not in payload:
        # The panel omits "env" when it did not load/edit it: keep the stored secrets.
        stored = read_json(app_state_path(v_domain_id(payload.get("domain_id"))))
        payload["env"] = stored.get("env", {}) if isinstance(stored, dict) else {}
    state, pw = validate_app(payload)
    domain_id = state["domain_id"]
    restart = bool((payload or {}).get("restart", True))
    # start=false: enable the units but leave starting to a deploy job that builds first.
    start = bool((payload or {}).get("start", True))
    # resume=true: an explicit save by the user, which clears "stopped"/"tampered". Without it
    # (Reconcile, CLI) the flags of the stored state are kept: a stopped app stays stopped.
    resume = bool((payload or {}).get("resume"))
    if state["enabled"] and not state["suspended"] and state["toolchain"] \
            and not toolchain_installed(state["runtime"], state["toolchain"]):
        raise HelperError("%s toolchain '%s' is not installed on this server" % (RUNTIMES[state["runtime"]].label, state["toolchain"]))
    stored = read_json(app_state_path(domain_id))
    if state["zero_downtime"] or (isinstance(stored, dict) and (zd_has_slots(helper_fields(stored)) or stored.get("zero_downtime")
                                                                or slot_files_left(domain_id))):
        # Zero-downtime slots (docs/DESIGN.md section 12.5): the whole apply runs under the deploy
        # lock, so no switch, convergence or other writer of the pointer interleaves with it.
        lock = FileLock("deploy-%d" % domain_id)
        if not state["enabled"] or state["suspended"]:
            # Disabling or suspension ends a running deployment first (a switch finishes or rolls back).
            systemctl("disable", "--now", UNIT_PATH % domain_id)
            systemctl("stop", UNIT_DEPLOY % domain_id, timeout=ZD_DEPLOY_STOP + 30)
            if not lock.acquire(blocking=True, timeout=60):
                raise HelperError("Another operation of this application is still in progress. Please try again in a moment.")
        elif unit_is_active(UNIT_DEPLOY % domain_id) or not lock.acquire(blocking=False):
            raise HelperError("A deployment is running for this application. Wait until it finishes, then save again.")
        try:
            if isinstance(stored, dict) and helper_fields(stored)["switch"]:
                # An interrupted switch is settled from the pointer before anything is re-pointed
                # or stopped (the instance that carries the traffic must keep running).
                try:
                    current, current_pw = load_app_state(domain_id)
                    zd_converge_locked(current, current_pw)
                except HelperError:
                    pass
            return _zd_app_apply(state, pw, restart, start, resume)
        finally:
            lock.release()
    if not start and state["enabled"] and not state["suspended"] and unit_is_active(UNIT_DEPLOY % domain_id):
        raise HelperError("A deployment is running for this application. Wait until it finishes, then save again.")
    ensure_layout()
    if state["listen"] == "unix":
        web_server_group()
    # Runs as the customer: done before taking the global lock (it cannot be trusted to finish quickly).
    call_as_user(pw, _user_prepare_app_root, state["app_dir"])
    with FileLock("ports"):
        previous = read_json(app_state_path(domain_id))
        # The helper's own port wins over the panel's copy (stored_port()); the panel's port only
        # counts for an application without a stored state.
        state["port"] = allocate_port(domain_id, stored_port(previous) or state["port"], state["port_range"])
        for key in FLAG_KEYS:
            state[key] = previous.get(key, CLEARED_FLAGS[key]) if isinstance(previous, dict) and not resume \
                else CLEARED_FLAGS[key]
        state["updated_epoch"] = time.time()
        write_json(app_state_path(domain_id), state)
    if not previous or previous.get("app_dir") != state["app_dir"]:
        write_json(app_triggers_path(domain_id), trigger_mtimes(pw, state["app_dir"]))
    write_units(state, pw)
    if state["listen"] != "unix":
        remove_socket_dir(domain_id)
    systemctl("daemon-reload", check=True)
    app_unit, path_unit = UNIT_APP % domain_id, UNIT_PATH % domain_id
    if state["enabled"] and not state["suspended"]:
        if state["auto_deploy"]:
            systemctl("enable", path_unit, check=True)
            systemctl("restart", path_unit)
        else:
            systemctl("disable", "--now", path_unit)
        if state["stopped"]:
            # Stopped by the user (or contained by Runway): enabled for builds, but not running.
            systemctl("disable", "--now", app_unit, timeout=120)
        else:
            systemctl("enable", app_unit, check=True)
            if start and (restart or not unit_is_active(app_unit)):
                prepare_start(state, pw)
                systemctl("reset-failed", app_unit)
                systemctl("restart", "--no-block", app_unit)
    else:
        # Stop triggers first, then any running build (its cgroup is killed), then the app.
        systemctl("disable", "--now", path_unit)
        systemctl("stop", UNIT_DEPLOY % domain_id, timeout=150)
        systemctl("disable", "--now", app_unit)
    return {"port": state["port"], "state": state, "switchable": False, "job": None}


def _zd_app_apply(state, pw, restart, start, resume):
    """app-apply of an application that has, gets or had zero-downtime slots (the deploy lock is
    held): renders both slots, keeps the live instance running, writes the pointer, and starts
    the switch job for a restart (docs/DESIGN.md section 12.5)."""
    domain_id = state["domain_id"]
    ensure_layout()
    if state["listen"] == "unix":
        web_server_group()
    call_as_user(pw, _user_prepare_app_root, state["app_dir"])
    with FileLock("ports"):
        previous = read_json(app_state_path(domain_id))
        previous = previous if isinstance(previous, dict) else None
        # The helper's own port wins over the panel's copy (a switch may have given the 1.0 unit
        # a new one).
        state["port"] = allocate_port(domain_id, stored_port(previous) or state["port"], state["port_range"])
        for key in FLAG_KEYS:
            state[key] = previous.get(key, CLEARED_FLAGS[key]) if previous and not resume else CLEARED_FLAGS[key]
        state.update(helper_fields(previous))
        if previous and zd_has_slots(state) and (previous.get("listen") != state["listen"] or previous.get("sysuser") != state["sysuser"]
                                                 or previous.get("app_dir") != state["app_dir"]):
            # The web server configuration or the socket owner changes: the next restart is plain,
            # also while the 1.0 unit is still the live instance (a switch would leave the site
            # without a backend between Plesk's regeneration and the pointer move, and a new system
            # user does not own the running instance's socket).
            state["restart_plain"] = True
        if state["zero_downtime"] and state["listen"] == "tcp":
            if not state["port_a"]:
                state["port_a"] = state["port"]
            if not state["port_b"] or state["port_b"] in (state["port"], state["port_a"]):
                state["port_b"] = allocate_extra_port(domain_id, state["port_range"], {state["port"], state["port_a"]})
        elif not state["slot"]:
            state["port_a"] = state["port_b"] = 0
        state["updated_epoch"] = time.time()
        write_json(app_state_path(domain_id), state)
    if not previous or previous.get("app_dir") != state["app_dir"]:
        write_json(app_triggers_path(domain_id), trigger_mtimes(pw, state["app_dir"]))
    active = state["enabled"] and not state["suspended"]
    live = state["slot"]
    if live and (not state["zero_downtime"] or state["listen"] == "none") \
            and (not active or state["stopped"] or not unit_is_active(app_unit(domain_id, live))):
        # Turned off (or a worker now) while nothing runs: back to the 1.0 unit at once.
        state = retire_slots(state, pw)
        live = ""
    elif not zd_has_slots(state) and slot_files_left(domain_id):
        # Turned off before the first switch (the slots were rendered but never ran): their units
        # and environment files go now.
        state = retire_slots(state, pw)
    if zd_has_slots(state):
        ensure_converge_unit()
    write_units(state, pw)
    if pointer_wanted(state):
        if write_pointer(state, pw, live):
            web_unit, web_kind = web_traffic_server()
            if web_unit and config_references(state, "%s/%d." % (WEB_DIR, domain_id)):
                # The include is in use: the traffic reaches the live instance before any other
                # instance stops below.
                with FileLock("web-reload"):
                    web_reload_confirm(web_unit, web_kind)
    elif state["listen"] == "unix":
        write_tmpfiles(state, pw)
    if state["listen"] != "unix":
        remove_socket_dir(domain_id)
        remove_quietly(tmpfiles_path(domain_id))
    systemctl("daemon-reload", check=True)
    path_unit = UNIT_PATH % domain_id
    live_unit = app_unit(domain_id, live)
    others = [unit for unit in existing_app_units(domain_id) if unit != live_unit]
    job = None
    if active:
        if state["auto_deploy"]:
            systemctl("enable", path_unit, check=True)
            systemctl("restart", path_unit)
        else:
            systemctl("disable", "--now", path_unit)
        if state["stopped"]:
            # Stopped by the user (or contained by Runway): enabled for builds, but not running.
            systemctl("disable", "--now", *existing_app_units(domain_id), timeout=120)
        else:
            if others:
                systemctl("disable", "--now", *others, timeout=120)
            systemctl("enable", live_unit, check=True)
            running = unit_is_active(live_unit)
            if start and restart and running and not state["restart_plain"] and zd_switchable(state) and zd_target(state) is not None:
                job = start_deploy_job(domain_id, "restart", False)["job"]
            elif start and (restart or not running):
                state = zd_plain_restart(state, pw)[0]
    else:
        systemctl("disable", "--now", *existing_app_units(domain_id), timeout=120)
    return {"port": state["port"], "state": state, "switchable": zd_switchable(state), "job": job}


def cmd_app_remove(payload):
    domain_id = v_domain_id((payload or {}).get("domain_id"))
    remove_app(domain_id)
    return {"removed": domain_id}


def remove_app(domain_id):
    """Stops and deletes everything of an application: its units (the 1.0 unit and both
    zero-downtime slots), environment files, state, tmpfiles entry, socket directory, root link,
    web server include files and job files (the ports are free with the state file)."""
    units = [UNIT_PATH % domain_id, UNIT_DEPLOY % domain_id] + [
        unit for unit in all_app_units(domain_id)
        if unit == UNIT_APP % domain_id or os.path.exists(os.path.join(UNIT_DIR, unit))]
    systemctl("disable", "--now", *units, timeout=120)
    for unit in units:
        remove_quietly(os.path.join(UNIT_DIR, unit))
    for slot in ("",) + SLOTS:
        remove_quietly(env_file_path(domain_id, slot))
    remove_quietly(app_state_path(domain_id))
    remove_quietly(app_triggers_path(domain_id))
    remove_quietly(tmpfiles_path(domain_id))
    remove_socket_dir(domain_id)
    remove_link(domain_id)
    remove_include(domain_id)
    for path in job_paths("deploy-%d" % domain_id):
        remove_quietly(path)
    remove_quietly(health_watch_path(domain_id))
    systemctl("daemon-reload")
    systemctl("reset-failed", *units)
    sync_health_units()


def cmd_app_action(payload):
    """start | restart: explicit start (clears "stopped"/"tampered", enables and starts the unit);
    stop: stops and disables the unit and remembers it ("stopped": also across reboots, trigger
    files and deployments, until the next start); recover: restart of an application that hit
    systemd's start limit (Reconcile; refused for stopped applications)."""
    domain_id = v_domain_id((payload or {}).get("domain_id"))
    action = (payload or {}).get("action")
    state, pw = load_app_state(domain_id)
    if zd_has_slots(state):
        return _zd_app_action(state, pw, action, bool((payload or {}).get("plain")))
    unit = UNIT_APP % domain_id
    if action in ("start", "restart", "recover"):
        if not state["enabled"]:
            raise HelperError("The application is disabled")
        if state["suspended"]:
            raise HelperError("The domain is suspended")
        if action == "recover":
            if state["stopped"]:
                raise HelperError("The application is stopped")
        elif state["stopped"] or state["tampered"]:
            update_state_flags(domain_id, **CLEARED_FLAGS)
            state.update(CLEARED_FLAGS)
        prepare_start(state, pw)
        systemctl("enable", unit, check=True)
        systemctl("reset-failed", unit)
        systemctl("restart" if action == "restart" else "start", "--no-block", unit, check=True)
    elif action == "stop":
        update_state_flags(domain_id, stopped=True)
        systemctl("disable", "--now", unit, check=True, timeout=120)
    else:
        raise HelperError("Invalid action")
    return {"action": action}


def _zd_app_action(state, pw, action, plain):
    """app-action of an application with zero-downtime slots (docs/DESIGN.md section 12.5):
    restart of a running application starts the switch job ({action, job}); plain (Restart in
    place), start and recover act on the live unit; stop stops every app unit."""
    domain_id = state["domain_id"]
    if action == "stop":
        update_state_flags(domain_id, stopped=True)
        systemctl("disable", "--now", *existing_app_units(domain_id), check=True, timeout=120)
        return {"action": action}
    if action not in ("start", "restart", "recover"):
        raise HelperError("Invalid action")
    if not state["enabled"]:
        raise HelperError("The application is disabled")
    if state["suspended"]:
        raise HelperError("The domain is suspended")
    if action == "recover" and state["stopped"]:
        raise HelperError("The application is stopped")
    lock = FileLock("deploy-%d" % domain_id)
    busy = unit_is_active(UNIT_DEPLOY % domain_id) or not lock.acquire(blocking=False)
    try:
        if not busy and state["switch"]:
            # An interrupted switch is settled from the pointer first, so the instance that carries
            # the traffic is the one started or restarted (docs/DESIGN.md section 12.8).
            try:
                zd_converge_locked(state, pw)
            except HelperError:
                pass
            state, pw = load_app_state(domain_id)
        live_unit = app_unit(domain_id, state["slot"])
        if action == "restart" and (busy or plain or unit_is_active(live_unit)):
            if busy:
                raise HelperError("A deployment is already running for this application")
            if action != "recover" and (state["stopped"] or state["tampered"]):
                update_state_flags(domain_id, **CLEARED_FLAGS)
                state.update(CLEARED_FLAGS)
            if not plain and not state["restart_plain"] and zd_switchable(state) and zd_target(state) is not None:
                return {"action": action, "job": start_deploy_job(domain_id, "restart", False)["job"]}
            zd_plain_restart(state, pw)
            return {"action": action}
        if action != "recover" and (state["stopped"] or state["tampered"]):
            update_state_flags(domain_id, **CLEARED_FLAGS)
            state.update(CLEARED_FLAGS)
        if not busy:
            if not state["zero_downtime"] and state["slot"]:
                # Turned off and nothing runs: the 1.0 unit starts instead of the slot.
                zd_plain_restart(state, pw)
                return {"action": action}
            if pointer_wanted(state) and write_pointer(state, pw, state["slot"]):
                web_unit = web_traffic_server()[0]
                if web_unit:
                    with FileLock("web-reload"):
                        web_reload_nowait(web_unit)
        prepare_start(live_view(state), pw)
        systemctl("enable", live_unit, check=True)
        systemctl("reset-failed", live_unit)
        systemctl("restart" if action == "restart" else "start", "--no-block", live_unit, check=True)
        return {"action": action}
    finally:
        if not busy:
            lock.release()


DEPLOY_TITLES = {"build": "Build & restart", "restart": "Restart", "fetch": "Fetch & restart"}
# Titles of deployments of a stopped application (Stop persists): they build or fetch, but never start.
DEPLOY_TITLES_STOPPED = {"build": "Build (application stopped)",
                         "restart": "Restart skipped (application stopped)",
                         "fetch": "Fetch (application stopped)"}
DEPLOY_TITLE_KEYS_STOPPED = {"build": "deploy_build_only", "restart": "deploy_restart_skipped",
                             "fetch": "deploy_fetch_only"}


def deploy_title(mode, stopped):
    """(title, title_key) of a deploy job: the English title and the key the panel translates."""
    if stopped:
        return DEPLOY_TITLES_STOPPED[mode], DEPLOY_TITLE_KEYS_STOPPED[mode]
    return DEPLOY_TITLES[mode], "deploy_" + mode


def cmd_app_deploy(payload):
    payload = payload or {}
    domain_id = v_domain_id(payload.get("domain_id"))
    fetch = v_fetch(payload["fetch"]) if payload.get("fetch") else None
    mode = "fetch" if fetch else ("build" if bool(payload.get("build", True)) else "restart")
    state, _pw = load_app_state(domain_id)
    if not state["enabled"]:
        raise HelperError("The application is disabled")
    if state["suspended"]:
        raise HelperError("The domain is suspended")
    job = "deploy-%d" % domain_id
    unit = UNIT_DEPLOY % domain_id
    lock = FileLock(job)
    # The deploy job holds this lock while it runs; a running job means "busy".
    if unit_is_active(unit) or not lock.acquire(blocking=False):
        raise HelperError("A deployment is already running for this application")
    try:
        stopped = state["stopped"] or state["tampered"]
        if payload.get("start") and stopped:
            # "Build & restart" in the panel is an explicit start: it clears "stopped". Deploys
            # from the CLI, fetches and trigger files build a stopped application but keep it stopped.
            update_state_flags(domain_id, **CLEARED_FLAGS)
            systemctl("enable", app_unit(domain_id, state["slot"]))
            stopped = False
        return start_deploy_job(domain_id, mode, stopped, fetch)
    finally:
        lock.release()


def start_deploy_job(domain_id, mode, stopped, fetch=None):
    """Queues a request for the deploy unit and starts it (the caller holds the deploy lock)."""
    job = "deploy-%d" % domain_id
    unit = UNIT_DEPLOY % domain_id
    title, title_key = deploy_title(mode, stopped)
    ensure_helper_copy()
    _status_path, _log, request_path = job_paths(job)
    ensure_dir(JOBS_DIR, 0o700)
    request = {"mode": mode, "source": "panel"}
    if fetch:
        request["fetch"] = fetch
    write_json(request_path, request)
    job_set_status(job, state="queued", title=title, title_key=title_key, title_params={},
                   queued_at=now_iso(), queued_epoch=time.time(), started_at=None, finished_at=None, message=None,
                   phase="", slot_from=None, slot_to=None)
    systemctl("reset-failed", unit)
    proc = systemctl("start", "--no-block", unit)
    if proc.returncode != 0:
        remove_quietly(request_path)
        job_set_status(job, state="failed", finished_at=now_iso(), message=proc.stderr.strip())
        raise HelperError("Could not start deployment: %s" % proc.stderr.strip())
    return {"job": job}


# ---------------------------------------------------------------------------
# Fetch mode: download a prebuilt binary or an archive into the application root
# ---------------------------------------------------------------------------

def fetch_insecure_allowed():
    try:
        st = os.lstat(FETCH_INSECURE_FLAG)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == 0


def check_fetch_url(url, allow_insecure, resolve=True):
    """https only; with resolve, every address of the host must be public (no loopback, private,
    link-local or reserved ranges), so customers cannot reach internal services. This early check
    gives a clear error; the connection itself goes through _pinned_connect, which checks the
    addresses again and connects to exactly the address it checked (no DNS-rebinding window)."""
    if not isinstance(url, str) or not url or len(url) > 2048 or RE_CTRL_ANY.search(url) or " " in url:
        raise HelperError("Invalid download URL")
    try:
        parts = urllib.parse.urlsplit(url)
        port = parts.port
    except ValueError:
        raise HelperError("Invalid download URL")
    if parts.scheme != "https" and not (allow_insecure and parts.scheme == "http"):
        raise HelperError("Only https:// URLs can be fetched")
    if not parts.hostname or "@" in parts.netloc:
        raise HelperError("Invalid download URL (no host name, or credentials in the URL)")
    if not resolve or allow_insecure:
        return
    _public_addresses(parts.hostname, port or 443)


def _public_addresses(host, port):
    """getaddrinfo() of host, refusing the whole answer when any address is not public."""
    try:
        infos = socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM)
    except (socket.gaierror, UnicodeError) as exc:
        raise HelperError("Cannot resolve %s: %s" % (host, exc))
    for info in infos:
        address = ipaddress.ip_address(info[4][0].split("%")[0])
        if not address.is_global:
            raise HelperError("Refusing to download from a non-public address (%s)" % address)
    return infos


def _pinned_connector(allow_insecure):
    """socket.create_connection replacement for http.client: resolves the host once, checks every
    address and connects to one of the checked addresses. TLS still verifies the certificate
    against the host name (SNI), only the address lookup is pinned."""
    def connect(address, timeout=socket._GLOBAL_DEFAULT_TIMEOUT, source_address=None):
        if allow_insecure:
            return socket.create_connection(address, timeout, source_address)
        host, port = address[0], address[1]
        last = None
        for family, socktype, proto, _canon, sockaddr in _public_addresses(host, port):
            sock = None
            try:
                sock = socket.socket(family, socktype, proto)
                if timeout is not socket._GLOBAL_DEFAULT_TIMEOUT:
                    sock.settimeout(timeout)
                if source_address:
                    sock.bind(source_address)
                sock.connect(sockaddr)
                return sock
            except OSError as exc:
                last = exc
                if sock is not None:
                    sock.close()
        raise last if last is not None else OSError("Cannot connect to %s" % host)
    return connect


class _PinnedHTTPSHandler(urllib.request.HTTPSHandler):
    def __init__(self, allow_insecure):
        urllib.request.HTTPSHandler.__init__(self, context=ssl.create_default_context())
        self.allow_insecure = allow_insecure

    def https_open(self, req):
        connector = _pinned_connector(self.allow_insecure)

        def factory(host, **kwargs):
            conn = http.client.HTTPSConnection(host, **kwargs)
            conn._create_connection = connector
            return conn
        return self.do_open(factory, req, context=self._context)


class _PinnedHTTPHandler(urllib.request.HTTPHandler):
    """Plain http:// is only reachable with the root-only test flag (check_fetch_url)."""

    def __init__(self, allow_insecure):
        urllib.request.HTTPHandler.__init__(self)
        self.allow_insecure = allow_insecure

    def http_open(self, req):
        if not self.allow_insecure:
            raise HelperError("Only https:// URLs can be fetched")
        connector = _pinned_connector(self.allow_insecure)

        def factory(host, **kwargs):
            conn = http.client.HTTPConnection(host, **kwargs)
            conn._create_connection = connector
            return conn
        return self.do_open(factory, req)


class _FetchRedirect(urllib.request.HTTPRedirectHandler):
    """Re-checks every redirect target with check_fetch_url."""

    def __init__(self, allow_insecure):
        urllib.request.HTTPRedirectHandler.__init__(self)
        self.allow_insecure = allow_insecure

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        check_fetch_url(newurl, self.allow_insecure)
        return urllib.request.HTTPRedirectHandler.redirect_request(self, req, fp, code, msg, headers, newurl)


def v_fetch(value):
    if not isinstance(value, dict):
        raise HelperError("Invalid fetch request")
    url = str(value.get("url") or "").strip()
    sha = str(value.get("sha256") or "").strip().lower()
    if sha and not re.match(r"^[0-9a-f]{64}$", sha):
        raise HelperError("Invalid SHA-256 checksum (64 hexadecimal digits)")
    filename = str(value.get("filename") or "").strip()
    if filename and not RE_FETCH_NAME.match(filename):
        raise HelperError("Invalid file name")
    check_fetch_url(url, fetch_insecure_allowed(), resolve=False)
    return {"url": url, "sha256": sha, "extract": bool(value.get("extract")), "filename": filename,
            "build": bool(value.get("build"))}


def fetch_file_name(state, url):
    """A single downloaded file replaces ./<name> of the start command, else keeps the URL's
    file name, else becomes 'app'."""
    match = re.match(r"^\./([A-Za-z0-9_+-][A-Za-z0-9._+-]{0,127})(\s|$)", state.get("start_cmd") or "")
    if match:
        return match.group(1)
    name = os.path.basename(urllib.parse.urlsplit(url).path)
    return name if RE_FETCH_NAME.match(name) else "app"


def fetch_into_app(state, pw, spec, log):
    if not spec["extract"] and not spec["filename"]:
        spec["filename"] = fetch_file_name(state, spec["url"])
    log.line("Fetching %s as %s" % (spec["url"], pw.pw_name))
    result = call_as_user(pw, _user_fetch, state["app_dir"], spec, fetch_insecure_allowed(),
                          timeout=min(FETCH_TIMEOUT, state["build_timeout"]), fsize=4 * FETCH_MAX_BYTES)
    for message in result.get("messages") or []:
        log.line(message)


def _user_fetch(app_dir, spec, allow_insecure):
    """Runs as the customer: downloads spec["url"] into the application root (500 MB cap), verifies
    the SHA-256 when given, then saves it as an executable file or extracts the archive."""
    check_fetch_url(spec["url"], allow_insecure)
    # No proxies (the address check must apply to the real peer), pinned address lookups and a
    # scheme/address re-check of every redirect target.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _PinnedHTTPSHandler(allow_insecure),
                                         _PinnedHTTPHandler(allow_insecure), _FetchRedirect(allow_insecure))
    request = urllib.request.Request(spec["url"], headers={"User-Agent": USER_AGENT})
    fd, tmp = tempfile.mkstemp(prefix=".runway-fetch-", dir=app_dir)
    messages = []
    digest = hashlib.sha256()
    total = 0
    limit = "The download is larger than %d MB" % (FETCH_MAX_BYTES // 1048576)
    try:
        with os.fdopen(fd, "wb") as out:
            with opener.open(request, timeout=HTTP_TIMEOUT) as resp:
                final_url = resp.geturl()
                length = resp.headers.get("Content-Length") or ""
                if length.isdigit() and int(length) > FETCH_MAX_BYTES:
                    raise HelperError(limit)
                while True:
                    chunk = resp.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > FETCH_MAX_BYTES:
                        raise HelperError(limit)
                    digest.update(chunk)
                    out.write(chunk)
        sha = digest.hexdigest()
        messages.append("Downloaded %.1f MiB from %s" % (total / 1048576.0, final_url))
        if spec.get("sha256"):
            if sha != spec["sha256"]:
                raise HelperError("SHA-256 mismatch: expected %s, got %s" % (spec["sha256"], sha))
            messages.append("SHA-256 verified")
        else:
            messages.append("SHA-256 %s (not verified: no checksum given)" % sha)
        if spec.get("extract"):
            with open(tmp, "rb") as fh:
                magic = fh.read(4)
            if magic[:2] == b"\x1f\x8b":
                count = _user_extract_tar(tmp, app_dir)
            elif magic == b"PK\x03\x04":
                count = _user_extract_zip(tmp, app_dir)
            else:
                raise HelperError("Unsupported archive format (expected .tar.gz or .zip)")
            messages.append("Extracted %d entries into %s" % (count, app_dir))
        else:
            dest = os.path.join(app_dir, spec["filename"])
            if os.path.islink(dest) or os.path.isdir(dest):
                raise HelperError("%s is a directory or a symbolic link" % spec["filename"])
            os.chmod(tmp, 0o750)
            os.rename(tmp, dest)
            tmp = None
            messages.append("Saved as %s (executable)" % spec["filename"])
    finally:
        if tmp:
            remove_quietly(tmp)
    return {"messages": messages, "bytes": total, "sha256": sha}


def _unsafe_archive_path(name):
    """Member names that could leave the extraction directory: absolute, with ".." segments or
    backslashes (the shape of this check is also what CodeQL's TarSlip query recognises)."""
    return name.startswith("/") or "\\" in name or ".." in name.split("/")


def _user_extract_tar(archive, dest):
    with tarfile.open(archive, "r:*") as tar:
        members = []
        total = 0
        for member in tar:
            name = member.name
            while name.startswith("./"):
                name = name[2:]
            if name in ("", "."):
                continue
            member.name = name
            if _unsafe_archive_path(member.name):
                raise HelperError("Refusing to extract suspicious archive member: %s" % name[:200])
            if member.isdev() or not (member.isfile() or member.isdir() or member.issym() or member.islnk()):
                raise HelperError("Refusing to extract suspicious archive member: %s" % name[:200])
            if (member.issym() or member.islnk()) and not _link_inside(name, member.linkname, member.islnk()):
                raise HelperError("Refusing to extract a link that leaves the archive: %s" % name[:200])
            total += max(member.size, 0)
            if len(members) >= 100000 or total > 4 * FETCH_MAX_BYTES:
                raise HelperError("The archive is too large to extract")
            members.append(member)
        if hasattr(tarfile, "data_filter"):
            tar.extractall(dest, members=members, filter="data")
        else:
            tar.extractall(dest, members=members)  # nosec - members checked above
    return len(members)


def _user_extract_zip(archive, dest):
    count = 0
    with zipfile.ZipFile(archive) as zf:
        infos = zf.infolist()
        if len(infos) > 100000 or sum(info.file_size for info in infos) > 4 * FETCH_MAX_BYTES:
            raise HelperError("The archive is too large to extract")
        for info in infos:
            if _unsafe_archive_path(info.filename):
                raise HelperError("Refusing to extract suspicious archive member: %s" % info.filename[:200])
        for info in infos:
            mode = info.external_attr >> 16
            if stat.S_ISLNK(mode):
                continue  # symbolic links are not restored from zip archives
            path = zf.extract(info, dest)
            if not info.is_dir() and mode & 0o111:
                os.chmod(path, 0o750)  # zipfile does not restore Unix modes
            count += 1
    return count


def cmd_app_config(payload):
    domain_id = v_domain_id((payload or {}).get("domain_id"))
    state = read_json(app_state_path(domain_id))
    if not isinstance(state, dict):
        return {"config": None}
    return {"config": {"env": state.get("env") or {}, "port": state.get("port"), "app_dir": state.get("app_dir")}}


def cmd_app_page(payload):
    """Everything the domain page needs, in a single helper invocation."""
    payload = payload or {}
    domain_id = v_domain_id(payload.get("domain_id"))
    state = read_json(app_state_path(domain_id))
    state = state if isinstance(state, dict) else None
    result = {
        "toolchains": dict((key, toolchain_list(key)) for key in RUNTIME_KEYS),
        "build_deps": build_deps_status(),
        "config": {"env": (state.get("env") or {})} if state else None,
        "status": app_status(domain_id, state),
    }
    try:
        pw = v_sysuser(payload.get("sysuser"))
        _rel, app_dir = v_app_root(payload.get("app_root"), pw.pw_dir)
        inspect = call_as_user(pw, _user_inspect_app_root, app_dir,
                               v_document_roots(payload.get("document_roots"), pw.pw_dir))
        inspect["path"] = app_dir
        inspect["home"] = pw.pw_dir
        result["inspect"] = inspect
    except HelperError as exc:
        result["inspect"] = {"error": str(exc)}
    stored = state or {}
    listen = payload.get("listen") or stored.get("listen") or "tcp"
    listen = listen if listen in LISTEN_MODES else "tcp"
    runtime = payload.get("runtime") or stored.get("runtime")
    chosen = payload.get("toolchain") or (stored.get("toolchain") if stored.get("runtime") == runtime else "") or ""
    result["defaults"] = {}
    for key in RUNTIME_KEYS:
        toolchain = str(chosen) if key == runtime else ""
        if not toolchain and key == "php":
            toolchain = (result["toolchains"].get("php") or [{}])[0].get("id", "")
        result["defaults"][key] = runtime_defaults(key, result["inspect"], listen, toolchain)
        # Defaults for the other listen modes (and toolchains), so the form can follow a change
        # without another request: variants["<listen>|<toolchain>"], toolchain "" unless the
        # runtime's defaults depend on it.
        toolchain_ids = [""]
        if RUNTIMES[key].defaults_per_toolchain:
            toolchain_ids += [item["id"] for item in result["toolchains"].get(key) or [] if item.get("id")]
        variants = {}
        for mode in ("tcp", "unix"):
            for tc in toolchain_ids:
                variant = runtime_defaults(key, result["inspect"], mode, tc or (toolchain if not toolchain_ids[1:] else ""))
                variant.pop("listen", None)
                variants["%s|%s" % (mode, tc)] = variant
        result["defaults"][key]["variants"] = variants
    return result


def _user_write_sample(app_dir, files, force):
    """Runs as the customer: writes the sample files without following symbolic links."""
    entries = _scan_names(app_dir, 5, count_cap=6, skip=("tmp",))[0]
    if entries and not force:
        raise HelperError("The application root is not empty (%s). Remove the files first or overwrite them."
                          % ", ".join(sorted(entries)), code="not_empty")
    written = []
    for rel in sorted(files):
        content, mode = files[rel]
        path = os.path.join(app_dir, rel)
        os.makedirs(os.path.dirname(path), 0o750, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
        with os.fdopen(fd, "w") as fh:
            os.fchmod(fh.fileno(), mode)
            fh.write(content)
        written.append(rel)
    return written


def cmd_app_sample(payload):
    """Writes the runtime's minimal HTTP sample app into the application root, as the user.
    Refuses a non-empty application root unless "force" is set."""
    payload = payload or {}
    v_domain_id(payload.get("domain_id"))
    pw = v_sysuser(payload.get("sysuser"))
    _rel, app_dir = v_app_root(payload.get("app_root"), pw.pw_dir)
    rt = RUNTIMES[v_runtime(payload.get("runtime"))]
    listen = payload.get("listen") or rt.default_listen
    if listen not in LISTEN_MODES:
        raise HelperError("Invalid listen mode")
    toolchain = v_toolchain(rt.key, payload.get("toolchain"))
    if not toolchain and rt.toolchain != "none":
        installed = [item["id"] for item in toolchain_list(rt.key)]
        if rt.key == "php" and listen == "unix":
            installed = [t for t in installed if t.startswith("frankenphp-")] or installed
        toolchain = installed[0] if installed else ""
    if listen == "unix" and rt.unix_toolchain_re and not re.match(rt.unix_toolchain_re, toolchain or ""):
        raise HelperError("The %s sample can listen on a unix socket only with a %s toolchain; install one "
                          "or choose TCP." % (rt.label, "FrankenPHP" if rt.key == "php" else rt.unix_toolchain_re),
                          code="unix_unsupported")
    files = rt.sample(listen, toolchain)
    if not files:
        raise HelperError("There is no sample app for the %s runtime" % rt.label)
    call_as_user(pw, _user_prepare_app_root, app_dir)
    written = call_as_user(pw, _user_write_sample, app_dir, files, bool(payload.get("force")))
    inspect = call_as_user(pw, _user_inspect_app_root, app_dir)
    return {"written": written, "toolchain": toolchain,
            "defaults": runtime_defaults(rt.key, inspect, listen, toolchain)}


def cmd_app_status(payload):
    domain_id = v_domain_id((payload or {}).get("domain_id"))
    state = read_json(app_state_path(domain_id))
    return app_status(domain_id, state if isinstance(state, dict) else None)


def cmd_app_logs(payload):
    domain_id = v_domain_id((payload or {}).get("domain_id"))
    lines = v_int((payload or {}).get("lines", 200), 1, 2000, "lines")
    kind = (payload or {}).get("kind", "app")
    if kind == "deploy":
        return {"log": tail_file(job_paths("deploy-%d" % domain_id)[1], lines)}
    if kind != "app":
        raise HelperError("Invalid log kind")
    # Newest first, so the byte budget keeps the most recent entries; reversed afterwards. Both
    # zero-downtime slots write their own journal identifier (runway-app-<id>-a/-b): merged by time.
    cmd = ["journalctl"]
    for unit in all_app_units(domain_id):
        cmd += ["-u", unit]
    text = capped_output(cmd + ["-n", str(lines), "-r", "--no-pager", "-o", "short-iso", "--no-hostname"])
    return {"log": "\n".join(reversed(text.splitlines()))}


def capped_output(cmd, max_bytes=LOG_READ_CAP, timeout=60):
    """Runs cmd and returns at most max_bytes of its output, each line capped to LOG_LINE_CAP."""
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            stdin=subprocess.DEVNULL, env=root_env())
    data = bytearray()
    deadline = time.time() + timeout
    fd = proc.stdout.fileno()
    try:
        while len(data) < max_bytes:
            remaining = deadline - time.time()
            if remaining <= 0:
                break
            ready, _, _ = select.select([fd], [], [], min(remaining, 1.0))
            if not ready:
                continue
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
    finally:
        if proc.poll() is None:
            proc.kill()
        proc.wait()
        proc.stdout.close()
    lines = data[:max_bytes].decode("utf-8", "replace").splitlines()
    return "\n".join(line if len(line) <= LOG_LINE_CAP else line[:LOG_LINE_CAP] + " [...]" for line in lines)


def cmd_app_inspect(payload):
    payload = payload or {}
    pw = v_sysuser(payload.get("sysuser"))
    _rel, app_dir = v_app_root(payload.get("app_root"), pw.pw_dir)
    result = call_as_user(pw, _user_inspect_app_root, app_dir, v_document_roots(payload.get("document_roots"), pw.pw_dir))
    result["path"] = app_dir
    result["home"] = pw.pw_dir
    return result


def cmd_docroot_check(payload):
    """Checks a document root before the panel asks Plesk to use it: as the system user, it must
    stay inside the home directory with symbolic links resolved and, when it exists, be a directory
    (codes docroot_outside, docroot_not_dir). Changes nothing."""
    payload = payload or {}
    pw = v_sysuser(payload.get("sysuser"))
    rel, absolute = v_document_root(payload.get("document_root"), pw.pw_dir)
    result = call_as_user(pw, _user_check_document_root, absolute, pw.pw_dir)
    result["document_root"] = rel
    return result


def cmd_docroot_access(payload):
    """After the panel changed a document root through Plesk: lets the web server group pass the
    directories from the home directory down to it (o+x where needed, as the system user)."""
    payload = payload or {}
    pw = v_sysuser(payload.get("sysuser"))
    rel, absolute = v_document_root(payload.get("document_root"), pw.pw_dir)
    try:
        web_gid = grp.getgrnam(WEB_GROUP).gr_gid
    except KeyError:
        web_gid = -1
    result = call_as_user(pw, _user_open_document_root, absolute, pw.pw_dir, web_gid)
    result["document_root"] = rel
    return result


def cmd_app_docroot(payload):
    """The domain's document root as Plesk has it now (docs/DESIGN.md section 6): the panel sends it
    after it changed the document root on the Runway page (open: true), Reconcile when the stored
    copy differs from Plesk's (open: false). Stores it in the application's state like app-apply
    ("" for workers and invalid values) and, with open, makes the files in it readable for the web
    server when it lies inside the application root (open_public_files; a failure is reported in
    "public", the state is stored anyway). Without a state: configured false, nothing changes."""
    payload = payload or {}
    domain_id = v_domain_id(payload.get("domain_id"))
    nothing = {"configured": False, "document_root": "", "public": None}
    if not isinstance(read_json(app_state_path(domain_id)), dict):
        return nothing
    state, pw = load_app_state(domain_id)
    rel = v_state_document_root(payload.get("document_root"), pw.pw_dir) if state["listen"] != "none" else ""
    with FileLock("ports"):
        stored = read_json(app_state_path(domain_id))
        if not isinstance(stored, dict):
            return nothing
        if stored.get("document_root") != rel:
            stored["document_root"] = rel
            write_json(app_state_path(domain_id), stored)
    state["document_root"] = rel
    public = None
    if payload.get("open"):
        try:
            public = open_public_files(state, pw)
        except HelperError as exc:
            public = {"error": str(exc)}
    return {"configured": True, "document_root": rel, "public": public}


def cmd_apps_list(payload):
    """Every application with the state of its live unit. converge: true (the panel's scheduled
    Reconcile only) also repairs zero-downtime slots and pointers (docs/DESIGN.md section 12.8)."""
    converge = bool((payload or {}).get("converge"))
    states = list(iter_app_states())
    for state in states:
        if not isinstance(state.get("domain_id"), int):
            continue
        if converge and zd_needs_converge(state):
            try:
                zd_converge(state)
            except Exception as exc:  # noqa: BLE001 - one application must not stop the list
                journal_note(state["domain_id"], "the convergence failed: %s" % exc)
        # Unix mode: contain a tampered socket path (docs/DESIGN.md section 7). Reconcile calls
        # apps-list every 10 minutes, so the check also runs when nobody looks at the panel.
        if state.get("listen") != "unix":
            continue
        try:
            pw = pwd.getpwnam(str(state.get("sysuser")))
        except KeyError:
            continue
        found = socket_check(state, pw)
        if found and not state.get("tampered"):
            contain_tampering(state, found[0])
        elif found:
            unlink_socket_entry(state["domain_id"], os.path.basename(found[2]["path"]))
    if converge:
        states = list(iter_app_states())
    units = []
    for state in states:
        live = state.get("slot") if state.get("slot") in SLOTS else ""
        units.append(app_unit(int(state["domain_id"]), live))
    extra = [app_unit(int(s["domain_id"]), slot) for s in states if zd_has_slots(helper_fields(s)) or s.get("zero_downtime")
             for slot in ("",) + SLOTS]
    shown = unit_show(list(dict.fromkeys(units + extra)),
                      ["ActiveState", "SubState", "MemoryCurrent", "ControlGroup", "Result", "NRestarts"])
    apps = []
    for state, unit in zip(states, units):
        info = shown.get(unit, {})
        memory = unit_memory(info)
        fields = helper_fields(state)
        slots = zd_has_slots(dict(state, **fields))
        if slots:
            # Both versions run during a switch: the application's memory is their sum (per field;
            # a slot without a readable memory.stat adds its MemoryCurrent to the used memory).
            total = dict.fromkeys(memory)
            for slot in ("",) + SLOTS:
                for key, value in unit_memory(shown.get(app_unit(int(state["domain_id"]), slot), {})).items():
                    if value is not None:
                        total[key] = (total[key] or 0) + value
            if total["memory_bytes"] is not None:
                memory = total
        live_port = state.get("port")
        if slots and state.get("listen") == "tcp":
            view = dict(state, **fields)
            live_port = slot_port(view, fields["slot"]) or state.get("port")
        apps.append({
            "domain_id": state.get("domain_id"),
            "domain": state.get("domain"),
            "runtime": state.get("runtime"),
            "toolchain": state.get("toolchain"),
            "port": state.get("port"),
            "live_port": live_port,
            "zero_downtime": bool(state.get("zero_downtime")),
            "switchable": state.get("listen") in ("tcp", "unix") and slots,
            "slot": fields["slot"],
            "port_a": fields["port_a"],
            "port_b": fields["port_b"],
            "switching": bool(fields["switch"]),
            "enabled": state.get("enabled"),
            "listen": state.get("listen", "tcp"),
            "mode": state.get("mode", "web"),
            # The stored copy of the document root (Reconcile sends Plesk's when it differs).
            "document_root": state.get("document_root") if isinstance(state.get("document_root"), str) else "",
            "updated_epoch": state.get("updated_epoch"),
            "suspended": bool(state.get("suspended")),
            "stopped": bool(state.get("stopped")),
            "tampered": bool(state.get("tampered")),
            "sysuser": state.get("sysuser"),
            "app_dir": state.get("app_dir"),
            "home_changed": _home_changed(state),
            "active_state": info.get("ActiveState"),
            "sub_state": info.get("SubState"),
            "result": info.get("Result"),
            # systemd gave up (start limit): "start-limit-hit" for manual starts, while the
            # automatic restarts of systemd 255 end "failed" with the last exit result.
            "start_limit_hit": info.get("ActiveState") == "failed" and (
                info.get("Result") == "start-limit-hit"
                or int(info.get("NRestarts") or 0 if (info.get("NRestarts") or "").isdigit() else 0) >= APP_START_LIMIT_BURST),
            "memory_bytes": memory["memory_bytes"],
            "memory_used_bytes": memory["memory_used_bytes"],
            "memory_cache_bytes": memory["memory_cache_bytes"],
        })
    return {"apps": apps, "reconcile_paused": reconcile_paused()}


def reconcile_paused():
    """True while the root-only test flag RECONCILE_PAUSE_FLAG exists and is younger than one
    hour (a forgotten flag cannot disable the clean-up for good)."""
    try:
        st = os.lstat(RECONCILE_PAUSE_FLAG)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == 0 and time.time() - st.st_mtime < RECONCILE_PAUSE_MAX


def _home_changed(state):
    """True when the stored absolute app directory no longer matches the system user's
    home (subscription renamed) or the system user no longer exists."""
    try:
        home = pwd.getpwnam(str(state.get("sysuser"))).pw_dir
    except KeyError:
        return True
    return state.get("app_dir") != os.path.normpath(home) + "/" + str(state.get("app_root"))


RE_PRIVILEGED_EXEC = re.compile(r"^\s*Exec[A-Za-z]*\s*=\s*[-@:+!]*[+!]")


def _strip_privileged_exec(path):
    """Removes Exec lines that run as root ("+"/"!" prefix) from a unit file of an older version
    whose state cannot be re-rendered (e.g. its stored variables are no longer valid)."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return False
    kept = [line for line in lines if not RE_PRIVILEGED_EXEC.match(line)]
    if len(kept) == len(lines):
        return False
    write_file_atomic(path, "\n".join(kept) + "\n", 0o644)
    return True


def _sanitize_stored_env(raw):
    """Drops variables that are no longer allowed (RESERVED_ENV, LOADER_ENV) from a stored state
    of an older version and saves it. Returns the dropped names."""
    env = raw.get("env")
    if not isinstance(env, dict):
        return []
    dropped = sorted(key for key in env if key in RESERVED_ENV or key in LOADER_ENV)
    if dropped and isinstance(raw.get("domain_id"), int):
        for key in dropped:
            env.pop(key, None)
        with FileLock("ports"):
            stored = read_json(app_state_path(raw["domain_id"]))
            if isinstance(stored, dict):
                stored["env"] = env
                write_json(app_state_path(raw["domain_id"]), stored)
    return dropped


def cmd_reapply_all(_payload):
    """Re-renders unit files, environment files and tmpfiles entries of every configured app and
    prepares the socket directories (used after an extension upgrade; running services keep
    running and pick the changes up at their next restart). Errors are reported per app."""
    ensure_layout()
    count = 0
    errors = []
    for raw in list(iter_app_states()):
        domain_id = raw.get("domain_id")
        try:
            dropped = _sanitize_stored_env(raw)
            if dropped:
                errors.append("#%s: removed %s from the environment variables (no longer allowed)"
                              % (domain_id, ", ".join(dropped)))
            state, pw = validate_app(raw)
            state["port"] = raw.get("port", 0)
            state.update(helper_fields(raw))
            if zd_has_slots(state):
                # Zero-downtime slots: the units and env files of both slots; the pointer only
                # while no deployment holds the deploy lock (docs/DESIGN.md section 12.8).
                ensure_converge_unit()
                lock = FileLock("deploy-%d" % state["domain_id"])
                if lock.acquire(blocking=False):
                    try:
                        state, pw = load_app_state(state["domain_id"])
                        if state["switch"]:
                            # An interrupted switch is settled from the pointer first (§12.8).
                            zd_converge_locked(state, pw)
                            state, pw = load_app_state(state["domain_id"])
                        write_units(state, pw)
                        if pointer_wanted(state):
                            write_pointer(state, pw, state["slot"])
                    finally:
                        lock.release()
                else:
                    errors.append("#%s: a deployment is running; its units were not re-rendered" % domain_id)
            else:
                write_units(state, pw)
            if state["listen"] == "unix":
                ensure_socket_dir(state["domain_id"], pw)
            count += 1
        except Exception as exc:  # noqa: BLE001
            errors.append("#%s: %s" % (domain_id, exc))
            if isinstance(domain_id, int):
                for unit in all_app_units(domain_id):
                    if _strip_privileged_exec(os.path.join(UNIT_DIR, unit)):
                        errors.append("#%s: removed root-privileged Exec lines from the old unit file%s"
                                      % (domain_id, "" if unit == UNIT_APP % domain_id else " " + unit))
    systemctl("daemon-reload")
    sync_health_units()
    return {"count": count, "errors": errors}


def cmd_install(_payload):
    if systemd_version() == 0:
        raise HelperError("systemd is required but was not found")
    ensure_layout()
    result = cmd_reapply_all(None)
    result["info"] = cmd_info(None)
    return result


def cmd_uninstall(payload):
    keep_toolchains = bool((payload or {}).get("keep_toolchains"))
    removed = []
    for state in list(iter_app_states()):
        try:
            remove_app(int(state["domain_id"]))
            removed.append(state.get("domain_id"))
        except Exception:  # noqa: BLE001 - best effort during uninstall
            pass
    systemctl("stop", UNIT_ADMIN_JOB)
    if os.path.exists(os.path.join(UNIT_DIR, UNIT_CONVERGE)):
        remove_converge_unit()
        systemctl("daemon-reload")
    # No application is left: the health watch timer goes too.
    sync_health_units()
    for name in _listdir(TMPFILES_DIR):
        if name == "runway.conf" or re.match(r"^runway-\d+\.conf$", name):
            remove_quietly(os.path.join(TMPFILES_DIR, name))
    shutil.rmtree(RUN_DIR, ignore_errors=True)
    shutil.rmtree(STATE_DIR, ignore_errors=True)
    shutil.rmtree(CONF_DIR, ignore_errors=True)
    if keep_toolchains:
        remove_quietly(HELPER_COPY)
    else:
        shutil.rmtree(BASE_DIR, ignore_errors=True)
    return {"removed_apps": removed}


def cmd_web_reconfigure(payload):
    domains = (payload or {}).get("domains") or []
    if not isinstance(domains, list) or len(domains) > 500:
        raise HelperError("Invalid domain list")
    plesk = shutil.which("plesk", path=ROOT_PATH) or "/usr/sbin/plesk"
    errors = []
    for name in domains:
        name = v_domain_name(name)
        proc = run([plesk, "sbin", "httpdmng", "--reconfigure-domain", name], timeout=300)
        if proc.returncode != 0:
            errors.append("%s: %s" % (name, (proc.stderr or proc.stdout).strip()[-500:]))
    if errors:
        raise HelperError("Web server reconfiguration failed: " + "; ".join(errors))
    return {"reconfigured": domains}


# ---------------------------------------------------------------------------
# Deploy job (runs inside runway-deploy-<id>.service as root)
# ---------------------------------------------------------------------------

def _build_preexec(pw, app_root):
    def preexec():
        drop_privileges(pw)
        os.umask(0o027)
        os.chdir(app_root)
    return preexec


class DeployTerminated(HelperError):
    """SIGTERM from systemd while a deployment runs (TimeoutStartSec reached, or the unit was stopped
    because the application was disabled or its domain suspended)."""


def _triggers_moved(domain_id):
    """True when a trigger file changed after the last snapshot (e.g. touched during a build)."""
    try:
        state, pw = load_app_state(domain_id)
    except HelperError:
        return False
    if not state["auto_deploy"]:
        return False
    now = trigger_mtimes(pw, state["app_dir"])
    seen = read_json(app_triggers_path(domain_id), {}) or {}
    return any(now.get(key) and now.get(key) != seen.get(key) for key in ("deploy", "restart"))


def _rearm_deploy(domain_id):
    """Starts the deploy unit again shortly after this run ended (a trigger file changed when no
    time was left in this run): the path unit does not report changes made while its service runs."""
    run(["systemd-run", "--on-active=60", "--unit=runway-redeploy-%d" % domain_id, "--collect", "--quiet",
         "--description=Runway: deploy again (trigger file changed during a deployment)",
         "/usr/bin/systemctl", "start", "--no-block", UNIT_DEPLOY % domain_id], timeout=60)


def internal_deploy(domain_id):
    job = "deploy-%d" % domain_id
    lock = FileLock(job)
    # The panel's app-apply and the convergence hold the lock briefly (zero-downtime slots).
    if not lock.acquire(blocking=True, timeout=120):
        _deploy_lock_busy(domain_id, job)
        return
    started = time.time()

    def on_term(_signum, _frame):
        if _TERM["critical"]:
            # A zero-downtime switch moved (or is moving) the traffic: it finishes first.
            _TERM["pending"] = True
            return
        try:
            limit = deploy_timeout(load_app_state(domain_id)[0])
        except HelperError:
            limit = 0
        if limit and time.time() - started >= limit - 10:
            raise DeployTerminated("The deployment was killed by the deploy unit timeout (%d s)." % limit)
        raise DeployTerminated("The deployment was stopped (the application was disabled, its domain was "
                               "suspended or the deploy unit was stopped).")

    signal.signal(signal.SIGTERM, on_term)
    try:
        # Up to three rounds: a panel request queued meanwhile, or a trigger file touched while the
        # previous round ran (systemd's path unit does not watch while the deploy unit runs).
        for _round in range(3):
            _deploy_once(domain_id, job)
            if _TERM["pending"]:
                break
            if os.path.exists(job_paths(job)[2]):
                continue
            if not _triggers_moved(domain_id):
                break
            try:
                state = load_app_state(domain_id)[0]
            except HelperError:
                break
            # Every round may build and switch: the same allowance deploy_timeout() adds.
            if time.time() - started + state["build_timeout"] + 300 + switch_allowance(state) > deploy_timeout(state) \
                    or _round == 2:
                _rearm_deploy(domain_id)
                break
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        lock.release()


def open_public_files(state, pw):
    """The step that makes the files in the application's document root readable for the web
    server (docs/DESIGN.md section 7, Public files), as the system user: None when the application
    has no stored document root (workers never have one) or it does not lie strictly inside the
    application root, else {changed, skipped_links, truncated, passable} (_user_open_public_files).
    Raises HelperError."""
    rel = state.get("document_root") or ""
    if not rel or state.get("listen") == "none":
        return None
    try:
        absolute = v_document_root(rel, pw.pw_dir)[1]
    except HelperError:
        return None
    try:
        web_gid = grp.getgrnam(WEB_GROUP).gr_gid
    except KeyError:
        web_gid = -1
    return call_as_user(pw, _user_open_public_files, state["app_dir"], absolute, PUBLIC_FILES_MAX,
                        PUBLIC_FILES_SECONDS, web_gid, timeout=PUBLIC_FILES_SECONDS + 30)


def public_files_summary(result, path):
    """One line about a run of open_public_files() (deploy log)."""
    notes = []
    if result.get("passable"):
        count = int(result["passable"])
        notes.append("o+x for %d folder%s on the way to it" % (count, "" if count == 1 else "s"))
    if result.get("skipped_links"):
        count = int(result["skipped_links"])
        notes.append("%d symbolic link%s skipped" % (count, "" if count == 1 else "s"))
    if result.get("truncated"):
        notes.append("stopped at the limit of %d entries, %d seconds or %d folder levels: the rest was not checked"
                     % (PUBLIC_FILES_MAX, PUBLIC_FILES_SECONDS, PUBLIC_FILES_DEPTH))
    return "Made %d files and folders in %s readable for the web server%s" % (
        int(result.get("changed") or 0), path, " (%s)" % "; ".join(notes) if notes else "")


def deploy_open_public_files(state, pw, log):
    """Deploy job, after a build or fetch: open_public_files() as one line of the deploy log. A
    failure is logged and never fails the deployment (a SIGTERM of the deploy unit still ends it)."""
    path = os.path.normpath(pw.pw_dir) + "/" + state["document_root"] if state.get("document_root") else ""
    try:
        result = open_public_files(state, pw)
    except DeployTerminated:
        raise
    except Exception as exc:  # noqa: BLE001 - the deployment goes on
        log.line("WARNING: the files in the document root %s could not be made readable for the web server: %s"
                 % (path, exc))
        return
    if result is not None:
        log.line(public_files_summary(result, path))


def _deploy_lock_busy(domain_id, job):
    """The deploy lock stayed busy: a panel request fails with the reason, and the job starts again
    a minute later so a trigger file is not lost."""
    request_path = job_paths(job)[2]
    if os.path.exists(request_path):
        remove_quietly(request_path)
        job_set_status(job, state="failed", finished_at=now_iso(), exit_code=1,
                       message="Another operation of this application held its lock for two minutes; the deployment "
                               "did not start. Try again.")
    else:
        _rearm_deploy(domain_id)


def restart_and_check(state, pw, unit, log, restarted=False):
    """Restarts `unit` (unless `restarted`) and checks that it runs and listens on the endpoint of
    `state` (a slot view for zero-downtime slots). Returns (ok, message); raises HelperError."""
    if not restarted:
        prepare_start(state, pw)
        log.line("Restarting %s" % unit)
        systemctl("reset-failed", unit)
        proc = systemctl("restart", unit, timeout=120)
        if proc.returncode != 0:
            raise HelperError("systemctl restart failed: %s" % proc.stderr.strip())
    if state["listen"] == "none":
        time.sleep(3)
        if not unit_running(unit):
            raise HelperError("The worker is not running (it keeps exiting). Check the application log.")
        log.line("Worker is running (workers have no listener to check).")
        return True, None
    deadline = time.time() + 30
    listener, detail = "none", ""
    while time.time() < deadline:
        listener, detail = listener_state(state, pw)
        if listener != "none" or not unit_is_active(unit):
            break
        time.sleep(0.5)
    endpoint = endpoint_socket(state) if state["listen"] == "unix" else "127.0.0.1:%d" % int(state["port"])
    hint = "RUNWAY_SOCKET" if state["listen"] == "unix" else "PORT"
    if listener == "tampered":
        contain_tampering(state, detail)
        raise HelperError("The socket path was tampered with (%s); the application was stopped." % detail)
    if listener == "foreign":
        raise HelperError("Another user's process holds the application endpoint (%s). "
                          "The application cannot serve the domain until it is released." % detail)
    if listener == "ok":
        log.line("Application is listening on %s" % endpoint)
        return True, None
    if not unit_running(unit):
        raise HelperError("The service is not running (it keeps exiting). Check the application log.")
    if unit_is_active(unit):
        log.line("WARNING: the service is running but nothing listens on %s yet. "
                 "Make sure the application listens on the %s environment variable." % (endpoint, hint))
        return True, "Service running, but nothing listens on %s yet" % endpoint
    raise HelperError("The service stopped right after starting. Check the application log.")


def _deploy_once(domain_id, job):
    _status_path, _log_path, request_path = job_paths(job)
    request = read_json(request_path)
    remove_quietly(request_path)
    state, pw = load_app_state(domain_id)
    triggers_now = trigger_mtimes(pw, state["app_dir"])
    fetch = None
    if isinstance(request, dict):
        mode = request.get("mode") if request.get("mode") in DEPLOY_TITLES else "restart"
        fetch = request.get("fetch") if mode == "fetch" else None
        source = "panel"
    else:
        seen = read_json(app_triggers_path(domain_id), {}) or {}
        if triggers_now.get("deploy") and triggers_now.get("deploy") != seen.get("deploy"):
            mode = "build"
        elif triggers_now.get("restart") and triggers_now.get("restart") != seen.get("restart"):
            mode = "restart"
        else:
            return
        source = "trigger file"
    write_json(app_triggers_path(domain_id), triggers_now)
    if not state["enabled"] or state["suspended"]:
        if source == "panel":
            job_set_status(job, state="failed", finished_at=now_iso(),
                           message="The domain is suspended" if state["suspended"] else "The application is disabled")
        return
    queued = {} if source == "panel" else {"queued_at": now_iso(), "queued_epoch": time.time()}
    # A stopped application is built (or fetched) but not started: the title says so.
    title, title_key = deploy_title(mode, state["stopped"])
    job_set_status(job, state="running", title=title, title_key=title_key, title_params={},
                   started_at=now_iso(), finished_at=None, source=source, message=None, **queued)
    log = JobLog(job)
    ok = False
    message = None
    try:
        log.line("Deployment started (%s, triggered from %s)" % (mode, source))
        log.line("Application root: %s" % state["app_dir"])
        if not call_as_user(pw, os.path.isdir, state["app_dir"]):
            raise HelperError("Application root %s does not exist or is not accessible" % state["app_dir"])
        build = mode == "build"
        if mode == "fetch":
            spec = v_fetch(fetch)
            build = spec["build"]
            fetch_into_app(state, pw, spec, log)
        if build and state["build_cmd"]:
            env = merged_env(state, pw)
            env.update({"HOME": pw.pw_dir, "USER": pw.pw_name, "LOGNAME": pw.pw_name,
                        "LANG": "C.UTF-8", "SHELL": "/bin/bash", "TMPDIR": "/tmp"})
            if state["toolchain"] and not toolchain_installed(state["runtime"], state["toolchain"]):
                raise HelperError("Toolchain %s %s is not installed" % (state["runtime"], state["toolchain"]))
            log.line("Runtime: %s %s" % (state["runtime"], state["toolchain"] or "(no toolchain)"))
            log.line("$ " + state["build_cmd"].replace("\n", "\n$ "))
            started = time.time()
            code = stream_process(["/bin/bash", "-e", "-c", state["build_cmd"]], log, state["build_timeout"],
                                  env, preexec=_build_preexec(pw, state["app_dir"]))
            log.line("Build finished in %.1fs with exit code %d" % (time.time() - started, code))
            if code != 0:
                raise HelperError("Build failed with exit code %d; the running application was left untouched." % code)
        elif build:
            log.line("No build command configured; skipping build.")
        # The build may have taken long: never start an app that was disabled or whose
        # domain was suspended in the meantime.
        fresh, fresh_pw = load_app_state(domain_id)
        if mode in ("build", "fetch"):
            # Files the build or fetch wrote into a document root inside the application root
            # become readable for the web server, before the new version starts (also for a
            # stopped application: the web server serves the document root without it).
            deploy_open_public_files(fresh, fresh_pw, log)
        if not fresh["enabled"] or fresh["suspended"]:
            raise HelperError("The application was disabled or the domain suspended during the build; "
                              "it was not restarted.")
        unit = UNIT_APP % domain_id
        if fresh["stopped"]:
            # Stop persists: only Start, Restart, Build & restart in the panel or saving starts it again.
            log.line("The application is stopped; it was not started. Start it to run this version.")
            ok = True
            message = "The application is stopped; it was not started"
            return
        if zd_has_slots(fresh):
            # Zero-downtime slots (docs/DESIGN.md section 12.4): a switch, or a plain restart (also
            # of an application that became a worker while a slot runs: the 1.0 unit does not exist
            # then, zd_restart() retires the slots first).
            ok, message = zd_restart(fresh, pw, job, log)
            return
        ok, message = restart_and_check(fresh, pw, unit, log)
    except Exception as exc:  # noqa: BLE001
        message = str(exc)
        log.line("ERROR: %s" % exc)
    finally:
        log.line("Deployment %s." % ("succeeded" if ok else "failed"))
        log.close()
        job_set_status(job, state="succeeded" if ok else "failed", finished_at=now_iso(),
                       exit_code=0 if ok else 1, message=message)


# ---------------------------------------------------------------------------
# Zero-downtime deployments (docs/DESIGN.md section 12)
#
# An application with the setting on runs in one of two slot units (runway-app-<id>-a/-b); a
# switch starts the other slot, waits until it is ready, moves the web server's pointer to it
# (unix: the root link /run/runway/<id>.sock; tcp: the include files in /etc/runway/web and a
# graceful reload), drains and stops the old one. The pointer is the truth about which instance
# carries the traffic: everything that finds an interrupted switch decides from it.
# ---------------------------------------------------------------------------

_O_PATH = getattr(os, "O_PATH", 0o10000000)
# SIGTERM of the deploy job inside a critical section (from the traffic move on) only sets
# "pending"; the job then finishes the switch instead of leaving it half done.
_TERM = {"critical": 0, "pending": False}


class SwitchFailed(HelperError):
    """A switch that failed while the running version keeps serving."""


def zd_has_slots(state):
    """True when the application uses (or still uses) zero-downtime slots: the setting is on, a
    slot is still the live instance after it was turned off, or the intent record of an
    interrupted switch exists (also of a switch back to the 1.0 unit that already committed: the
    old slot may still run, and the convergence, Stop, suspension and the socket check must cover
    it until the slots are retired)."""
    return bool(state.get("zero_downtime")) or state.get("slot") in SLOTS or isinstance(state.get("switch"), dict)


def slot_files_left(domain_id):
    """True when a unit or environment file of a zero-downtime slot exists (e.g. after the
    setting was turned off before the first switch, or after the boot repair of an interrupted
    switch back to the 1.0 unit): the convergence and app-apply retire them."""
    return any(os.path.exists(os.path.join(UNIT_DIR, app_unit(domain_id, slot))) or os.path.exists(env_file_path(domain_id, slot))
               for slot in SLOTS)


def zd_switchable(state):
    """The web server snippet of the application must use the pointer (PHP stores this)."""
    return state.get("listen") in ("tcp", "unix") and zd_has_slots(state)


def zd_target(state):
    """The instance a switch starts: the other slot while the setting is on, the 1.0 unit ("")
    when it was turned off and a slot is still live; None when there is nothing to switch."""
    if state.get("zero_downtime") and state.get("listen") in ("tcp", "unix"):
        return "a" if state.get("slot") == "b" else "b"
    if state.get("slot") in SLOTS:
        return ""
    return None


def slot_label(slot):
    """Name of an instance in messages: "slot a", or the classic (single-instance) unit."""
    return "slot %s" % slot if slot else "the classic unit"


def slot_port(state, slot):
    if slot == "a":
        return state.get("port_a") or state.get("port")
    if slot == "b":
        return state.get("port_b")
    return state.get("port")


def slot_view(state, slot):
    """The state as one instance sees it: a slot's port, socket and RUNWAY_SLOT (render_app_unit,
    render_env_file, listen_env, listener_info, health_check and prepare_start use it)."""
    view = dict(state)
    if slot:
        view["_slot"] = slot
        view["port"] = slot_port(state, slot) or 0
    view["_socket"] = slot_socket_path(state["domain_id"], slot)
    return view


def live_view(state):
    return slot_view(state, state.get("slot") or "")


def existing_app_units(domain_id):
    """App units of the application that have a unit file (systemctl refuses unknown names)."""
    units = [unit for unit in all_app_units(domain_id) if os.path.exists(os.path.join(UNIT_DIR, unit))]
    return units or [UNIT_APP % domain_id]


def unit_enabled(unit):
    return run(["systemctl", "is-enabled", unit], timeout=30).stdout.strip() in ("enabled", "enabled-runtime")


def zd_journal(state, message, priority=5):
    journal_note(state["domain_id"], message, priority)


# --- pointer: root link (unix) and include files (tcp) ------------------------------------------

def set_link(domain_id, slot):
    """Root: points /run/runway/<id>.sock at the slot's socket: a new symlink under a random name,
    renamed over the old one through the directory descriptor of /run/runway (atomic, never
    follows anything). Returns True when it changed."""
    ensure_run_dir()
    target = link_target(domain_id, slot)
    name = "%d.sock" % domain_id
    fd = os.open(RUN_DIR, _DIR_FLAGS)
    try:
        try:
            if os.readlink(name, dir_fd=fd) == target:
                return False
        except OSError:
            pass
        tmp = ".%d.%s.tmp" % (domain_id, base64.b16encode(os.urandom(6)).decode("ascii").lower())
        os.symlink(target, tmp, dir_fd=fd)
        try:
            os.rename(tmp, name, src_dir_fd=fd, dst_dir_fd=fd)
        except OSError:
            try:
                os.unlink(tmp, dir_fd=fd)
            except OSError:
                pass
            raise
        return True
    finally:
        os.close(fd)


def read_link_slot(domain_id):
    """The slot the root link points at ("" = app.sock), or None (missing or not Runway's)."""
    path = link_path(domain_id)
    try:
        st = os.lstat(path)
        if not stat.S_ISLNK(st.st_mode) or st.st_uid != 0:
            return None
        return _slot_of_target(domain_id, os.readlink(path))
    except OSError:
        return None


def remove_link(domain_id):
    try:
        fd = os.open(RUN_DIR, _DIR_FLAGS)
    except OSError:
        return
    try:
        name = "%d.sock" % domain_id
        st = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if not stat.S_ISDIR(st.st_mode):
            os.unlink(name, dir_fd=fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def _read_exact(path, limit=4096):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read(limit)
    except OSError:
        return None


def write_include(domain_id, port):
    """Root-owned include files of a switchable tcp application naming the live port (nginx:
    $runway_upstream; Apache: RUNWAY_UPSTREAM_<id> and RUNWAY_PORT_<id>). Returns True when a
    file changed."""
    ensure_dir(WEB_DIR, 0o755)
    nginx, apache = include_paths(domain_id)
    header = "# Managed by the Plesk Runway extension. Do not edit.\n"
    changed = False
    for path, text in ((nginx, header + "set $runway_upstream 127.0.0.1:%d;\n" % int(port)),
                       (apache, header + "Define RUNWAY_UPSTREAM_%d http://127.0.0.1:%d\nDefine RUNWAY_PORT_%d %d\n"
                        % (domain_id, int(port), domain_id, int(port)))):
        if _read_exact(path) != text:
            write_file_atomic(path, text, 0o644)
            changed = True
    return changed


def read_include_port(domain_id):
    match = re.search(r"^set \$runway_upstream 127\.0\.0\.1:(\d{1,5});$", _read_exact(include_paths(domain_id)[0]) or "", re.M)
    return int(match.group(1)) if match else None


def include_mtime(domain_id):
    mtimes = []
    for path in include_paths(domain_id):
        try:
            mtimes.append(os.stat(path).st_mtime)
        except OSError:
            pass
    return max(mtimes) if mtimes else 0.0


def remove_include(domain_id):
    for path in include_paths(domain_id):
        remove_quietly(path)
    try:
        os.rmdir(WEB_DIR)  # only when no other application uses it
    except OSError:
        pass


def read_pointer_slot(state):
    """The instance the pointer names: the root link's slot (unix) or the slot whose port the
    include names (tcp; the intent's target, the live slot and the intent's source first, because
    the 1.0 port and slot a's port may be the same number while only one of them runs)."""
    domain_id = state["domain_id"]
    if state.get("listen") == "unix":
        return read_link_slot(domain_id)
    if state.get("listen") != "tcp":
        return None
    port = read_include_port(domain_id)
    if port is None:
        return None
    intent = state.get("switch") or {}
    order = [intent.get("to"), state.get("slot") or "", intent.get("from"), "a", "b", ""]
    for slot in order:
        if slot is not None and slot_port(state, slot) == port:
            return slot
    return None


def pointer_wanted(state):
    """The pointer files must name the live instance: the application is switchable, or its web
    server snippet may still use them (until Plesk regenerated the 1.0 snippet)."""
    domain_id = state["domain_id"]
    return state.get("listen") in ("tcp", "unix") and (zd_switchable(state) or os.path.lexists(link_path(domain_id))
                                                      or os.path.exists(include_paths(domain_id)[0]))


def write_pointer(state, pw, slot):
    """Points the web server at `slot` (the caller holds the application's deploy lock). tcp:
    returns True when the include files changed (a reload makes it effective)."""
    domain_id = state["domain_id"]
    if state.get("listen") == "unix":
        ensure_socket_dir(domain_id, pw)
        set_link(domain_id, slot)
        write_tmpfiles(state, pw, link_slot=slot)
        return False
    if state.get("listen") == "tcp":
        port = slot_port(state, slot)
        return bool(port) and write_include(domain_id, port)
    return False


def tmpfiles_drop_link(state, pw):
    """The tmpfiles entry without its L line (the root link is no longer used)."""
    if state.get("listen") == "unix" and tmpfiles_link_slot(state["domain_id"]) is not None:
        write_tmpfiles(state, pw)


# --- web server: which one carries the traffic, its worker generations, reloads ------------------

_PROC_TIME = []


def _proc_clock():
    """(boot time as epoch seconds, clock ticks per second). The boot time comes from
    /proc/uptime (10 ms resolution; btime of /proc/stat is whole seconds, too coarse to compare
    process start times with file modification times)."""
    if not _PROC_TIME:
        try:
            uptime = float((_read_text("/proc/uptime", 256) or "0").split()[0])
        except ValueError:
            uptime = 0.0
        _PROC_TIME.append((time.time() - uptime, float(os.sysconf("SC_CLK_TCK") or 100)))
    return _PROC_TIME[0]


def proc_stat(pid):
    """(ppid, start time as epoch seconds) of a process, or None."""
    data = _read_text("/proc/%d/stat" % pid, 4096)
    if not data or ")" not in data:
        return None
    fields = data.rsplit(")", 1)[1].split()
    try:
        btime, ticks = _proc_clock()
        return int(fields[1]), btime + int(fields[19]) / ticks
    except (IndexError, ValueError):
        return None


def proc_title(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            return fh.read(512).replace(b"\0", b" ").decode("utf-8", "replace").strip()
    except OSError:
        return ""


def web_traffic_server():
    """(unit, kind) of the web server that carries the domains' traffic: nginx when it runs,
    else Apache; (None, None) when neither runs."""
    for unit, kind in (("nginx.service", "nginx"), ("apache2.service", "apache"), ("httpd.service", "apache")):
        if run(["systemctl", "is-active", unit], timeout=30).stdout.strip() == "active":
            return unit, kind
    return None, None


def web_main_pid(unit):
    main = unit_show([unit], ["MainPID"]).get(unit, {}).get("MainPID", "0")
    try:
        return int(main)
    except ValueError:
        return 0


def web_workers(unit, kind):
    """Worker processes of the web server: [{pid, start, old}], old = an nginx worker that is
    shutting down (Apache children cannot be told apart: old is False)."""
    main = web_main_pid(unit)
    if main <= 1:
        return []
    workers = []
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        info = proc_stat(pid)
        if not info or info[0] != main:
            continue
        title = proc_title(pid)
        if kind == "nginx":
            if "worker process" not in title:
                continue
            old = "shutting down" in title
        else:
            old = False
        workers.append({"pid": pid, "start": info[1], "old": old})
    return workers


def web_confirmed_at(unit):
    """Time (epoch) before which every configuration file was read by a reload of `unit` that
    web_reload_confirm() confirmed, or 0.0."""
    data = read_json(WEB_RELOADS, {})
    value = data.get(unit) if isinstance(data, dict) else None
    return float(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else 0.0


def web_reload_stamp():
    """Touches the stamp file and returns its modification time (0.0 on failure): a file written
    before has an older or equal time, one written afterwards a newer or equal one, on the clock
    of file modification times (which lags time.time() by up to a clock tick)."""
    try:
        with open(WEB_RELOAD_STAMP, "a"):
            pass
        os.utime(WEB_RELOAD_STAMP, None)
        return os.stat(WEB_RELOAD_STAMP).st_mtime
    except OSError:
        return 0.0


def web_record_confirmed(unit, issued):
    """Remembers a confirmed reload of `unit` issued at `issued` (web_reload_stamp(); the caller
    holds the web-reload lock). Only an optimisation: a failure means one more reload later."""
    if not issued:
        return
    try:
        data = read_json(WEB_RELOADS, {})
        data = data if isinstance(data, dict) else {}
        data[unit] = issued
        write_json(WEB_RELOADS, data)
    except OSError:
        pass


def web_effective(unit, kind, since):
    """True when the configuration files changed before `since` (epoch) are active in the web
    server: a reload confirmed by web_reload_confirm() was issued after `since`, the server (its
    main process) started after it, or (nginx) every worker that is not shutting down started
    after it. Apache children of an old generation that still finish long requests (downloads,
    WebSockets) after a graceful restart look like the new ones, and children forked later for
    more load run the configuration of their generation: only the first two count for Apache.
    No web server: True."""
    if not unit:
        return True
    if web_confirmed_at(unit) > since:
        return True
    main = web_main_pid(unit)
    info = proc_stat(main) if main > 1 else None
    if info and info[1] > since:
        return True
    if kind != "nginx":
        return False
    current = [w for w in web_workers(unit, kind) if not w["old"]]
    return bool(current) and all(w["start"] > since for w in current)


def web_config_test(kind):
    """Output of the configuration test of the web server (for failure messages)."""
    if kind == "nginx":
        cmd = ["nginx", "-t"]
    elif shutil.which("apachectl", path=ROOT_PATH):
        cmd = ["apachectl", "-t"]
    else:
        cmd = ["httpd", "-t"]
    try:
        proc = run(cmd, timeout=60)
    except HelperError as exc:
        return str(exc)
    lines = [line for line in (proc.stderr + proc.stdout).splitlines() if line.strip()]
    return " ".join(lines)[-1500:]


def web_reload_confirm(unit, kind, wait=ZD_RELOAD_WAIT):
    """Reloads the web server and waits until its new worker generation is in place: a worker
    that did not exist before, no worker of before that is not shutting down (nginx), and the set
    of current workers unchanged for one second (a later generation, e.g. of Plesk's own reload,
    is adopted). Returns (ok, reason, detail, workers before the reload): reason "reload" when
    the reload was refused (detail: the configuration test; the running configuration stays),
    "unknown" when the systemctl client was killed by a signal (systemd may still carry the
    reload out), "timeout" otherwise. A confirmed reload is remembered (web_effective()).
    Raises HelperError when a systemctl call times out (the outcome is unknown then, too)."""
    before = set(w["pid"] for w in web_workers(unit, kind))
    issued = web_reload_stamp()
    proc = run(["systemctl", "reload", unit], timeout=120)
    if proc.returncode < 0:
        return False, "unknown", "systemctl reload %s ended by signal %d" % (unit, -proc.returncode), before
    if proc.returncode != 0:
        return False, "reload", web_config_test(kind) or (proc.stderr or proc.stdout).strip(), before
    deadline = time.time() + wait
    last = None
    since = 0.0
    while time.time() < deadline:
        workers = web_workers(unit, kind)
        current = frozenset(w["pid"] for w in workers if not w["old"])
        new = current - before
        stale = (current & before) if kind == "nginx" else set()
        if new and not stale:
            if current != last:
                last, since = current, time.time()
            elif time.time() - since >= 1.0:
                web_record_confirmed(unit, issued)
                return True, "", "", before
        else:
            last = None
        time.sleep(0.1)
    return False, "timeout", "no new worker generation of %s within %d s" % (unit, wait), before


def web_reload_nowait(unit):
    if unit:
        run(["systemctl", "reload", unit], timeout=120)


def vhosts_dir():
    for line in (_read_text("/etc/psa/psa.conf", 65536) or "").splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == "HTTPD_VHOSTS_D" and RE_SAFE_PATH.match(parts[1]):
            return parts[1].rstrip("/")
    return "/var/www/vhosts"


def generated_config(state, kind):
    """(text, mtime) of the domain's configuration that Plesk generated for nginx or Apache, or
    (None, 0) when it does not exist."""
    domain = state["domain"]
    try:
        domain = domain.encode("idna").decode("ascii")
    except (UnicodeError, ValueError):
        pass
    name = "nginx.conf" if kind == "nginx" else "httpd.conf"
    path = os.path.join(vhosts_dir(), "system", domain, "conf", name)
    try:
        st = os.stat(path)
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read(4 * 1024 * 1024), st.st_mtime
    except OSError:
        return None, 0.0


def pointer_reference(state, kind):
    """The string the switchable snippet of the application's listen mode contains."""
    if state.get("listen") == "unix":
        return link_path(state["domain_id"])
    return "%s/%d.%s[.]conf" % (WEB_DIR, state["domain_id"], "nginx" if kind == "nginx" else "apache")


def config_references(state, needle):
    """True when the domain's generated nginx or Apache configuration contains `needle`."""
    for kind in ("nginx", "apache"):
        text = generated_config(state, kind)[0]
        if text and needle in text:
            return True
    return False


# --- connections, listeners -------------------------------------------------------------------

def unix_connections(path):
    """Connections of the listener bound to `path`: accepted (state 03) or still in its accept
    queue (state 02), from /proc/net/unix."""
    count = 0
    try:
        with open("/proc/net/unix", "r", errors="replace") as fh:
            next(fh, None)
            for row in fh:
                parts = row.split()
                if len(parts) >= 8 and parts[7] == path and parts[5] in ("02", "03"):
                    count += 1
    except OSError:
        pass
    return count


def unix_listener_inodes(path):
    """Socket inodes of the listeners bound to `path` (state 01 with the listening flag)."""
    inodes = set()
    try:
        with open("/proc/net/unix", "r", errors="replace") as fh:
            next(fh, None)
            for row in fh:
                parts = row.split()
                if len(parts) >= 8 and parts[7] == path and parts[3] == "00010000":
                    inodes.add(parts[6])
    except OSError:
        pass
    return inodes


def tcp_connections(port):
    """Connections (accepted or queued, state 01) whose local port is `port`."""
    count = 0
    for name in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(name, "r") as fh:
                rows = fh.read().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            parts = row.split()
            try:
                if len(parts) > 3 and parts[3] == "01" and int(parts[1].rsplit(":", 1)[1], 16) == port:
                    count += 1
            except (IndexError, ValueError):
                pass
    return count


def unit_pids(unit):
    """Processes in the cgroup of a unit (cgroup v2, else v1's systemd hierarchy)."""
    group = unit_show([unit], ["ControlGroup"]).get(unit, {}).get("ControlGroup", "")
    if not group or not group.startswith("/"):
        return []
    for base in ("/sys/fs/cgroup", "/sys/fs/cgroup/systemd", "/sys/fs/cgroup/unified"):
        text = _read_text(base + group + "/cgroup.procs", 65536)
        if text:
            return [int(pid) for pid in text.split() if pid.isdigit()]
    return []


def pids_hold_sockets(pids, inodes):
    """True when one of the processes has one of the socket inodes open."""
    wanted = set("socket:[%s]" % inode for inode in inodes)
    for pid in pids:
        try:
            for fd in os.listdir("/proc/%d/fd" % pid):
                try:
                    if os.readlink("/proc/%d/fd/%s" % (pid, fd)) in wanted:
                        return True
                except OSError:
                    continue
        except OSError:
            continue
    return False


# --- state helpers ------------------------------------------------------------------------------

def zd_update_state(domain_id, **fields):
    """Changes helper-owned fields of the stored state under the state lock; returns the stored
    state (raw)."""
    return update_state_flags(domain_id, **fields)


def zd_flags_block(domain_id):
    """The reason a switch must not move the traffic or start an instance now, or None."""
    stored = read_json(app_state_path(domain_id))
    if not isinstance(stored, dict):
        return "removed"
    if not stored.get("enabled"):
        return "disabled"
    if stored.get("suspended"):
        return "suspended"
    if stored.get("stopped") or stored.get("tampered"):
        return "stopped"
    return None


def switch_fault(point):
    """Test-only: the root-owned flag SWITCH_FAULT_FLAG ("<kill|term>:<point>", younger than one
    hour) makes the switch job signal itself at that point (docs/DESIGN.md section 12.11)."""
    try:
        st = os.lstat(SWITCH_FAULT_FLAG)
    except OSError:
        return
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or time.time() - st.st_mtime > RECONCILE_PAUSE_MAX:
        return
    kind, _sep, where = (_read_text(SWITCH_FAULT_FLAG, 200) or "").partition(":")
    if where.strip() != point:
        return
    os.kill(os.getpid(), signal.SIGKILL if kind.strip() == "kill" else signal.SIGTERM)
    time.sleep(1)


def ensure_converge_unit():
    """Installs and enables runway-converge.service (boot repair of interrupted switches) once
    an application uses zero-downtime slots."""
    path = os.path.join(UNIT_DIR, UNIT_CONVERGE)
    text = "\n".join([
        "# Managed by the Plesk Runway extension. Manual changes will be overwritten.",
        "[Unit]",
        "Description=Runway: settle interrupted zero-downtime switches before the web server starts",
        "After=local-fs.target systemd-tmpfiles-setup.service",
        "Before=nginx.service apache2.service httpd.service",
        "",
        "[Service]",
        "Type=oneshot",
        "ExecStart=%s _converge" % HELPER_COPY,
        "TimeoutStartSec=180",
        "",
        "[Install]",
        "WantedBy=multi-user.target",
        "",
    ])
    if _read_exact(path, 8192) != text:
        write_file_atomic(path, text, 0o644)
        systemctl("daemon-reload")
    if not unit_enabled(UNIT_CONVERGE):
        systemctl("enable", UNIT_CONVERGE)


def remove_converge_unit():
    systemctl("disable", UNIT_CONVERGE)
    remove_quietly(os.path.join(UNIT_DIR, UNIT_CONVERGE))


def write_unit_file(path, text, mode=0o644):
    """Writes a unit or environment file when its content changed; True when it did."""
    if _read_exact(path, 1024 * 1024) == text:
        return False
    write_file_atomic(path, text, mode)
    return True


def write_slot_units(state, pw, slot):
    """Renders the unit and environment file of one instance ("" = the 1.0 unit); True when a
    file changed."""
    domain_id = state["domain_id"]
    view = slot_view(state, slot) if slot else state
    changed = write_unit_file(env_file_path(domain_id, slot), render_env_file(view, pw), 0o600)
    changed = write_unit_file(os.path.join(UNIT_DIR, app_unit(domain_id, slot)), render_app_unit(view, pw)) or changed
    return changed


def retire_legacy(state):
    """After the first switch: the 1.0 unit is no longer used (disabled, files removed)."""
    domain_id = state["domain_id"]
    unit = UNIT_APP % domain_id
    if os.path.exists(os.path.join(UNIT_DIR, unit)):
        systemctl("disable", "--now", unit, timeout=120)
        remove_quietly(os.path.join(UNIT_DIR, unit))
        remove_quietly(env_file_path(domain_id))
        systemctl("daemon-reload")
        systemctl("reset-failed", unit)


def retire_slots(state, pw):
    """The setting is off and the 1.0 unit is live (or nothing runs): removes the slot units and
    environment files, frees the slot ports and their sockets, and sets slot "". The pointer keeps
    naming the 1.0 instance until the snippet no longer uses it (convergence). Returns the
    updated state."""
    domain_id = state["domain_id"]
    units = [app_unit(domain_id, slot) for slot in SLOTS if os.path.exists(os.path.join(UNIT_DIR, app_unit(domain_id, slot)))]
    if units:
        systemctl("disable", "--now", *units, timeout=120)
    for slot in SLOTS:
        remove_quietly(os.path.join(UNIT_DIR, app_unit(domain_id, slot)))
        remove_quietly(env_file_path(domain_id, slot))
        unlink_socket_entry(domain_id, socket_name(slot))
    zd_update_state(domain_id, slot="", port_a=0, port_b=0, switch=None)
    state.update({"slot": "", "port_a": 0, "port_b": 0, "switch": None})
    if units:
        systemctl("daemon-reload")
        systemctl("reset-failed", *units)
    return state


# --- convergence ----------------------------------------------------------------------------

def zd_converge_locked(state, pw, log=None, boot=False):
    """Repairs the slot units and the pointer of one application (the caller holds its deploy
    lock; docs/DESIGN.md section 12.8). Settles an interrupted switch from where the pointer
    points, stops leftover instances only when the pointer is confirmed elsewhere, enables the
    live unit, and removes pointer files the generated configuration no longer uses. Never
    starts an application. Returns the (updated) state."""
    domain_id = state["domain_id"]

    def note(text):
        if log:
            log.line(text)
        zd_journal(state, text)

    listen = state.get("listen")
    if listen in ("tcp", "unix") and (zd_has_slots(state) or (slot_files_left(domain_id) and pointer_wanted(state))):
        pointer = read_pointer_slot(state)
        intent = state.get("switch")
        live = state["slot"]
        if boot:
            enabled = [slot for slot in ("",) + SLOTS
                       if os.path.exists(os.path.join(UNIT_DIR, app_unit(domain_id, slot))) and unit_enabled(app_unit(domain_id, slot))]
            if len(enabled) == 1:
                live = enabled[0]
            elif enabled:
                live = pointer if pointer in enabled else (live if live in enabled else enabled[0])
        elif intent:
            target = intent["to"]
            live = target if pointer == target and unit_is_active(app_unit(domain_id, target)) else intent["from"]
        if intent or live != state["slot"]:
            fields = {"slot": live, "switch": None}
            if live != state["slot"]:
                fields["switched_at"] = now_iso()
            zd_update_state(domain_id, **fields)
            state.update(fields)
            if intent:
                note("settled an interrupted switch (%s to %s): %s serves." % (slot_label(intent["from"]), slot_label(intent["to"]),
                                                                              slot_label(live)))
        web_unit, web_kind = (None, None) if boot else web_traffic_server()
        changed = False
        if pointer != live:
            changed = write_pointer(state, pw, live)
            pointer = live
        elif listen == "unix" and tmpfiles_link_slot(domain_id) != live:
            write_tmpfiles(state, pw, link_slot=live)
        leftover = [slot for slot in ("",) + SLOTS if slot != live and os.path.exists(os.path.join(UNIT_DIR, app_unit(domain_id, slot)))
                    and unit_is_active(app_unit(domain_id, slot))]
        confirmed = True
        if listen == "tcp" and web_unit:
            if leftover and (changed or not web_effective(web_unit, web_kind, include_mtime(domain_id))):
                # Another instance still runs: it stops only once the running configuration of
                # the web server names the live port (a confirmed reload).
                with FileLock("web-reload"):
                    try:
                        confirmed = web_reload_confirm(web_unit, web_kind)[0]
                    except HelperError:
                        confirmed = False
            elif changed:
                # Nothing to stop: the reload only has to happen.
                with FileLock("web-reload"):
                    web_reload_nowait(web_unit)
        for slot in ("",) + SLOTS:
            unit = app_unit(domain_id, slot)
            if slot == live or not os.path.exists(os.path.join(UNIT_DIR, unit)):
                continue
            active = slot in leftover
            if active and not confirmed:
                continue
            if active or unit_enabled(unit):
                if boot:
                    systemctl("disable", unit)
                    systemctl("stop", "--no-block", unit)
                else:
                    systemctl("disable", "--now", unit, timeout=120)
                    systemctl("reset-failed", unit)
                if active:
                    note("stopped %s, left over from an interrupted switch." % unit)
            if listen == "unix" and slot in SLOTS and not active:
                unlink_socket_entry(domain_id, socket_name(slot))
        live_unit = app_unit(domain_id, live)
        if state.get("enabled") and not state.get("suspended") and not state.get("stopped") \
                and os.path.exists(os.path.join(UNIT_DIR, live_unit)) and not unit_enabled(live_unit):
            systemctl("enable", live_unit)
        if live and os.path.exists(os.path.join(UNIT_DIR, UNIT_APP % domain_id)) and not unit_is_active(UNIT_APP % domain_id):
            retire_legacy(state)
    if not boot and not zd_has_slots(state) and slot_files_left(domain_id):
        # The setting is off and the 1.0 unit is the live instance: after an interrupted switch
        # back to it (settled above), or when it was turned off before the first switch. The slots
        # go; a slot that still runs while the pointer is in use stops only after the pointer was
        # confirmed on the 1.0 unit (above, then at the next run).
        running = [slot for slot in SLOTS if os.path.exists(os.path.join(UNIT_DIR, app_unit(domain_id, slot)))
                   and unit_is_active(app_unit(domain_id, slot))]
        if not running or not pointer_wanted(state):
            state = retire_slots(state, pw)
            if log:
                log.line("Removed the units of the zero-downtime slots (the setting is off).")
    # Pointer files that the domain's generated configuration no longer uses.
    if not (listen == "unix" and zd_has_slots(state)) and os.path.lexists(link_path(domain_id)) \
            and not config_references(state, link_path(domain_id)):
        remove_link(domain_id)
        tmpfiles_drop_link(state, pw)
    if not (listen == "tcp" and zd_has_slots(state)) and os.path.exists(include_paths(domain_id)[0]) \
            and not config_references(state, "%s/%d." % (WEB_DIR, domain_id)):
        remove_include(domain_id)
    return state


def zd_converge(state, boot=False):
    """Convergence of one application when its deploy lock is free (skipped while busy)."""
    lock = FileLock("deploy-%d" % state["domain_id"])
    if not lock.acquire(blocking=False):
        return False
    try:
        fresh, pw = load_app_state(state["domain_id"])
        zd_converge_locked(fresh, pw, boot=boot)
        return True
    finally:
        lock.release()


def zd_needs_converge(raw):
    """Applications the convergence looks at: with slots (or the intent record of an interrupted
    switch), or with slot units or pointer files left over."""
    if not isinstance(raw.get("domain_id"), int):
        return False
    return zd_has_slots(raw) or slot_files_left(raw["domain_id"]) or os.path.lexists(link_path(raw["domain_id"])) \
        or os.path.exists(include_paths(raw["domain_id"])[0])


def internal_converge():
    """runway-converge.service (boot) or a manual run: converges every application. Before the
    web server runs nothing is reloaded and the enabled unit decides (boot mode)."""
    boot = web_traffic_server()[0] is None
    for raw in list(iter_app_states()):
        if not zd_needs_converge(raw):
            continue
        try:
            zd_converge(raw, boot=boot)
        except Exception as exc:  # noqa: BLE001 - one application must not stop the others
            sys.stderr.write("runway: convergence of #%s failed: %s\n" % (raw.get("domain_id"), exc))


# --- plain restart ----------------------------------------------------------------------------

def zd_plain_restart(state, pw, block=False):
    """Restarts the live instance in place (short interruption; the caller holds the deploy
    lock): stops every other app unit, makes the 1.0 unit live when the setting is off, points
    the web server at the live instance and restarts it. Returns (state, unit)."""
    domain_id = state["domain_id"]
    if not state.get("zero_downtime") and (state.get("slot") or slot_files_left(domain_id)):
        # Turned off (or a worker now): the 1.0 unit becomes the live instance, the slots go.
        state = retire_slots(state, pw)
        write_slot_units(state, pw, "")
        systemctl("daemon-reload")
    live = state.get("slot") or ""
    others = [app_unit(domain_id, slot) for slot in ("",) + SLOTS
              if slot != live and os.path.exists(os.path.join(UNIT_DIR, app_unit(domain_id, slot)))]
    if others:
        systemctl("disable", "--now", *others, timeout=120)
    unit = app_unit(domain_id, live)
    if pointer_wanted(state):
        changed = write_pointer(state, pw, live)
        if changed:
            web_unit = web_traffic_server()[0]
            if web_unit:
                with FileLock("web-reload"):
                    web_reload_nowait(web_unit)
    if state.get("switch") or state.get("restart_plain"):
        zd_update_state(domain_id, switch=None, restart_plain=False)
        state.update({"switch": None, "restart_plain": False})
    prepare_start(live_view(state), pw)
    systemctl("enable", unit, check=True)
    systemctl("reset-failed", unit)
    if block:
        proc = systemctl("restart", unit, timeout=120)
        if proc.returncode != 0:
            raise HelperError("systemctl restart failed: %s" % proc.stderr.strip())
    else:
        systemctl("restart", "--no-block", unit, check=True)
    return state, unit


# --- the switch -------------------------------------------------------------------------------

class SwitchJob(object):
    """Phase bookkeeping of a switch in the deploy job status (docs/DESIGN.md section 12.4)."""

    def __init__(self, job, log, source, target):
        self.job = job
        self.log = log
        self.source = source
        self.target = target

    def phase(self, name, limit=0):
        job_set_status(self.job, phase=name, phase_started_epoch=time.time() if name else None,
                       phase_limit=int(limit), slot_from=self.source, slot_to=self.target)
        if name:
            switch_fault(name)


def zd_restart(state, pw, job, log):
    """Deploy job of an application with zero-downtime slots: a switch, or a plain restart when
    the next restart must be plain or nothing runs that could keep serving. Returns
    (ok, message); raises HelperError on failure."""
    domain_id = state["domain_id"]
    live = state.get("slot") or ""
    target = zd_target(state)
    reason = None
    if state.get("restart_plain"):
        reason = "the listen mode or the system user changed"
    elif state.get("listen") not in ("tcp", "unix"):
        reason = "workers have no traffic to switch"
    elif target is None:
        reason = "zero-downtime deployments are off"
    elif not unit_is_active(app_unit(domain_id, live)):
        reason = "nothing is running"
    if reason:
        log.line("Restarting in place (%s)." % reason)
        state, unit = zd_plain_restart(state, pw, block=True)
        return restart_and_check(live_view(state), pw, unit, log, restarted=True)
    return zd_switch(state, pw, job, log, live, target)


def zd_stop_new(unit):
    systemctl("stop", unit, timeout=120)
    systemctl("reset-failed", unit)


def zd_wait_marker(state, web_unit, web_kind, log):
    """Step 1: the generated configuration of the web server that carries the traffic uses the
    switchable snippet of the listen mode, and it is active (reload when it is not yet)."""
    if not web_unit:
        return
    marker = ZD_MARKER % state["domain_id"]
    reference = pointer_reference(state, web_kind)
    deadline = time.time() + ZD_MARKER_WAIT
    httpdmng = None
    waited = False
    while True:
        text, mtime = generated_config(state, web_kind)
        if text and marker in text and reference in text:
            if web_effective(web_unit, web_kind, mtime):
                return
            with FileLock("web-reload"):
                if web_effective(web_unit, web_kind, mtime):
                    return
                ok, _reason, detail, _before = web_reload_confirm(web_unit, web_kind)
            if ok:
                return
            raise SwitchFailed("The web server could not be reloaded: %s" % detail)
        if not waited:
            log.line("Waiting for the web server configuration of %s with the zero-downtime snippet." % state["domain"])
            waited = True
        if time.time() >= deadline:
            if httpdmng is not None:
                raise SwitchFailed("The web server configuration of %s does not use Runway's zero-downtime snippet: %s"
                                   % (state["domain"], httpdmng or "httpdmng reported no error"))
            plesk = shutil.which("plesk", path=ROOT_PATH) or "/usr/sbin/plesk"
            log.line("Regenerating the configuration of %s (httpdmng)." % state["domain"])
            try:
                proc = run([plesk, "sbin", "httpdmng", "--reconfigure-domain", state["domain"]], timeout=ZD_HTTPDMNG_TIMEOUT)
                httpdmng = (proc.stderr or proc.stdout).strip()[-1000:]
            except HelperError as exc:
                httpdmng = str(exc)
            deadline = time.time() + 10
        time.sleep(1)


def zd_ensure_include(state, live, web_unit, web_kind):
    """tcp, before a switch: the include files name the live port and are active."""
    domain_id = state["domain_id"]
    with FileLock("web-reload"):
        changed = write_include(domain_id, slot_port(state, live))
        if web_unit and (changed or not web_effective(web_unit, web_kind, include_mtime(domain_id))):
            ok, _reason, detail, _before = web_reload_confirm(web_unit, web_kind)
            if not ok:
                raise SwitchFailed("The web server could not be reloaded: %s" % detail)


def zd_prepare_port(state, live, target, log):
    """tcp: the port of the new instance must be free and differ from the live one; otherwise it
    gets a newly allocated port (stored in the state). Returns the port."""
    domain_id = state["domain_id"]
    port_live = slot_port(state, live)
    port_new = slot_port(state, target)
    reason = None
    if not port_new or port_new == port_live:
        reason = "it is the port of the running version"
    else:
        uids = tcp_listener_uids(port_new)
        if uids:
            reason = "port %d is held by uid %s" % (port_new, ", ".join(str(uid) for uid in sorted(uids)))
    if reason:
        key = "port_" + target if target else "port"
        with FileLock("ports"):
            stored = read_json(app_state_path(domain_id))
            if not isinstance(stored, dict):
                raise HelperError("Application #%d is not configured" % domain_id)
            avoid = set(p for p in (state.get("port"), state.get("port_a"), state.get("port_b"), port_live) if p)
            new = allocate_extra_port(domain_id, state["port_range"], avoid)
            stored[key] = new
            write_json(app_state_path(domain_id), stored)
        if port_new:
            log.line("The new version gets port %d (%s)." % (new, reason))
        state[key] = new
        port_new = new
    return port_new


def zd_wait_ready(state, pw, view, live, live_inodes, log, limit):
    """Step 3: waits until the new instance listens on its own endpoint (and its health path
    answers). Returns ("ready", ""), ("stopped", reason) or ("failed", message)."""
    domain_id = state["domain_id"]
    unit = app_unit(domain_id, view.get("_slot") or "")
    unix = state["listen"] == "unix"
    endpoint = view["_socket"] if unix else "127.0.0.1:%d" % int(view["port"])
    expect = ("$RUNWAY_SOCKET (%s)" % endpoint) if unix else ("127.0.0.1:$PORT (%d)" % int(view["port"]))
    live_path = slot_socket_path(domain_id, live)
    deadline = time.time() + limit
    seen = False
    last = "nothing listens on %s" % endpoint
    while True:
        block = zd_flags_block(domain_id)
        if block:
            return "stopped", block
        info = unit_show([unit], ["ActiveState", "SubState", "NRestarts", "Result", "ExecMainStatus"]).get(unit, {})
        active = info.get("ActiveState")
        restarts = int(info.get("NRestarts") or 0) if (info.get("NRestarts") or "").isdigit() else 0
        if active in ("active", "activating", "reloading"):
            seen = True
        if active == "failed" or (seen and active == "inactive") or restarts > 0:
            return "failed", ("The new version exited during startup (status=%s/%s); it must listen on %s"
                              % (info.get("ExecMainStatus") or "?", info.get("Result") or "?", expect))
        if unix:
            # A second listener on the live instance's path while that instance still holds its
            # own listener: the path was taken over (e.g. a hardcoded app.sock). Without that
            # evidence (the live instance restarted), only a listener held by one of the new
            # version's processes counts (reading /proc/<pid>/fd needs CAP_SYS_PTRACE).
            current = unix_listener_inodes(live_path)
            stray = current - live_inodes
            if stray and ((live_inodes and live_inodes <= current) or pids_hold_sockets(unit_pids(unit), stray)):
                return "failed", ("The new version listens on %s instead of $RUNWAY_SOCKET (%s)" % (live_path, endpoint))
        listener, detail, code, _params = listener_info(view, pw)
        if listener == "tampered":
            contain_tampering(state, detail)
            raise HelperError("The socket path was tampered with (%s); the application was stopped." % detail)
        if listener == "foreign":
            return "failed", "Another user's process holds the endpoint of the new version (%s)" % detail
        if listener == "ok":
            if not state.get("health_path"):
                return "ready", ""
            health, hdetail, _code, _params = health_check(view, "ok", pw)
            if health == "healthy":
                return "ready", ""
            last = hdetail
        else:
            last = detail
        if time.time() >= deadline:
            return "failed", "The new version was not ready within %d s (%s)" % (limit, last)
        time.sleep(0.5)


def zd_drain(state, live, limit, old_workers, web_unit):
    """Step 5: waits (at most `limit` s) until the old instance has no connection left; tcp also
    until no web server worker of before the reload is alive. Ends early after a SIGTERM."""
    if limit <= 0:
        return
    unix = state["listen"] == "unix"
    path = slot_socket_path(state["domain_id"], live)
    port = slot_port(state, live)
    deadline = time.time() + limit
    while time.time() < deadline and not _TERM["pending"]:
        if unix:
            busy = unix_connections(path)
        else:
            busy = tcp_connections(port) or any(os.path.exists("/proc/%d" % pid) for pid in old_workers or ())
        if not busy:
            return
        time.sleep(0.5)


def zd_switch(state, pw, job, log, live, target):
    """The switch of docs/DESIGN.md section 12.4 (the deploy lock is held). Returns
    (ok, message); raises SwitchFailed/HelperError when the new version was not activated."""
    domain_id = state["domain_id"]
    sj = SwitchJob(job, log, live, target)
    unit_live, unit_new = app_unit(domain_id, live), app_unit(domain_id, target)
    started = False
    stop_new_on_error = True
    critical = False
    live_file = None
    keep_hint = " The running version keeps serving; Restart in place runs the new version with an interruption."
    try:
        sj.phase("prepare")
        log.line("Zero-downtime switch from %s to %s." % (slot_label(live), slot_label(target)))
        zd_converge_locked(state, pw, log)
        state, pw = load_app_state(domain_id)
        if (state.get("slot") or "") != live or zd_target(state) != target:
            live, target = state.get("slot") or "", zd_target(state)
            if target is None or not zd_switchable(state):
                # The convergence settled an interrupted switch back to the 1.0 unit (the setting
                # is off): the restart of the setting off, in place.
                return zd_restart(state, pw, job, log)
            sj = SwitchJob(job, log, live, target)
            unit_live, unit_new = app_unit(domain_id, live), app_unit(domain_id, target)
        if unit_is_active(unit_new):
            stop_new_on_error = False
            raise SwitchFailed("A previous switch is still being cleaned up (%s is running); try again in a minute." % unit_new)
        unix = state["listen"] == "unix"
        web_unit, web_kind = web_traffic_server()
        live_inodes = set()
        if unix:
            ensure_socket_dir(domain_id, pw)
            found = socket_check(state, pw)
            if found:
                contain_tampering(state, found[0])
                raise HelperError("The socket path was tampered with (%s); the application was stopped." % found[0])
            unlink_socket_entry(domain_id, socket_name(target))
            live_inodes = unix_listener_inodes(slot_socket_path(domain_id, live))
            # The live instance's socket file: a failed new version that took its path is detected
            # by a different (or missing) file afterwards (zd_rescue_live()).
            live_file = socket_file_id(slot_socket_path(domain_id, live))
        else:
            zd_prepare_port(state, live, target, log)
        zd_wait_marker(state, web_unit, web_kind, log)
        if not unix:
            zd_ensure_include(state, live, web_unit, web_kind)
        view = slot_view(state, target)
        if write_slot_units(state, pw, target):
            systemctl("daemon-reload")

        sj.phase("starting")
        with FileLock("ports"):
            block = zd_flags_block(domain_id)
        if block:
            return True, "The application was stopped during the switch; the new version was not started."
        zd_update_state(domain_id, switch={"from": live, "to": target, "phase": "starting", "started_epoch": time.time()})
        prepare_start(view, pw)
        systemctl("reset-failed", unit_new)
        started = True
        proc = systemctl("start", "--no-block", unit_new)
        if proc.returncode != 0:
            raise SwitchFailed("The new version could not be started: %s" % proc.stderr.strip())
        log.line("Started %s; waiting until it is ready (at most %d s)." % (unit_new, state["ready_timeout"]))

        sj.phase("waiting", state["ready_timeout"])
        result, detail = zd_wait_ready(state, pw, view, live, live_inodes, log, state["ready_timeout"])
        if result == "stopped":
            return zd_stopped_during(state, unit_new, target)
        if result != "ready":
            raise SwitchFailed(detail + "." + keep_hint)
        log.line("The new version is ready.")

        sj.phase("switching")
        _TERM["critical"] += 1
        critical = True
        old_workers = None
        with FileLock("ports"):
            block = zd_flags_block(domain_id)
            if not block:
                stored = read_json(app_state_path(domain_id))
                intent = dict(stored.get("switch") or {}, phase="switching")
                stored["switch"] = intent
                write_json(app_state_path(domain_id), stored)
        if block:
            return zd_stopped_during(state, unit_new, target)
        if unix:
            # The socket the link will name: a socket of the application's user (O_PATH check).
            try:
                unix_connect(view["_socket"], pw.pw_uid, 2.0).close()
            except OSError as exc:
                raise SwitchFailed("The new version's socket cannot be used (%s)." % exc + keep_hint)
            set_link(domain_id, target)
            stop_new_on_error = False
            # At once, not after the commit: a reboot recreates the link from this entry, and the
            # boot repair decides from the link and the enabled units (docs/DESIGN.md section 12.8).
            write_tmpfiles(state, pw, link_slot=target)
        else:
            with FileLock("web-reload"):
                try:
                    write_include(domain_id, slot_port(state, target))
                    if web_unit:
                        ok, reason, detail, old_workers = web_reload_confirm(web_unit, web_kind)
                    else:
                        ok, reason, detail = True, "", ""
                except (HelperError, OSError) as exc:
                    # e.g. a systemctl call that timed out: whether the web server already runs with
                    # the new port is unknown, so the old one is restored and confirmed first.
                    ok, reason, detail = False, "unknown", str(exc)
                if not ok:
                    # The new version is stopped only once the running configuration names the old
                    # port again: a refused reload (configuration test) left it in place, otherwise
                    # a confirmed reload of the restored include files.
                    restored, rdetail = False, ""
                    try:
                        write_include(domain_id, slot_port(state, live))
                        if reason == "reload" or not web_unit:
                            restored = True
                        else:
                            restored, _r, rdetail, _b = web_reload_confirm(web_unit, web_kind)
                    except (HelperError, OSError) as exc:
                        rdetail = str(exc)
                    if not restored:
                        stop_new_on_error = False
                        raise SwitchFailed("The web server did not confirm its configuration (%s; %s); both versions keep "
                                           "running until the next check." % (detail, rdetail))
                    if reason == "reload":
                        raise SwitchFailed("The web server could not be reloaded: %s." % detail + keep_hint)
                    raise SwitchFailed("The web server did not confirm the new configuration (%s)." % detail + keep_hint)
            stop_new_on_error = False
        log.line("The web server now sends the traffic to %s." % slot_label(target))
        switch_fault("moved")
        with FileLock("ports"):
            stored = read_json(app_state_path(domain_id))
            stored.update({"slot": target, "switched_at": now_iso(),
                           "switch": dict(stored.get("switch") or {"from": live, "to": target}, phase="draining")})
            write_json(app_state_path(domain_id), stored)
        state.update({"slot": target})
        switch_fault("committed")
        systemctl("enable", unit_new)
        if os.path.exists(os.path.join(UNIT_DIR, unit_live)):
            systemctl("disable", unit_live)
        if zd_flags_block(domain_id):
            systemctl("disable", "--now", *existing_app_units(domain_id), timeout=120)
            zd_update_state(domain_id, switch=None)
            return True, "The application was stopped during the switch."

        sj.phase("draining", state["drain_seconds"])
        zd_drain(state, live, state["drain_seconds"], old_workers, web_unit)
        sj.phase("stopping")
        message = "Switched from %s to %s" % (slot_label(live), slot_label(target))
        try:
            zd_stop_new(unit_live)
            if unix:
                unlink_socket_entry(domain_id, socket_name(live))
            if not live:
                retire_legacy(state)
            if not target:
                # Clears the intent record with the slots (a switch back to the 1.0 unit).
                retire_slots(state, pw)
            zd_update_state(domain_id, switch=None)
        except (HelperError, OSError) as exc:
            # The new version serves: the switch succeeded. The intent record stays, so the
            # convergence (scheduled reconcile, within 10 minutes) stops the old version.
            log.line(message + ".")
            log.line("WARNING: stopping %s failed (%s); the next check retries it." % (slot_label(live), exc))
            zd_journal(state, "%s; stopping %s failed (%s), the next check retries it." % (message, slot_label(live), exc), 4)
            return True, "%s; stopping %s failed, the next check retries it" % (message, slot_label(live))
        log.line(message + ".")
        zd_journal(state, message.lower()[:1] + message[1:] + " (zero-downtime deployment).")
        return True, None
    except DeployTerminated:
        if started and stop_new_on_error:
            zd_stop_new(unit_new)
            if state["listen"] == "unix":
                unlink_socket_entry(domain_id, socket_name(target))
                zd_rescue_live(state, pw, live, live_file, log)
            zd_update_state(domain_id, switch=None)
        raise
    except HelperError as exc:
        if started and stop_new_on_error:
            zd_stop_new(unit_new)
            if state["listen"] == "unix":
                unlink_socket_entry(domain_id, socket_name(target))
                zd_rescue_live(state, pw, live, live_file, log)
            zd_update_state(domain_id, switch=None)
        elif not started:
            zd_update_state(domain_id, switch=None)
        if isinstance(exc, SwitchFailed):
            zd_journal(state, "the zero-downtime deployment failed: %s" % exc)
        raise
    finally:
        if critical:
            _TERM["critical"] -= 1
        try:
            sj.phase("")
        except Exception:  # noqa: BLE001 - never hide the real result
            pass


def zd_stopped_during(state, unit_new, target):
    """Stop or disable during the switch, before the traffic moved: the new version goes."""
    zd_stop_new(unit_new)
    if state["listen"] == "unix":
        unlink_socket_entry(state["domain_id"], socket_name(target))
    zd_update_state(state["domain_id"], switch=None)
    return True, "The application was stopped during the switch; the new version was not started."


def socket_file_id(path):
    """(device, inode) of the socket file at `path` (lstat, never followed), or None."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    return (st.st_dev, st.st_ino) if stat.S_ISSOCK(st.st_mode) else None


def zd_rescue_live(state, pw, live, live_file, log):
    """Unix, after a failed switch: a new version that bound the live instance's path (e.g. a
    hardcoded app.sock; gunicorn and asyncio remove an existing socket before they bind, Go,
    gunicorn and uvicorn unlink their path when they stop) replaced or removed the live socket
    file (`live_file`, recorded before the new version started). The live instance is then
    unreachable: restart it in place. A live socket file that is still the same file is left
    alone: a connection that fails because the instance is busy is no reason to interrupt it."""
    if live_file is None:
        return
    path = slot_socket_path(state["domain_id"], live)
    if socket_file_id(path) == live_file:
        return
    unit = app_unit(state["domain_id"], live)
    if not unit_is_active(unit):
        return
    log.line("The running version lost its socket %s (the new version replaced or removed it); restarting it in place." % path)
    prepare_start(slot_view(state, live), pw)
    systemctl("restart", "--no-block", unit)


