# Editor defaults for this repository (https://editorconfig.org). The extension is deployed to
# Linux, so every text file uses LF line endings (see also .gitattributes).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[src/sbin/runway-helper]
# The root helper is a python3 script without extension.
indent_size = 4

[*.{go,mod}]
indent_style = tab

[Makefile]
indent_style = tab
