{
  "name": "runway",
  "version": "1.3.0",
  "private": true,
  "description": "Runway Plesk extension frontend (React + Plesk UI Library via @plesk/plesk-ext-sdk)",
  "license": "MIT",
  "scripts": {
    "build": "bun ./node_modules/@plesk/plesk-ext-sdk/bin/cli.js build",
    "package": "python build.py --strict",
    "build:helper": "python scripts/build_helper.py",
    "check:helper": "python scripts/build_helper.py --check",
    "dev": "bun ./node_modules/@plesk/plesk-ext-sdk/bin/cli.js dev",
    "test:frontend": "bun test ./tests/frontend",
    "assets": "bun scripts/render-assets.ts",
    "screenshots": "bun scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@plesk/plesk-ext-sdk": "^0.9.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jsdom": "31.0.1",
    "puppeteer-core": "^25.18.1"
  }
}
